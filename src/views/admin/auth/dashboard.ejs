<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Admin Dashboard | ElectroHub</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
</head>

<body class="bg-gray-100">

  <!-- TOP NAVBAR -->
  <header class="bg-white shadow-sm">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <!-- <img src="/images/auth/auth-img.jpeg" alt="ElectroHub" class="h-8 w-8 rounded"> -->
        <span class="text-xl font-bold">ElectroHub</span>
        <span class="text-xs text-gray-500 ml-2">Next-Gen Electronics</span>
      </div>
      <nav class="flex items-center gap-6 text-sm font-medium">
        <a href="#" class="hover:text-black text-gray-600">Home</a>
        <a href="#" class="hover:text-black text-gray-600">Contact</a>
        <a href="#" class="hover:text-black text-gray-600">About</a>
        <a href="/admin/logout" class="text-red-600 hover:underline">Logout</a>
      </nav>
    </div>
  </header>

  <div class="flex">

    <!-- SIDEBAR -->
    <aside class="w-64 min-h-[calc(100vh-64px)] bg-white border-r">
      <div class="p-6 font-semibold">ElectroHub Admin</div>
      <nav class="px-4 space-y-1 text-sm">
        <a href="/admin/dashboard" class="flex items-center gap-2 px-3 py-2 rounded bg-gray-100">
          <i class="bi bi-house"></i> Dashboard
        </a>
        <a href="/admin/orders" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-gray-100">
          <i class="bi bi-bag"></i> Orders
        </a>
        <a href="/admin/products" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-gray-100">
          <i class="bi bi-box"></i> Products
        </a>
        <a href="/admin/category" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-gray-100">
          <i class="bi bi-tags"></i> Category
        </a>
        <a href="/admin/offers" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-gray-100">
          <i class="bi bi-percent"></i> Offers
        </a>
        <a href="/admin/coupons" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-gray-100">
          <i class="bi bi-ticket"></i> Coupons
        </a>
        <a href="/admin/banners" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-gray-100">
          <i class="bi bi-image"></i> Banners
        </a>
        <a href="/admin/customers" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-gray-100">
          <i class="bi bi-people"></i> Customers
        </a>
        <a href="/admin/sales-report" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-gray-100">
          <i class="bi bi-graph-up"></i> Sales Report
        </a>
      </nav>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="flex-1 p-8">

      <!-- Page Title + Export -->
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-semibold">Total Revenue</h1>
        <button class="bg-gray-200 hover:bg-gray-300 text-sm px-4 py-2 rounded">
          <i class="bi bi-download"></i> Export Data
        </button>
      </div>

      <!-- KPI Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white p-5 rounded shadow">
          <p class="text-sm text-gray-500">Total Revenue</p>
          <h2 class="text-2xl font-bold mt-1">₹120,500</h2>
        </div>
        <div class="bg-white p-5 rounded shadow">
          <p class="text-sm text-gray-500">Total Orders</p>
          <h2 class="text-2xl font-bold mt-1">350</h2>
        </div>
        <div class="bg-white p-5 rounded shadow">
          <p class="text-sm text-gray-500">Total Customers</p>
          <h2 class="text-2xl font-bold mt-1">120</h2>
        </div>
      </div>

      <!-- Filters -->
      <div class="bg-white p-5 rounded shadow mb-8">
        <div class="flex flex-wrap gap-3 mb-4">
          <button class="px-4 py-2 text-sm rounded bg-gray-200">Monthly</button>
          <button class="px-4 py-2 text-sm rounded hover:bg-gray-100">Yearly</button>
          <button class="px-4 py-2 text-sm rounded hover:bg-gray-100">Custom</button>
        </div>
        <div class="flex gap-4">
          <input type="date" class="border rounded px-3 py-2 text-sm" />
          <input type="date" class="border rounded px-3 py-2 text-sm" />
          <button class="bg-black text-white px-4 py-2 rounded text-sm">Generate Report</button>
        </div>
      </div>

      <!-- Chart Placeholder -->
      <div class="bg-white p-6 rounded shadow mb-8">
        <h3 class="font-medium mb-4">Revenue Growth</h3>
        <div class="h-56 flex items-center justify-center text-gray-400 border rounded">
          Chart will be integrated here
        </div>
      </div>

      <!-- Category Revenue -->
      <div class="bg-white p-6 rounded shadow">
        <h3 class="font-medium mb-4">Revenue by Product Category</h3>

        <div class="space-y-3 text-sm">
          <div>
            <div class="flex justify-between mb-1">
              <span>Headphones</span>
              <span>₹45,000</span>
            </div>
            <div class="h-2 bg-gray-200 rounded">
              <div class="h-2 bg-black rounded w-[70%]"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between mb-1">
              <span>Laptops</span>
              <span>₹65,000</span>
            </div>
            <div class="h-2 bg-gray-200 rounded">
              <div class="h-2 bg-black rounded w-[85%]"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between mb-1">
              <span>Accessories</span>
              <span>₹10,500</span>
            </div>
            <div class="h-2 bg-gray-200 rounded">
              <div class="h-2 bg-black rounded w-[30%]"></div>
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>

</body>
</html>
