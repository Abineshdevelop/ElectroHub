<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Admin Dashboard | ElectroHub</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="bg-gray-100 font-sans text-gray-800">

  <%- include('../layout/header') %>

  <div class="flex">

    <%- include('../layout/sidebar', { activePage: 'dashboard' }) %>

    <!-- MAIN CONTENT -->
    <main class="flex-1 p-8 overflow-x-hidden">
      <%
        const qs = new URLSearchParams(query || {}).toString();
      %>

      <!-- Page Title -->
      <div class="mb-8 flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Performance Control Panel</h1>
          <p class="text-gray-500 text-sm mt-1 italic">Comprehensive analytics of ElectroHub ecosystem.</p>
          <% if (typeof dateRange !== 'undefined' && dateRange) { %>
            <p class="text-xs text-gray-400 mt-1 font-mono">Period: <%= dateRange.label %> · <%= dateRange.from.toLocaleDateString('en-GB') %> – <%= dateRange.to.toLocaleDateString('en-GB') %></p>
          <% } %>
        </div>
        <div class="flex gap-2 no-print">
            <a href="/admin/dashboard/download/pdf?<%= qs %>" class="bg-white border hover:bg-gray-50 text-xs font-bold px-4 py-2 rounded shadow-sm flex items-center gap-2 transition">
                <i class="bi bi-file-earmark-pdf text-red-500"></i> PDF Report
            </a>
            <a href="/admin/dashboard/download/excel?<%= qs %>" class="bg-white border hover:bg-gray-50 text-xs font-bold px-4 py-2 rounded shadow-sm flex items-center gap-2 transition">
              <i class="bi bi-file-earmark-spreadsheet text-green-600"></i> Excel (.xlsx)
            </a>
        </div>
      </div>

      <!-- Filters -->
      <div class="bg-white p-6 rounded-lg shadow-sm mb-6 border no-print">
        <form id="dashboardFilterForm" action="/admin/dashboard" method="GET" novalidate class="grid grid-cols-1 md:grid-cols-6 gap-4 items-end">
          <div class="space-y-1 md:col-span-2">
            <label class="text-[10px] font-bold text-gray-400 uppercase">Period Filter</label>
            <select name="filterType" id="filterType" class="w-full bg-gray-50 border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-300 font-semibold text-gray-800">
              <option value="monthly_last30" <%= (query.filterType==='monthly_last30'||!query.filterType)?'selected':'' %>>Last 30 Days (Default)</option>
              <option value="weekly_last7" <%= query.filterType==='weekly_last7'?'selected':'' %>>Last 7 Days</option>
              <option value="daily" <%= query.filterType==='daily'?'selected':'' %>>Today / Specific Day</option>
              <option value="weekly" <%= query.filterType==='weekly'?'selected':'' %>>Specific Calendar Week</option>
              <option value="monthly" <%= query.filterType==='monthly'?'selected':'' %>>Specific Calendar Month</option>
              <option value="yearly" <%= query.filterType==='yearly'?'selected':'' %>>Specific Calendar Year</option>
              <option value="custom" <%= query.filterType==='custom'?'selected':'' %>>Custom Date Range</option>
            </select>
          </div>
          <div class="space-y-1">
            <label class="text-[10px] font-bold text-gray-400 uppercase">Status Filter</label>
            <select name="orderStatus" id="orderStatus" class="w-full bg-gray-50 border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-300 font-semibold text-gray-800">
              <option value="all" <%= (!query.orderStatus||query.orderStatus==='all')?'selected':'' %>>All Statuses</option>
              <option value="pending" <%= query.orderStatus==='pending'?'selected':'' %>>Pending</option>
              <option value="confirmed" <%= query.orderStatus==='confirmed'?'selected':'' %>>Confirmed</option>
              <option value="shipped" <%= query.orderStatus==='shipped'?'selected':'' %>>Shipped</option>
              <option value="out_for_delivery" <%= query.orderStatus==='out_for_delivery'?'selected':'' %>>Out for Delivery</option>
              <option value="delivered" <%= query.orderStatus==='delivered'?'selected':'' %>>Delivered</option>
              <option value="cancelled" <%= query.orderStatus==='cancelled'?'selected':'' %>>Cancelled</option>
              <option value="returned" <%= query.orderStatus==='returned'?'selected':'' %>>Returned</option>
              <option value="return_requested" <%= query.orderStatus==='return_requested'?'selected':'' %>>Return Requested</option>
              <option value="partially_cancelled" <%= query.orderStatus==='partially_cancelled'?'selected':'' %>>Partially Cancelled</option>
              <option value="return_rejected" <%= query.orderStatus==='return_rejected'?'selected':'' %>>Return Rejected</option>
            </select>
          </div>
          <!-- Dynamic input container -->
          <div id="dynamicInputs" class="md:col-span-2 grid grid-cols-2 gap-2">
            <!-- Filled dynamically by JavaScript -->
          </div>
          <button type="submit" class="bg-gray-800 hover:bg-black text-white px-4 py-2.5 rounded-lg font-bold text-xs transition flex items-center justify-center gap-2">
            <i class="bi bi-funnel"></i> Apply Filter
          </button>
        </form>
        <p id="dashboardFilterHint" class="text-[10px] text-amber-600 mt-3 hidden"></p>
      </div>

      <!-- Part 1: KPIs -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 mb-8">
        <!-- Total Revenue -->
        <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100 transition hover:shadow-md text-center md:text-left">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Net Revenue</p>
          <h2 class="text-xl font-bold text-green-700">₹<%= kpi.totalRevenue.toLocaleString('en-IN') %></h2>
          <div class="mt-3 text-[10px] font-bold text-gray-400 italic">Delivered items only · AOV: ₹<%= Math.round(aov).toLocaleString('en-IN') %></div>
        </div>

        <!-- Completed (Delivered) -->
        <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100 transition hover:shadow-md text-center md:text-left">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Completed</p>
          <h2 class="text-xl font-bold text-green-600"><%= groupedCounts.completed %></h2>
          <div class="mt-3 text-[10px] font-bold text-green-500 flex items-center justify-center md:justify-start gap-1"><i class="bi bi-check-circle"></i> Delivered</div>
        </div>

        <!-- Pending Orders (All active statuses minus delivered/cancelled/returned) -->
        <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100 transition hover:shadow-md text-center md:text-left">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Pending Orders</p>
          <h2 class="text-xl font-bold text-amber-500"><%= groupedCounts.pending %></h2>
          <div class="mt-3 text-[10px] font-bold text-amber-500 italic">Requires review</div>
        </div>

        <!-- Closed (Cancelled) -->
        <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100 transition hover:shadow-md text-center md:text-left">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Closed</p>
          <h2 class="text-xl font-bold text-gray-500"><%= groupedCounts.closed %></h2>
          <div class="mt-3 text-[10px] font-bold text-red-500 flex items-center justify-center md:justify-start gap-1"><i class="bi bi-x-circle"></i> Cancelled</div>
        </div>

        <!-- Reverse Flow (Returned) -->
        <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100 transition hover:shadow-md text-center md:text-left">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Reverse Flow</p>
          <h2 class="text-xl font-bold text-red-500"><%= groupedCounts.reverse %></h2>
          <div class="mt-3 text-[10px] font-bold text-red-300">Returned/Refunds</div>
        </div>

        <!-- Total Users -->
        <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100 transition hover:shadow-md text-center md:text-left">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Total Users</p>
          <h2 class="text-xl font-bold text-purple-600"><%= totalCustomers %></h2>
          <div class="mt-3 text-[10px] font-bold text-gray-400">Account Holders</div>
        </div>
      </div>

      <!-- Part 2: Charts -->
      <div class="bg-white p-7 rounded-2xl shadow-sm border border-gray-100 mb-8 overflow-hidden">
        <div class="flex items-center justify-between mb-8 flex-wrap gap-4">
          <h3 class="font-bold text-gray-900 uppercase text-xs tracking-widest flex items-center gap-2">
            <i class="bi bi-graph-up-arrow text-blue-500"></i> Revenue Trend Analysis
          </h3>
        </div>
        <div class="relative h-[300px] w-full">
          <canvas id="revenueChart"></canvas>
        </div>
      </div>

      <!-- Part 3: Top 10 Best Sellers Sections -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="px-6 py-4 bg-gray-50 border-b flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase text-gray-600 tracking-wider">Top 10 Products</h3>
            <i class="bi bi-box-seam text-gray-400"></i>
          </div>
          <div class="p-6 space-y-4">
            <% topProducts.forEach((p, idx) => { %>
            <div class="flex items-center gap-4 group">
              <span class="text-xs font-bold text-gray-300 w-4">#<%= idx + 1 %></span>
              <div class="flex-1 min-w-0">
                <p class="text-xs font-bold text-gray-800 truncate"><%= p.name %></p>
                <div class="flex items-center justify-between mt-1">
                  <span class="text-[10px] font-bold text-blue-500"><%= p.count %> units</span>
                  <div class="h-1 bg-blue-100 w-20 rounded-full overflow-hidden">
                    <div class="h-full bg-blue-500" style="width: <%= (p.count / (topProducts[0]?.count || 1)) * 100 %>%"></div>
                  </div>
                </div>
              </div>
            </div>
            <% }) %>
            <% if (topProducts.length === 0) { %><p class="text-center text-gray-400 text-xs py-10 italic">No sales data.</p><% } %>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="px-6 py-4 bg-gray-50 border-b flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase text-gray-600 tracking-wider">Top 10 Categories</h3>
            <i class="bi bi-tags text-gray-400"></i>
          </div>
          <div class="p-6 space-y-4">
            <% topCategories.forEach((cat, idx) => { %>
            <div class="flex items-center gap-4 group">
              <span class="text-xs font-bold text-gray-300 w-4">#<%= idx + 1 %></span>
              <div class="flex-1 min-w-0">
                <p class="text-xs font-bold text-gray-800 truncate italic"><%= cat.name %></p>
                <div class="flex items-center justify-between mt-1">
                  <span class="text-[10px] font-bold text-purple-500"><%= cat.count %> SOLD</span>
                  <div class="h-1 bg-purple-100 w-20 rounded-full overflow-hidden">
                    <div class="h-full bg-purple-500" style="width: <%= (cat.count / (topCategories[0]?.count || 1)) * 100 %>%"></div>
                  </div>
                </div>
              </div>
            </div>
            <% }) %>
            <% if (topCategories.length === 0) { %><p class="text-center text-gray-400 text-xs py-10 italic">No category data.</p><% } %>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="px-6 py-4 bg-gray-50 border-b flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase text-gray-600 tracking-wider">Top 10 Brands</h3>
            <i class="bi bi-award text-gray-400"></i>
          </div>
          <div class="p-6 space-y-4">
            <% topBrands.forEach((b, idx) => { %>
            <div class="flex items-center gap-4 group">
              <span class="text-xs font-bold text-gray-300 w-4">#<%= idx + 1 %></span>
              <div class="flex-1 min-w-0">
                <p class="text-xs font-bold text-gray-800 truncate"><%= b._id || 'Generic' %></p>
                <div class="flex items-center justify-between mt-1">
                  <span class="text-[10px] font-bold text-amber-500"><%= b.count %> sales</span>
                  <div class="h-1 bg-amber-100 w-20 rounded-full overflow-hidden">
                    <div class="h-full bg-amber-500" style="width: <%= (b.count / (topBrands[0]?.count || 1)) * 100 %>%"></div>
                  </div>
                </div>
              </div>
            </div>
            <% }) %>
            <% if (topBrands.length === 0) { %><p class="text-center text-gray-400 text-xs py-10 italic">No brand data.</p><% } %>
          </div>
        </div>
      </div>

      <!-- Part 4: Recent Transactions Table -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-8">
          <div class="px-6 py-4 bg-gray-50 border-b flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase text-gray-600 tracking-wider">Recent Sales Transactions</h3>
            <span class="text-[10px] font-bold text-gray-400 italic">Showing last 10 entries</span>
          </div>
          <table class="w-full text-left text-xs">
              <thead class="bg-white text-gray-400 font-bold border-b">
                  <tr>
                      <th class="px-6 py-3 uppercase">Order ID</th>
                      <th class="px-6 py-3 uppercase">Customer</th>
                      <th class="px-6 py-3 uppercase">Date</th>
                      <th class="px-6 py-3 uppercase">Status</th>
                      <th class="px-6 py-3 uppercase text-right">Net Revenue</th>
                  </tr>
              </thead>
              <tbody class="divide-y">
                  <% recentOrders.forEach(o => {
                    let gross = 0, refund = Math.round(o.refundAmount||0);
                    (o.items||[]).forEach(it => {
                      const amt = Math.round(it.finalAmount ?? it.lineTotal ?? (it.unitPrice*it.quantity) ?? 0);
                      if (it.status === 'delivered') gross += amt;
                    });
                    if (!refund) {
                      (o.items||[]).forEach(it => {
                        if (['returned','return_requested'].includes(it.status)) refund += Math.round(it.finalAmount ?? it.lineTotal ?? 0);
                      });
                    }
                    const net = Math.max(0, gross - Math.min(refund, gross));
                  %>
                  <tr class="hover:bg-gray-50 transition">
                      <td class="px-6 py-4 font-bold text-gray-900"><%= o.orderId %></td>
                      <td class="px-6 py-4 text-gray-600 italic font-medium"><%= o.userId?.firstName %> <%= o.userId?.lastName %></td>
                      <td class="px-6 py-4 text-gray-500 font-mono"><%= new Date(o.createdAt).toLocaleDateString('en-IN') %></td>
                      <% const bucketStyles = {
                        delivered: ['bg-green-100 text-green-700', 'Delivered'],
                        pending: ['bg-amber-100 text-amber-700', 'Pending'],
                        cancelled: ['bg-gray-100 text-gray-600', 'Cancelled'],
                        returned: ['bg-red-100 text-red-700', 'Returned'],
                      };
                      const [bucketCls, bucketLabel] = bucketStyles[o.dashboardBucket] || ['bg-blue-100 text-blue-700', (o.orderStatus||'').replace(/_/g,' ')];
                      %>
                      <td class="px-6 py-4"><span class="px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-tighter <%= bucketCls %>"><%= bucketLabel %></span></td>
                      <td class="px-6 py-4 text-right font-bold text-green-700">₹<%= net.toLocaleString('en-IN') %></td>
                  </tr>
                  <% }) %>
                  <% if (recentOrders.length === 0) { %><tr><td colspan="5" class="px-6 py-10 text-center text-gray-400 italic">No orders found.</td></tr><% } %>
              </tbody>
          </table>
      </div>

    </main>
  </div>

  <script>
    const ctx = document.getElementById('revenueChart').getContext('2d');
    const chartDataRaw = <%- JSON.stringify(chartData) %>;
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: chartDataRaw.map(d => d._id),
        datasets: [{
          label: 'Revenue Growth (₹)',
          data: chartDataRaw.map(d => d.revenue),
          borderColor: '#111',
          borderWidth: 2.5,
          backgroundColor: 'rgba(0, 0, 0, 0.03)',
          fill: true,
          tension: 0.4,
          pointRadius: 3,
          pointBackgroundColor: '#111'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            backgroundColor: '#000',
            padding: 12,
            callbacks: {
              label: (c) => ' ₹' + c.parsed.y.toLocaleString('en-IN')
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            grid: {
              color: '#f3f4f6'
            },
            ticks: {
              callback: v => '₹' + v.toLocaleString('en-IN'),
              font: {
                size: 9,
                weight: 'bold'
              }
            }
          },
          x: {
            grid: {
              display: false
            },
            ticks: {
              font: {
                size: 9,
                weight: 'bold'
              }
            }
          }
        }
      }
    });

    const filterForm = document.getElementById('dashboardFilterForm');
    const filterHint = document.getElementById('dashboardFilterHint');
    const filterTypeEl = document.getElementById('filterType');
    const dynamicInputsContainer = document.getElementById('dynamicInputs');

    // Pre-rendered query object from Express
    const query = <%- JSON.stringify(query || {}) %>;

    function showFilterHint(msg) {
      if (!filterHint) return;
      filterHint.textContent = msg;
      filterHint.classList.toggle('hidden', !msg);
    }

    function renderDynamicInputs() {
      const type = filterTypeEl.value;
      dynamicInputsContainer.innerHTML = '';
      showFilterHint('');

      if (type === 'daily') {
        dynamicInputsContainer.className = "md:col-span-2";
        dynamicInputsContainer.innerHTML = `
          <div class="space-y-1">
            <label class="text-[10px] font-bold text-gray-400 uppercase">Select Day</label>
            <input type="date" name="dailyDate" value="${query.dailyDate || ''}" class="w-full bg-gray-50 border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-300 font-semibold text-gray-800">
          </div>
        `;
      } else if (type === 'weekly') {
        dynamicInputsContainer.className = "md:col-span-2";
        dynamicInputsContainer.innerHTML = `
          <div class="space-y-1">
            <label class="text-[10px] font-bold text-gray-400 uppercase">Select Date in Week</label>
            <input type="date" name="weekDate" value="${query.weekDate || ''}" class="w-full bg-gray-50 border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-300 font-semibold text-gray-800">
          </div>
        `;
      } else if (type === 'monthly') {
        dynamicInputsContainer.className = "md:col-span-2 grid grid-cols-2 gap-2";
        
        const months = [
          { v: 1, n: 'January' }, { v: 2, n: 'February' }, { v: 3, n: 'March' },
          { v: 4, n: 'April' }, { v: 5, n: 'May' }, { v: 6, n: 'June' },
          { v: 7, n: 'July' }, { v: 8, n: 'August' }, { v: 9, n: 'September' },
          { v: 10, n: 'October' }, { v: 11, n: 'November' }, { v: 12, n: 'December' }
        ];
        
        const currentYear = new Date().getFullYear();
        const selectedYear = parseInt(query.year) || currentYear;
        const selectedMonth = parseInt(query.month) || (new Date().getMonth() + 1);
        
        let monthOpts = months.map(m => `<option value="${m.v}" ${m.v === selectedMonth ? 'selected' : ''}>${m.n}</option>`).join('');
        let yearOpts = '';
        for (let y = currentYear; y >= currentYear - 5; y--) {
          yearOpts += `<option value="${y}" ${y === selectedYear ? 'selected' : ''}>${y}</option>`;
        }
        
        dynamicInputsContainer.innerHTML = `
          <div class="space-y-1">
            <label class="text-[10px] font-bold text-gray-400 uppercase">Month</label>
            <select name="month" class="w-full bg-gray-50 border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-300 font-semibold text-gray-800">
              ${monthOpts}
            </select>
          </div>
          <div class="space-y-1">
            <label class="text-[10px] font-bold text-gray-400 uppercase">Year</label>
            <select name="year" class="w-full bg-gray-50 border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-300 font-semibold text-gray-800">
              ${yearOpts}
            </select>
          </div>
        `;
      } else if (type === 'yearly') {
        dynamicInputsContainer.className = "md:col-span-2";
        
        const currentYear = new Date().getFullYear();
        const selectedYear = parseInt(query.year) || currentYear;
        
        let yearOpts = '';
        for (let y = currentYear; y >= currentYear - 5; y--) {
          yearOpts += `<option value="${y}" ${y === selectedYear ? 'selected' : ''}>${y}</option>`;
        }
        
        dynamicInputsContainer.innerHTML = `
          <div class="space-y-1">
            <label class="text-[10px] font-bold text-gray-400 uppercase">Select Year</label>
            <select name="year" class="w-full bg-gray-50 border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-300 font-semibold text-gray-800">
              ${yearOpts}
            </select>
          </div>
        `;
      } else if (type === 'custom') {
        dynamicInputsContainer.className = "md:col-span-2 grid grid-cols-2 gap-2";
        dynamicInputsContainer.innerHTML = `
          <div class="space-y-1">
            <label class="text-[10px] font-bold text-gray-400 uppercase">Start Date</label>
            <input type="date" name="startDate" value="${query.startDate || ''}" class="w-full bg-gray-50 border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-300 font-semibold text-gray-800">
          </div>
          <div class="space-y-1">
            <label class="text-[10px] font-bold text-gray-400 uppercase">End Date</label>
            <input type="date" name="endDate" value="${query.endDate || ''}" class="w-full bg-gray-50 border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-300 font-semibold text-gray-800">
          </div>
        `;
      } else {
        dynamicInputsContainer.className = "hidden";
      }
    }

    filterTypeEl?.addEventListener('change', renderDynamicInputs);
    renderDynamicInputs();

    filterForm?.addEventListener('submit', function(e) {
      const type = filterTypeEl.value;

      if (type === 'custom') {
        const start = filterForm.querySelector('[name="startDate"]')?.value || '';
        const end = filterForm.querySelector('[name="endDate"]')?.value || '';

        if (!start || !end) {
          e.preventDefault();
          showFilterHint('Please select both start and end dates.');
          return;
        }
        if (start > end) {
          e.preventDefault();
          showFilterHint('Start date cannot be after end date.');
          return;
        }
      } else if (type === 'daily') {
        const dDate = filterForm.querySelector('[name="dailyDate"]')?.value || '';
        if (!dDate) {
          e.preventDefault();
          showFilterHint('Please select a day.');
          return;
        }
      } else if (type === 'weekly') {
        const wDate = filterForm.querySelector('[name="weekDate"]')?.value || '';
        if (!wDate) {
          e.preventDefault();
          showFilterHint('Please select a date in the target week.');
          return;
        }
      }
      showFilterHint('');
    });
  </script>
</body>

</html>