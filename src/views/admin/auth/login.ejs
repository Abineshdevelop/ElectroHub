<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../../user/partials/auth-header', { title: 'Admin Login' }) %>
</head>

<body class="bg-gray-100 min-h-screen flex items-center justify-center">

  <!-- Toast Container -->
  <div id="toastContainer" class="fixed top-20 right-5 z-50 space-y-2"></div>

  <div class="w-full max-w-6xl bg-white shadow-2xl rounded-xl overflow-hidden flex flex-col md:flex-row">

    <!-- LEFT IMAGE -->
    <div class="w-full md:w-1/2 h-72 md:h-auto">
      <img src="/images/auth/auth-img.jpeg" alt="ElectroHub Admin" class="w-full h-full object-cover">
    </div>

    <!-- RIGHT FORM -->
    <div class="w-full md:w-1/2 p-10 flex flex-col justify-center">

      <div class="flex items-center gap-2 mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h2 class="text-3xl font-bold text-gray-800">Admin Login</h2>
      </div>

      <p class="text-gray-500 text-sm mb-8">Enter your admin credentials to access dashboard</p>

      <form class="space-y-4" id="login-form">

        <!-- EMAIL -->
        <div class="relative pb-5">
          <div class="flex items-center gap-2 border-b border-gray-300 focus-within:border-red-500 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <input type="text" id="email" placeholder="Email Address"
              class="w-full border-none focus:outline-none py-2 text-base transition-colors" autocomplete="off">
          </div>
          <span id="emailError" class="absolute left-0 bottom-0 text-xs text-red-500 invisible h-5 leading-5"></span>
        </div>

        <!-- PASSWORD -->
        <div class="relative pb-5">
          <div class="flex items-center gap-2 border-b border-gray-300 focus-within:border-red-500 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <input type="password" id="password" placeholder="Password"
              class="w-full border-none focus:outline-none py-2 text-base transition-colors">
            <!-- Toggle Password Visibility -->
            <button type="button" id="togglePassword" class="flex-shrink-0 text-gray-400 hover:text-gray-600 focus:outline-none transition-colors" aria-label="Toggle password visibility">
              <!-- Eye icon (shown when password is hidden) -->
              <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <!-- Eye-off icon (shown when password is visible) -->
              <svg id="eyeOffIcon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
              </svg>
            </button>
          </div>
          <span id="passwordError" class="absolute left-0 bottom-0 text-xs text-red-500 invisible h-5 leading-5"></span>
        </div>

        <button type="submit"
          class="w-full bg-red-500 hover:bg-red-600 text-white font-medium py-3 mt-4 text-sm rounded-md transition shadow-md active:scale-[0.98] flex items-center justify-center gap-2">
          Login to Dashboard
        </button>

        <div class="bg-blue-50 border border-blue-200 rounded-md p-3 mt-4">
          <p class="text-xs text-blue-700 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            This area is restricted to authorized administrators only.
          </p>
        </div>

      </form>
    </div>
  </div>

  <%- include('../../user/partials/auth-footer') %>

  <script>
    document.addEventListener("DOMContentLoaded", () => {

      const loginForm = document.getElementById("login-form");
      const email = document.getElementById("email");
      const password = document.getElementById("password");

      const emailError = document.getElementById("emailError");
      const passwordError = document.getElementById("passwordError");

      const togglePassword = document.getElementById("togglePassword");
      const eyeIcon = document.getElementById("eyeIcon");
      const eyeOffIcon = document.getElementById("eyeOffIcon");

      const regex = { email: /^[^\s@]+@[^\s@]+\.[^\s@]+$/ };

      let toastTimeout;

      // Toggle password visibility
      togglePassword.addEventListener("click", () => {
        const isHidden = password.type === "password";
        password.type = isHidden ? "text" : "password";
        eyeIcon.classList.toggle("hidden", isHidden);
        eyeOffIcon.classList.toggle("hidden", !isHidden);
      });

      function showToast(message, type = "error") {
        const container = document.getElementById("toastContainer");
        container.innerHTML = "";

        const toast = document.createElement("div");
        toast.className =
          "px-5 py-3 rounded-lg shadow-lg text-sm font-medium " +
          (type === "success" ? "bg-green-500 text-white" : "bg-red-500 text-white");

        toast.textContent = message;
        container.appendChild(toast);

        clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => toast.remove(), 3000);
      }

      email.addEventListener("input", () => {
        emailError.textContent = "";
        emailError.classList.add("invisible");
      });

      password.addEventListener("input", () => {
        passwordError.textContent = "";
        passwordError.classList.add("invisible");
      });

      loginForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const emailValue = email.value.trim();
        const passValue = password.value.trim();

        let isValid = true;

        if (!regex.email.test(emailValue)) {
          emailError.textContent = "Enter a valid email address";
          emailError.classList.remove("invisible");
          showToast("Invalid email format");
          isValid = false;
        }

        if (!passValue) {
          passwordError.textContent = "Password is required";
          passwordError.classList.remove("invisible");
          showToast("Password is required");
          isValid = false;
        }

        if (!isValid) return;

        try {
          const res = await fetch("/admin/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email: emailValue, password: passValue }),
            credentials: "include"
          });

          const data = await res.json();

          if (data.success) {
            showToast("Admin login successful", "success");
            setTimeout(() => (window.location.href = "/admin/dashboard"), 800);
          } else {
            passwordError.textContent = data.message || "Login failed";
            passwordError.classList.remove("invisible");
            showToast(data.message || "Login failed");
          }
        } catch (err) {
          showToast("Server error. Try again later.");
        }
      });

    });
  </script>
</body>
</html>