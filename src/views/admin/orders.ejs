    <script>
      let currentStatus = '<%= _status %>';
      let debounceTimer = null;
      let _deleteId = null;
      let _openOrderId = null;
      let _activeOrderId = null;
      let _activeItemId = null;

      const searchInput = document.getElementById('searchInput');
      const sortSelect = document.getElementById('sortSelect');
      const paginationWrap = document.getElementById('paginationWrap');
      const showingInfo = document.getElementById('showingInfo');
      const totalBadge = document.getElementById('totalBadge');
      const clearBtn = document.getElementById('clearBtn');
      const searchSpinner = document.getElementById('searchSpinner');
      const searchSuggestions = document.getElementById('searchSuggestions');

      const STATUS_CONFIG = {
        pending: { label: 'Pending', bg: 'bg-gray-100', text: 'text-gray-700', dot: 'bg-gray-500' },
        confirmed: { label: 'Confirmed', bg: 'bg-blue-100', text: 'text-blue-700', dot: 'bg-blue-500' },
        processing: { label: 'Processing', bg: 'bg-yellow-100', text: 'text-yellow-700', dot: 'bg-yellow-500' },
        shipped: { label: 'Shipped', bg: 'bg-cyan-100', text: 'bg-cyan-700', dot: 'bg-cyan-500' },
        out_for_delivery: { label: 'Out for Delivery', bg: 'bg-indigo-100', text: 'text-indigo-700', dot: 'bg-indigo-500' },
        delivered: { label: 'Delivered', bg: 'bg-green-100', text: 'text-green-700', dot: 'bg-green-500' },
        cancelled: { label: 'Cancelled', bg: 'bg-red-100', text: 'text-red-700', dot: 'bg-red-500' },
        partially_cancelled: { label: 'Partially Cancelled', bg: 'bg-orange-100', text: 'text-orange-700', dot: 'bg-orange-500' },
        return_requested: { label: 'Return Requested', bg: 'bg-indigo-100', text: 'text-indigo-700', dot: 'bg-indigo-500' },
        returned: { label: 'Returned', bg: 'bg-purple-100', text: 'text-purple-700', dot: 'bg-purple-500' },
        return_rejected: { label: 'Return Rejected', bg: 'bg-red-100', text: 'text-red-700', dot: 'bg-red-500' }
      };

      const PILL_CONFIG = {
        pending: 'bg-gray-50 text-gray-600',
        confirmed: 'bg-blue-50 text-blue-600',
        processing: 'bg-yellow-50 text-yellow-700',
        shipped: 'bg-cyan-50 text-cyan-700',
        out_for_delivery: 'bg-indigo-50 text-indigo-700',
        delivered: 'bg-green-50 text-green-700',
        cancelled: 'bg-red-50 text-red-600',
        return_requested: 'bg-indigo-50 text-indigo-700',
        returned: 'bg-purple-50 text-purple-700',
        return_rejected: 'bg-red-50 text-red-700'
      };

      function statusBadgeHtml(status) {
        const sc = STATUS_CONFIG[status] || { label: status, bg: 'bg-gray-100', text: 'text-gray-700', dot: 'bg-gray-400' };
        return `<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium w-32 ${sc.bg} ${sc.text}">
      <span class="w-1.5 h-1.5 rounded-full shrink-0 ${sc.dot} mr-1.5"></span><span class="truncate">${sc.label}</span></span>`;
      }

      function pillHtml(status) {
        const cls = PILL_CONFIG[status] || 'bg-gray-50 text-gray-600';
        const lbl = status.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        return `<span class="text-[10px] px-1.5 py-0.5 rounded-full font-medium ${cls}">${lbl}</span>`;
      }

      function escHtml(s) {
        return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      // changeOrderStatus and ADMIN_FORWARD removed.

      // ── Export CSV ──────────────────────────────────────────────────────────
      function exportCSV() {
        const q = searchInput.value.trim();
        const sort = sortSelect.value;
        window.location.href = `/admin/orders/export?q=${encodeURIComponent(q)}&sort=${sort}&status=${currentStatus}`;
      }

      // ── Fetch ──────────────────────────────────────────────────────────────
      function fetchOrders(page = 1) {
        const q = searchInput.value.trim();
        const sort = sortSelect.value;
        searchSpinner.classList.remove('hidden');
        fetch(`/admin/orders?q=${encodeURIComponent(q)}&sort=${sort}&status=${currentStatus}&page=${page}&ajax=1`, { credentials: 'include' })
          .then(r => r.json())
          .then(data => {
            renderTable(data.orders);
            renderPagination(data.currentPage, data.totalPages);
            showingInfo.innerHTML = `Showing <span class="font-semibold">${data.showingFrom}–${data.showingTo}</span> of <span class="font-semibold">${data.total}</span> orders`;
            totalBadge.textContent = `Total: ${data.total}`;
            clearBtn.classList.toggle('hidden', !q);
            history.pushState({}, '', `/admin/orders?q=${encodeURIComponent(q)}&sort=${sort}&status=${currentStatus}&page=${page}`);
          })
          .catch(() => showToast('Failed to load orders.', 'error'))
          .finally(() => {
            searchSpinner.classList.add('hidden');
          });
      }

      //Debounced Suggestions 
      function fetchSuggestions() {
        const q = searchInput.value.trim();
        if (!q) {
          searchSuggestions.classList.add('hidden');
          fetchOrders(1); // regular clear fetch
          return;
        }

        searchSpinner.classList.remove('hidden');
        searchSuggestions.classList.remove('hidden');

        // Using the same endpoint but primarily we care about `data.orders` for suggestions
        fetch(`/admin/orders?q=${encodeURIComponent(q)}&sort=${sortSelect.value}&status=${currentStatus}&page=1&ajax=1`, { credentials: 'include' })
          .then(r => r.json())
          .then(data => {
            // Also update the table in the background for real-time filtering
            renderTable(data.orders);
            renderPagination(data.currentPage, data.totalPages);
            showingInfo.innerHTML = `Showing <span class="font-semibold">${data.showingFrom}–${data.showingTo}</span> of <span class="font-semibold">${data.total}</span> orders`;
            totalBadge.textContent = `Total: ${data.total}`;
            clearBtn.classList.remove('hidden');

            // Populate suggestion dropdown
            if (!data.orders || data.orders.length === 0) {
              searchSuggestions.innerHTML = `<div class="p-3 text-sm text-gray-500 text-center"><i class="bi bi-emoji-frown mr-1"></i> Not found</div>`;
            } else {
              searchSuggestions.innerHTML = data.orders.map(o => {
                const firstName = o.shippingAddress?.firstName || '?';
                const lastName = o.shippingAddress?.lastName || '';
                return `<div class="px-3 py-2 border-b border-gray-100 last:border-0 hover:bg-gray-50 cursor-pointer flex flex-col" onclick="selectSuggestion('${escHtml(o.orderId)}')">
                     <span class="font-mono text-xs font-semibold text-gray-800">${escHtml(o.orderId)}</span>
                     <span class="text-[10px] text-gray-500">${escHtml(firstName)} ${escHtml(lastName)}</span>
                   </div>`;
              }).join('');
            }
          })
          .catch(() => {
            searchSuggestions.innerHTML = `<div class="p-3 text-sm text-red-400 text-center">Failed to load suggestions</div>`;
          })
          .finally(() => searchSpinner.classList.add('hidden'));
      }

      function selectSuggestion(orderId) {
        searchInput.value = orderId;
        searchSuggestions.classList.add('hidden');
        fetchOrders(1);
      }

      // Hide suggestions when clicking outside
      document.addEventListener('click', (e) => {
        if (!searchInput.contains(e.target) && !searchSuggestions.contains(e.target)) {
          searchSuggestions.classList.add('hidden');
        }
      });

      searchInput.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => fetchSuggestions(), 400);
      });

      // Also open on focus if input has value
      searchInput.addEventListener('focus', () => {
        if (searchInput.value.trim().length > 0 && searchSuggestions.innerHTML.trim() !== '') {
          searchSuggestions.classList.remove('hidden');
        }
      });

      sortSelect.addEventListener('change', () => fetchOrders(1));
      paginationWrap.addEventListener('click', e => { const btn = e.target.closest('[data-page]'); if (btn) fetchOrders(Number(btn.dataset.page)); });
      function clearSearch() { searchInput.value = ''; searchSuggestions.classList.add('hidden'); clearBtn.classList.add('hidden'); fetchOrders(1); }

      document.getElementById('statusTabs').addEventListener('click', e => {
        const btn = e.target.closest('[data-status]');
        if (!btn) return;
        currentStatus = btn.dataset.status;
        document.querySelectorAll('.status-tab').forEach(b => {
          const active = b.dataset.status === currentStatus;
          b.className = `status-tab px-4 py-2 rounded text-sm font-medium transition border ${active ? 'bg-gray-900 text-white border-gray-900' : 'bg-white border-gray-200 text-gray-700 hover:bg-gray-50'}`;
        });
        fetchOrders(1);
      });

      // ── Render Table ───────────────────────────────────────────────────────
      function renderTable(orders) {
        const tbody = document.getElementById('ordersTableBody');
        if (!orders || orders.length === 0) {
          tbody.innerHTML = `<tr><td colspan="5" class="px-5 py-12 text-center text-gray-400">
        <i class="bi bi-bag text-3xl block mb-2"></i>No orders found.</td></tr>`;
          return;
        }
        tbody.innerHTML = orders.map(o => {
          const firstName = o.shippingAddress?.firstName || '?';
          const lastName = o.shippingAddress?.lastName || '';
          const email = o.shippingAddress?.email || '';
          const initial = firstName[0].toUpperCase();
          const dateStr = new Date(o.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });

          return `
        <tr class="order-row transition align-top" data-order-id="${o._id}">
          <td class="px-5 py-3.5">
            <span class="font-mono text-xs font-semibold text-gray-800 block">${escHtml(o.orderId)}</span>
          </td>
          <td class="px-5 py-3.5 text-xs text-gray-500 whitespace-nowrap">${dateStr}</td>
          <td class="px-5 py-3.5">
            <div class="flex items-center gap-2">
              <div class="w-9 h-9 shrink-0 rounded-full bg-gray-200 text-gray-700 flex items-center justify-center text-xs font-semibold">${initial}</div>
              <div class="min-w-0">
                <p class="text-sm font-medium text-gray-800 truncate">${escHtml(firstName)} ${escHtml(lastName)}</p>
                <p class="text-[10px] text-gray-400 truncate max-w-[120px]">${escHtml(email)}</p>
              </div>
            </div>
          </td>
          <td class="px-5 py-3.5">
            <div class="flex flex-col gap-2">
              ${statusBadgeHtml(o.orderStatus)}
            </div>
          </td>
          <td class="px-5 py-3.5">
            <div class="flex items-center gap-2 text-sm font-medium">
              <button onclick="window.location.href='/admin/orders/${o._id}'" class="text-blue-600 hover:text-blue-800 transition">View Detail</button>
              <span class="text-gray-300">|</span>
              <button onclick="openDeleteConfirm('${o._id}','${escHtml(o.orderId)}')" class="text-red-500 hover:text-red-700 transition">Delete</button>
            </div>
          </td>
        </tr>`;
        }).join('');
      }

      function renderPagination(current, total) {
        if (total === 0) { paginationWrap.innerHTML = ''; return; }
        let html = current > 1
          ? `<button data-page="${current - 1}" class="inline-flex items-center justify-center w-8 h-8 text-sm rounded border border-gray-200 bg-white hover:bg-gray-50 transition"><i class="bi bi-chevron-left text-xs"></i></button>`
          : `<span class="inline-flex items-center justify-center w-8 h-8 text-sm rounded border border-gray-200 bg-white opacity-40 cursor-not-allowed"><i class="bi bi-chevron-left text-xs"></i></span>`;
        for (let i = 1; i <= total; i++) {
          const cls = i === current ? 'bg-gray-900 text-white border-gray-900' : 'border-gray-200 bg-white hover:bg-gray-50 text-gray-700';
          html += `<button data-page="${i}" class="inline-flex items-center justify-center w-8 h-8 text-sm rounded border transition ${cls}">${i}</button>`;
        }
        html += current < total
          ? `<button data-page="${current + 1}" class="inline-flex items-center justify-center w-8 h-8 text-sm rounded border border-gray-200 bg-white hover:bg-gray-50 transition"><i class="bi bi-chevron-right text-xs"></i></button>`
          : `<span class="inline-flex items-center justify-center w-8 h-8 text-sm rounded border border-gray-200 bg-white opacity-40 cursor-not-allowed"><i class="bi bi-chevron-right text-xs"></i></span>`;
        paginationWrap.innerHTML = html;
      }

      // Modals moved to orderDetails.ejs

      // ── Delete ─────────────────────────────────────────────────────────────
      function openDeleteConfirm(id, label) {
        _deleteId = id;
        document.getElementById('confirmDesc').textContent = `Permanently delete order ${label}? This cannot be undone.`;
        document.getElementById('confirmModal').classList.remove('hidden');
        document.getElementById('confirmModal').classList.add('flex');
      }

      function closeDeleteConfirm() {
        document.getElementById('confirmModal').classList.add('hidden');
        document.getElementById('confirmModal').classList.remove('flex');
        _deleteId = null;
      }

      document.getElementById('confirmDeleteBtn').addEventListener('click', async () => {
        const id = _deleteId;
        closeDeleteConfirm();
        try {
          const res = await fetch(`/admin/orders/${id}/delete`, { method: 'DELETE', credentials: 'include' });
          const data = await res.json();
          if (data.success) {
            let pg = 1;
            document.querySelectorAll('#paginationWrap button[data-page]').forEach(b => { if (b.classList.contains('bg-gray-900')) pg = Number(b.dataset.page); });
            const rows = document.querySelectorAll('#ordersTableBody tr[data-order-id]');
            showToast('Order deleted.', 'success');
            fetchOrders(rows.length <= 1 && pg > 1 ? pg - 1 : pg);
          } else { showToast(data.message || 'Delete failed.', 'error'); }
        } catch { showToast('Network error.', 'error'); }
      });

      // ── Toast ──────────────────────────────────────────────────────────────
      let _toastTimer = null;
      function showToast(msg, type = 'success') {
        const toast = document.getElementById('toast');
        document.getElementById('toastMsg').textContent = msg;
        const icons = { success: 'bi bi-check-circle-fill', warning: 'bi bi-exclamation-circle-fill', error: 'bi bi-x-circle-fill' };
        const bgs = { success: 'bg-green-600', warning: 'bg-amber-500', error: 'bg-red-600' };
        document.getElementById('toastIcon').className = `${icons[type] || icons.success} text-lg shrink-0`;
        toast.className = `fixed top-[72px] right-5 z-[9999] flex items-center gap-3 px-5 py-3.5 rounded-xl shadow-xl text-white text-sm font-medium min-w-[220px] max-w-xs ${bgs[type] || bgs.success}`;
        toast.classList.remove('hidden');
        if (_toastTimer) clearTimeout(_toastTimer);
        _toastTimer = setTimeout(() => toast.classList.add('hidden'), 3500);
      }

      // ── Return Approval / Rejection ────────────────────────────────
      async function adminApproveReturn(orderId) {
        showConfirm({
          title: 'Approve Return?',
          message: 'Approve all pending return requests? This will issue an immediate refund to the customer\'s wallet.',
          confirmText: 'Approve & Refund',
          confirmColor: 'bg-green-600',
          onConfirm: async () => {
            try {
              const res = await fetch(`/admin/orders/${orderId}/return/approve`, { method: 'PATCH', credentials: 'include' });
              const data = await res.json();
              if (data.success) {
                showToast('Return approved. Refund issued.', 'success');
                closeOrderModal();
                fetchOrders();
              } else { showToast(data.message || 'Approval failed.', 'error'); }
            } catch { showToast('Network error.', 'error'); }
          }
        });
      }

      let _activeRejectId = null;
      function openRejectModalModal(orderId) {
        _activeRejectId = orderId;
        document.getElementById('modalRejectReason').value = '';
        document.getElementById('modalRejectContainer').classList.remove('hidden');
        document.getElementById('modalRejectContainer').classList.add('flex');
      }

      function closeRejectModal() {
        document.getElementById('modalRejectContainer').classList.add('hidden');
        document.getElementById('modalRejectContainer').classList.remove('flex');
        _activeRejectId = null;
      }

      async function submitRejectRequest() {
        const orderId = _activeRejectId;
        const reason = document.getElementById('modalRejectReason').value.trim();
        if (!reason) { showToast('Please enter a rejection reason.', 'error'); return; }

        try {
          const res = await fetch(`/admin/orders/${orderId}/return/reject`, {
            method: 'PATCH', credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reason })
          });
          const data = await res.json();
          if (data.success) {
            showToast('Return request rejected.', 'success');
            closeRejectModal();
            closeOrderModal();
            fetchOrders();
          } else { showToast(data.message || 'Rejection failed.', 'error'); }
        } catch { showToast('Network error.', 'error'); }
      }

      // ── Custom Action Confirmation Modal Logic ──────────────────────────────
      let _actionConfirmCallback = null;
      function showConfirm({ title, message, confirmText, confirmColor, onConfirm }) {
        document.getElementById('actionConfirmModalTitle').innerText = title || 'Are you sure?';
        document.getElementById('actionConfirmModalMessage').innerText = message || '';
        const btn = document.getElementById('actionConfirmModalBtn');
        btn.innerText = confirmText || 'Confirm';
        btn.className = `flex-1 py-3 ${confirmColor || 'bg-gray-900'} text-white rounded-xl font-bold text-sm transition hover:opacity-90 active:scale-95`;
        _actionConfirmCallback = onConfirm;
        document.getElementById('actionConfirmModal').classList.remove('hidden');
        document.getElementById('actionConfirmModal').classList.add('flex');
      }

      function closeActionConfirmModal() {
        document.getElementById('actionConfirmModal').classList.add('hidden');
        document.getElementById('actionConfirmModal').classList.remove('flex');
        _actionConfirmCallback = null;
      }

      function executeActionConfirm() {
        if (_actionConfirmCallback) _actionConfirmCallback();
        closeActionConfirmModal();
      }
    </script>
    <!-- Custom Action Confirm Modal -->
    <div id="actionConfirmModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-[100] items-center justify-center p-4">
      <div class="bg-white rounded-3xl p-8 w-full max-w-sm shadow-2xl scale-up-center">
        <div class="w-16 h-16 bg-gray-50 rounded-2xl flex items-center justify-center mb-6 mx-auto">
          <i class="bi bi-question-circle text-gray-400 text-3xl"></i>
        </div>
        <h3 id="actionConfirmModalTitle" class="text-xl font-black text-gray-900 text-center mb-2">Confirm Action</h3>
        <p id="actionConfirmModalMessage" class="text-sm text-gray-500 text-center mb-8 px-2 font-medium leading-relaxed"></p>
        <div class="flex gap-3">
          <button onclick="closeActionConfirmModal()"
            class="flex-1 py-3 border border-gray-100 rounded-xl font-bold text-gray-400 hover:bg-gray-50 text-sm transition active:scale-95">Cancel</button>
          <button id="actionConfirmModalBtn" onclick="executeActionConfirm()"
            class="flex-1 py-3 bg-gray-900 text-white rounded-xl font-bold text-sm transition shadow-lg shadow-gray-200">Confirm</button>
        </div>
      </div>
    </div>

    <!-- Custom Reject Modal -->
    <div id="modalRejectContainer" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-[100] items-center justify-center p-4">
      <div class="bg-white rounded-3xl p-8 w-full max-w-md shadow-2xl scale-up-center">
        <h3 class="text-xl font-black text-gray-900 mb-2">Reject Return</h3>
        <p class="text-xs font-medium text-gray-400 mb-6">Explain the reason for rejecting this return request.</p>
        
        <textarea id="modalRejectReason" rows="4" 
          class="w-full bg-gray-50 border border-gray-100 rounded-2xl p-4 text-sm focus:ring-2 focus:ring-red-100 outline-none resize-none mb-6"
          placeholder="e.g. Returned item was damaged or missing parts..."></textarea>
          
        <div class="flex gap-3">
          <button onclick="closeRejectModal()"
            class="flex-1 py-3 border border-gray-100 rounded-xl font-bold text-gray-400 hover:bg-gray-50 text-sm transition">Cancel</button>
          <button onclick="submitRejectRequest()"
            class="flex-1 py-3 bg-red-600 text-white rounded-xl font-bold text-sm transition shadow-lg shadow-red-100">Confirm Reject</button>
        </div>
      </div>
    </div>

    <style>
      .scale-up-center { animation: scale-up-center 0.2s cubic-bezier(0.390, 0.575, 0.565, 1.000) both; }
      @keyframes scale-up-center {
        0% { transform: scale(0.95); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
      }
    </style>
  </body>

  </html>
<% } %>