<%
  const isLoggedIn = typeof user !== 'undefined' && user;
  const userName = isLoggedIn ? `${user.firstName || ''} ${user.lastName || ''}`.trim() : 'Guest User';
  const navCategories = typeof categories !== 'undefined' ? categories : [];
%>

<div id="sidebar-overlay" class="fixed inset-0 bg-black/40 z-40 md:hidden"></div>

<div id="mobile-sidebar" class="fixed top-0 left-0 h-full w-64 bg-white z-50 shadow-2xl flex flex-col md:hidden">
  <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
    <span class="font-bold text-lg">ElectroHub</span>
    <button onclick="closeSidebar()" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100">
      <i class="bi bi-x-lg text-gray-600"></i>
    </button>
  </div>

  <div class="flex items-center gap-3 px-5 py-4 border-b border-gray-100 bg-gray-50">
    <% if (isLoggedIn) { %>
      <img src="<%= user.profileImage || `https://ui-avatars.com/api/?name=${encodeURIComponent(userName)}&background=random` %>"
        class="rounded-full w-11 h-11 shrink-0 object-cover" alt="Profile">
      <div>
        <p class="font-bold text-sm text-gray-900 leading-tight"><%= userName %></p>
        <p class="text-xs text-gray-400"><%= user.email || '' %></p>
      </div>
    <% } else { %>
      <div class="w-11 h-11 rounded-full bg-gray-200 flex items-center justify-center">
        <i class="bi bi-person text-gray-400 text-xl"></i>
      </div>
      <div>
        <p class="font-bold text-sm text-gray-900 leading-tight">Guest User</p>
        <a href="/user/login" class="text-xs text-red-600 font-medium hover:underline">Login to account</a>
      </div>
    <% } %>
  </div>

  <nav class="flex flex-col gap-1 px-3 py-4 flex-1 overflow-y-auto">
    <a href="/" class="mobile-nav-link"><i class="bi bi-house"></i> Home</a>
    <a href="/user/list" class="mobile-nav-link"><i class="bi bi-shop"></i> Shop</a>
    <button onclick="toggleMobileCategories()" class="mobile-nav-link text-left justify-between">
      <span><i class="bi bi-grid"></i> Categories</span>
      <i id="mobile-category-arrow" class="bi bi-chevron-down text-xs"></i>
    </button>
    <div id="mobile-category-list" class="hidden pl-4">
      <a href="/user/list" class="mobile-nav-link"><i class="bi bi-grid text-xs"></i> All Products</a>
      <% navCategories.forEach((category) => { %>
        <a href="/user/list?category=<%= category._id %>" class="mobile-nav-link">
          <i class="bi bi-tag text-xs"></i> <%= category.categoryName %>
        </a>
      <% }) %>
    </div>

    <% if (isLoggedIn) { %>
      <a href="/user/dashboard" class="mobile-nav-link"><i class="bi bi-speedometer2"></i> Dashboard</a>
      <a href="/user/orders" class="mobile-nav-link"><i class="bi bi-bag-check"></i> Orders</a>
      <a href="/user/cart" class="mobile-nav-link"><i class="bi bi-cart3"></i> Cart</a>
      <a href="/user/wishlist" class="mobile-nav-link"><i class="bi bi-heart"></i> Wishlist</a>
      <a href="/user/address" class="mobile-nav-link"><i class="bi bi-geo-alt"></i> Address</a>
      <a href="/user/wallet" class="mobile-nav-link"><i class="bi bi-wallet2"></i> Wallet</a>
      <a href="/user/coupons" class="mobile-nav-link"><i class="bi bi-ticket-perforated"></i> Coupons</a>
    <% } %>
  </nav>

  <div class="px-3 py-3 border-t border-gray-100">
    <% if (isLoggedIn) { %>
      <a href="/user/logout" class="mobile-nav-link text-red-500 hover:bg-red-50"><i class="bi bi-power"></i> Logout</a>
    <% } else { %>
      <a href="/user/login" class="mobile-nav-link text-red-500 hover:bg-red-50"><i class="bi bi-box-arrow-in-right"></i> Login</a>
    <% } %>
  </div>
</div>

<style>
  html { scroll-padding-top: 80px; overflow-y: scroll; }
  #mobile-sidebar { transform: translateX(-100%); transition: transform .25s ease; }
  #mobile-sidebar.open { transform: translateX(0); }
  #sidebar-overlay { opacity: 0; pointer-events: none; transition: opacity .25s ease; }
  #sidebar-overlay.open { opacity: 1; pointer-events: auto; }
  .search-wrap { position: relative; }
  .search-suggestions { display: none; position: absolute; top: calc(100% + 6px); left: 0; right: 0; z-index: 9999; background: white; border: 1px solid #e5e7eb; border-radius: .9rem; box-shadow: 0 12px 30px rgba(0,0,0,.12); overflow: hidden; }
  .search-suggestions a, .search-suggestions div { display: block; padding: .7rem .9rem; font-size: .83rem; color: #374151; }
  .search-suggestions a:hover { background: #fef2f2; color: #dc2626; }
  .mobile-nav-link { display: flex; align-items: center; gap: .75rem; width: 100%; padding: .75rem 1rem; border-radius: .75rem; font-size: .875rem; font-weight: 500; color: #4b5563; }
  .mobile-nav-link:hover { background: #f9fafb; color: #dc2626; }
  .nav-link { padding: .5rem .75rem; border-radius: .75rem; transition: color .15s ease, background .15s ease; }
  .nav-link:hover { color: #dc2626; background: #fef2f2; }
  .nav-badge { position: absolute; top: -5px; right: -5px; min-width: 18px; height: 18px; padding: 0 4px; border-radius: 99px; background: #dc2626; color: white; border: 2px solid white; font-size: 10px; font-weight: 700; line-height: 16px; text-align: center; display: none; }
  #profile-menu, #mobile-menu { position: fixed; z-index: 9999; }
</style>

<nav class="sticky top-0 bg-white/95 backdrop-blur border-b border-gray-100 shadow-sm" style="z-index:100">
  <div class="max-w-screen-2xl mx-auto px-4 flex items-center h-16 gap-3">
    <button onclick="openSidebar()"
      class="md:hidden w-10 h-10 flex items-center justify-center rounded-full bg-gray-100 text-gray-600 hover:bg-red-600 hover:text-white">
      <i class="bi bi-list text-xl"></i>
    </button>

    <a href="/" class="text-xl font-bold whitespace-nowrap">       
      ElectroHub
    </a>

    <ul class="hidden md:flex items-center gap-1 text-sm font-medium text-gray-600 mx-auto">
      <li><a href="/" class="nav-link">Home</a></li>
      <li><a href="/user/list" class="nav-link">Shop</a></li>
      <li class="relative group">
        <a href="/user/list" class="nav-link flex items-center gap-1">
          Categories <i class="bi bi-chevron-down text-xs"></i>
        </a>
        <div class="hidden group-hover:block absolute left-0 top-full w-52 bg-white border border-gray-100 rounded-xl shadow-xl p-2">
          <a href="/user/list" class="block px-3 py-2 rounded-lg text-sm hover:bg-red-50 hover:text-red-600">All Products</a>
          <% navCategories.forEach((category) => { %>
            <a href="/user/list?category=<%= category._id %>"
              class="block px-3 py-2 rounded-lg text-sm hover:bg-red-50 hover:text-red-600">
              <%= category.categoryName %>
            </a>
          <% }) %>
        </div>
      </li>
      <li><a href="/#new-arrivals" class="nav-link">New Arrivals</a></li>
      <li><a href="/user/coupons" class="nav-link">Coupons</a></li>
    </ul>

    <div class="flex items-center gap-2 ml-auto">
      <div class="hidden md:block search-wrap">
        <form class="flex items-center" onsubmit="navSearch(event, 'desktop')">
          <input id="nav-search-desktop" type="text" placeholder="Find your next gadget..." autocomplete="off"
            class="w-44 lg:w-64 px-4 py-2 text-sm border border-gray-200 rounded-l-full focus:outline-none focus:border-red-400">
          <button type="submit" class="px-4 py-2 bg-gray-900 text-white rounded-r-full hover:bg-red-600">
            <i class="bi bi-search text-sm"></i>
          </button>
        </form>
        <div id="search-suggestions-desktop" class="search-suggestions"></div>
      </div>

      <% if (isLoggedIn) { %>
        <a href="/user/wishlist" title="Wishlist" class="relative nav-icon">
          <i class="bi bi-heart"></i>
          <span id="wishlist-badge" class="nav-badge"></span>
        </a>
        <a href="/user/cart" title="Cart" class="relative nav-icon">
          <i class="bi bi-bag"></i>
          <span id="cart-badge" class="nav-badge"></span>
        </a>
        <button id="profile-btn" title="Profile" class="nav-icon">
          <i class="bi bi-person"></i>
        </button>
        <div id="profile-menu" class="hidden w-52 bg-white rounded-xl shadow-xl border border-gray-100 p-2">
          <p class="px-3 py-2 text-xs text-gray-400">Hi, <%= user.firstName %></p>
          <a href="/user/dashboard" class="block px-3 py-2 rounded-lg text-sm hover:bg-red-50 hover:text-red-600">Dashboard</a>
          <a href="/user/orders" class="block px-3 py-2 rounded-lg text-sm hover:bg-red-50 hover:text-red-600">My Orders</a>
          <a href="/user/logout" class="block px-3 py-2 rounded-lg text-sm text-red-600 hover:bg-red-50">Logout</a>
        </div>
      <% } else { %>
        <a href="/user/login" class="bg-red-600 text-white hover:bg-black px-5 py-2.5 rounded-full text-sm font-semibold">Login / Sign Up</a>
      <% } %>

      <button id="mobile-menu-btn" class="md:hidden nav-icon">
        <i class="bi bi-three-dots-vertical"></i>
      </button>
      <div id="mobile-menu" class="hidden w-48 bg-white rounded-xl shadow-xl border border-gray-100 p-2">
        <a href="/" class="block px-3 py-2 rounded-lg text-sm hover:bg-red-50 hover:text-red-600">Home</a>
        <a href="/user/list" class="block px-3 py-2 rounded-lg text-sm hover:bg-red-50 hover:text-red-600">Shop</a>
        <a href="/user/coupons" class="block px-3 py-2 rounded-lg text-sm hover:bg-red-50 hover:text-red-600">Coupons</a>
      </div>
    </div>
  </div>

  <div class="md:hidden border-t border-gray-100 px-4 py-2">
    <div class="search-wrap">
      <form class="flex items-center" onsubmit="navSearch(event, 'mobile')">
        <input id="nav-search-mobile" type="text" placeholder="Find your next gadget..." autocomplete="off"
          class="w-full px-4 py-2 text-sm border border-gray-200 rounded-l-full focus:outline-none focus:border-red-400">
        <button type="submit" class="px-4 py-2 bg-gray-900 text-white rounded-r-full hover:bg-red-600">
          <i class="bi bi-search text-sm"></i>
        </button>
      </form>
      <div id="search-suggestions-mobile" class="search-suggestions"></div>
    </div>
  </div>
</nav>

<style>
  .nav-icon { width: 2.5rem; height: 2.5rem; display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; background: #f3f4f6; color: #4b5563; transition: all .15s ease; }
  .nav-icon:hover { background: #dc2626; color: white; }
  @media (min-width: 768px) {
    #mobile-menu-btn { display: none !important; }
  }
</style>

<script>
  var searchTimer;

  function openSidebar() {
    var mobileSidebar = document.getElementById('mobile-sidebar');
    var sidebarOverlay = document.getElementById('sidebar-overlay');
    if (mobileSidebar) {
      mobileSidebar.classList.add('open');
    }
    if (sidebarOverlay) {
      sidebarOverlay.classList.add('open');
    }
    document.body.style.overflow = 'hidden';
  }

  function closeSidebar() {
    var mobileSidebar = document.getElementById('mobile-sidebar');
    var sidebarOverlay = document.getElementById('sidebar-overlay');
    if (mobileSidebar) {
      mobileSidebar.classList.remove('open');
    }
    if (sidebarOverlay) {
      sidebarOverlay.classList.remove('open');
    }
    document.body.style.overflow = '';
  }

  function toggleMobileCategories() {
    var categoryList = document.getElementById('mobile-category-list');
    var categoryArrow = document.getElementById('mobile-category-arrow');
    
    if (categoryList) {
      categoryList.classList.toggle('hidden');
    }
    if (categoryArrow) {
      categoryArrow.classList.toggle('rotate-180');
    }
  }

  function toggleMenu(buttonId, menuId) {
    var button = document.getElementById(buttonId);
    var menu = document.getElementById(menuId);
    
    if (!button || !menu) {
      return;
    }

    button.addEventListener('click', function(event) {
      event.stopPropagation();
      menu.classList.toggle('hidden');
      var rect = button.getBoundingClientRect();
      menu.style.top = (rect.bottom + 6) + 'px';
      menu.style.right = (window.innerWidth - rect.right) + 'px';
    });

    menu.addEventListener('click', function(event) {
      event.stopPropagation();
    });
  }

  function navSearch(event, type) {
    event.preventDefault();
    var inputId = '';
    if (type === 'desktop') {
      inputId = 'nav-search-desktop';
    } else {
      inputId = 'nav-search-mobile';
    }
    
    var input = document.getElementById(inputId);
    if (!input) {
      return;
    }
    
    var query = input.value.trim();
    if (query === '') {
      return;
    }

    if (typeof STATE !== 'undefined' && typeof applyFilters === 'function') {
      STATE.search = query;
      var pageSearch = document.getElementById('sInput');
      if (pageSearch) {
        pageSearch.value = query;
      }
      applyFilters();
    } else {
      window.location.href = '/user/list?search=' + encodeURIComponent(query);
    }
  }

  function setupSearchSuggestions(type) {
    var inputId = '';
    if (type === 'desktop') {
      inputId = 'nav-search-desktop';
    } else {
      inputId = 'nav-search-mobile';
    }
    
    var input = document.getElementById(inputId);
    var box = document.getElementById('search-suggestions-' + type);
    
    if (!input || !box) {
      return;
    }

    input.addEventListener('input', function() {
      clearTimeout(searchTimer);
      var query = input.value.trim();
      
      if (query.length < 2) {
        hideSearchSuggestions();
        return;
      }
      
      searchTimer = setTimeout(function() {
        loadSearchSuggestions(query, type);
      }, 250);
    });

    input.addEventListener('click', function(event) {
      event.stopPropagation();
    });
    box.addEventListener('click', function(event) {
      event.stopPropagation();
    });
  }

  async function loadSearchSuggestions(query, type) {
    var box = document.getElementById('search-suggestions-' + type);
    if (!box) {
      return;
    }

    try {
      var res = await fetch('/user/search-suggestions?q=' + encodeURIComponent(query), {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      });
      var data = await res.json();
      var categories = data.categories || [];
      var products = data.products || data.variants || [];

      var html = '';
      
      var topCategories = categories.slice(0, 3);
      for (var i = 0; i < topCategories.length; i++) {
        var category = topCategories[i];
        html += '<a href="/user/list?category=' + category._id + '"><i class="bi bi-tag mr-2 text-red-500"></i>' + escapeText(category.categoryName) + '</a>';
      }
      
      var topProducts = products.slice(0, 5);
      for (var j = 0; j < topProducts.length; j++) {
        var product = topProducts[j];
        html += '<a href="/user/product/' + product._id + '"><i class="bi bi-bag mr-2 text-red-500"></i>' + escapeText(product.productName) + '</a>';
      }

      if (html === '') {
        box.innerHTML = '<div>No results found</div>';
      } else {
        box.innerHTML = html;
      }
      
      box.style.display = 'block';
    } catch (error) {
      hideSearchSuggestions();
    }
  }

  function hideSearchSuggestions() {
    var desktopBox = document.getElementById('search-suggestions-desktop');
    if (desktopBox) {
      desktopBox.style.display = 'none';
    }
    
    var mobileBox = document.getElementById('search-suggestions-mobile');
    if (mobileBox) {
      mobileBox.style.display = 'none';
    }
  }

  function escapeText(value) {
    var strValue = String(value || '');
    var result = '';
    for (var i = 0; i < strValue.length; i++) {
      var char = strValue[i];
      if (char === '&') {
        result += '&amp;';
      } else if (char === '<') {
        result += '&lt;';
      } else if (char === '>') {
        result += '&gt;';
      } else if (char === '"') {
        result += '&quot;';
      } else if (char === "'") {
        result += '&#39;';
      } else {
        result += char;
      }
    }
    return result;
  }

  async function loadNavCounts() {
    try {
      var res = await fetch('/user/nav-counts', { 
        headers: { 'X-Requested-With': 'XMLHttpRequest' } 
      });
      if (!res.ok) {
        return;
      }
      var data = await res.json();
      var cartCount = data.cartCount || 0;
      var wishlistCount = data.wishlistCount || 0;
      
      setNavBadge('cart-badge', cartCount);
      setNavBadge('wishlist-badge', wishlistCount);
    } catch (error) {
      // Do nothing on error
    }
  }

  function setNavBadge(id, count) {
    var badge = document.getElementById(id);
    if (!badge) {
      return;
    }
    
    if (count > 99) {
      badge.textContent = '99+';
    } else {
      badge.textContent = count;
    }
    
    if (count > 0) {
      badge.style.display = 'block';
    } else {
      badge.style.display = 'none';
    }
  }

  window.updateNavBadge = function(type, change) {
    var id = '';
    if (type === 'cart') {
      id = 'cart-badge';
    } else {
      id = 'wishlist-badge';
    }
    
    var badge = document.getElementById(id);
    var currentText = '0';
    if (badge && badge.textContent) {
      currentText = badge.textContent;
    }
    
    var current = parseInt(currentText, 10);
    if (isNaN(current)) {
      current = 0;
    }
    
    var newCount = current + change;
    if (newCount < 0) {
      newCount = 0;
    }
    
    setNavBadge(id, newCount);
  };

  document.addEventListener('DOMContentLoaded', function() {
    var overlay = document.getElementById('sidebar-overlay');
    if (overlay) {
      overlay.addEventListener('click', closeSidebar);
    }
    
    toggleMenu('profile-btn', 'profile-menu');
    toggleMenu('mobile-menu-btn', 'mobile-menu');
    
    setupSearchSuggestions('desktop');
    setupSearchSuggestions('mobile');
    
    loadNavCounts();
  });

  document.addEventListener('click', function() {
    var profileMenu = document.getElementById('profile-menu');
    if (profileMenu) {
      profileMenu.classList.add('hidden');
    }
    
    var mobileMenu = document.getElementById('mobile-menu');
    if (mobileMenu) {
      mobileMenu.classList.add('hidden');
    }
    
    hideSearchSuggestions();
  });
</script>
