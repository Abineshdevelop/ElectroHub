<%
  const page = typeof activePage !== 'undefined' ? activePage : '';
  const name = [user?.firstName, user?.lastName].filter(Boolean).join(' ') || 'ElectroHub User';
  const avatar = user?.profileImage || `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=random`;
  const menu = [
    ['dashboard', 'Dashboard', '/user/dashboard', 'bi-grid'],
    ['profile', 'Account Details', '/user/profile', 'bi-person'],
    ['orders', 'Order History', '/user/orders', 'bi-bag-check'],
    ['cart', 'Shopping Cart', '/user/cart', 'bi-cart3'],
    ['wishlist', 'Wishlist', '/user/wishlist', 'bi-heart'],
    ['address', 'Address', '/user/address', 'bi-geo-alt'],
    ['wallet', 'Wallet', '/user/wallet', 'bi-wallet2'],
    ['coupons', 'Coupons', '/user/coupons', 'bi-ticket-perforated']
  ];

  const linkClass = (key) => page === key
    ? 'bg-red-50 text-red-600'
    : 'text-gray-600 hover:bg-gray-100 hover:text-red-600';
%>

<aside class="hidden md:flex flex-col w-56 lg:w-60 shrink-0 bg-gray-50 border-r border-gray-100 p-6 sidebar-desktop">
  <div class="text-center mb-8">
    <div class="inline-block p-1 bg-white rounded-full shadow mb-3">
      <img src="<%= avatar %>" class="rounded-full w-16 h-16 object-cover" alt="Profile">
    </div>
    <h6 class="font-bold text-gray-900 text-sm"><%= name %></h6>
  </div>

  <nav class="flex flex-col gap-1 flex-1">
    <% menu.forEach(([key, label, href, icon]) => { %>
      <a href="<%= href %>"
        class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-sm transition-all <%= linkClass(key) %>">
        <i class="bi <%= icon %> text-base"></i> <%= label %>
      </a>
    <% }) %>
  </nav>

  <div class="mt-6 pt-4 border-t border-gray-200">
    <a href="/user/logout"
      class="flex items-center gap-3 px-4 py-3 rounded-xl text-red-500 hover:bg-red-50 transition">
      <i class="bi bi-power"></i> Logout
    </a>
  </div>
</aside>