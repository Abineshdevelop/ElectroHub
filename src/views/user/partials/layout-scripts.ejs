<script>
document.addEventListener("DOMContentLoaded", () => {
  document.getElementById('mobile-sidebar')?.classList.remove('open');
  document.getElementById('sidebar-overlay')?.classList.remove('open');
  document.body.style.overflow = '';

  document.getElementById('sidebar-overlay')?.addEventListener('click', closeSidebar);

  setupDropdown('profile-btn',   'profile-menu',   null);
  setupDropdown('three-dot-btn', 'three-dot-menu', null);

  document.addEventListener('click', e => {
    if (!e.target.closest('#cat-btn') && !e.target.closest('#cat-mega-menu')) closeMegaMenu();
    closeAllDropdowns(null);
    hideSugg('desktop');
    hideSugg('mobile');
  });

  document.getElementById('cat-btn')?.addEventListener('mouseleave', scheduleMegaClose);

  [['nav-search-desktop','desktop'], ['nav-search-mobile','mobile']].forEach(([id, which]) => {
    const inp = document.getElementById(id);
    if (!inp) return;
    inp.addEventListener('input', () => {
      clearTimeout(suggDebounce[which]);
      const q = inp.value.trim();
      if (!q) { hideSugg(which); return; }
      suggDebounce[which] = setTimeout(() => fetchSuggestions(q, which), 280);
    });
    inp.addEventListener('keydown', e => {
      handleSuggKey(e, which);
      if (e.key === 'Enter') {
        e.preventDefault();
        const box    = document.getElementById('sugg-' + which);
        const sitems = box ? box.querySelectorAll('.sugg-item') : [];
        const ai     = activeIdx[which];
        if (ai >= 0 && sitems[ai]) window.location.href = sitems[ai].getAttribute('href');
        else navSearchGo(inp.value.trim());
        hideSugg(which);
      }
    });
    inp.addEventListener('click', e => e.stopPropagation());
  });
  document.getElementById('sugg-desktop')?.addEventListener('click', e => e.stopPropagation());
  document.getElementById('sugg-mobile')?.addEventListener('click',  e => e.stopPropagation());

  loadMegaCategories();
  loadNavCounts();
});

// ── Sidebar ───────────────────────────────────────────────────────────────
function openSidebar() {
  document.getElementById('mobile-sidebar')?.classList.add('open');
  document.getElementById('sidebar-overlay')?.classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeSidebar() {
  document.getElementById('mobile-sidebar')?.classList.remove('open');
  document.getElementById('sidebar-overlay')?.classList.remove('open');
  document.body.style.overflow = '';
}

// ── Click dropdowns ───────────────────────────────────────────────────────
function closeAllDropdowns(exceptId) {
  ['profile-menu', 'three-dot-menu'].forEach(id => {
    if (id === exceptId) return;
    document.getElementById(id)?.classList.add('hidden');
  });
}

function positionMenu(btnId, menuId) {
  const btn  = document.getElementById(btnId);
  const menu = document.getElementById(menuId);
  if (!btn || !menu) return;
  const r = btn.getBoundingClientRect();
  menu.style.top   = (r.bottom + 6) + 'px';
  menu.style.right = (window.innerWidth - r.right) + 'px';
  menu.style.left  = 'auto';
}

function setupDropdown(btnId, menuId, arrowId) {
  const btn   = document.getElementById(btnId);
  const menu  = document.getElementById(menuId);
  const arrow = arrowId ? document.getElementById(arrowId) : null;
  if (!btn || !menu) return;
  btn.addEventListener('click', e => {
    e.stopPropagation();
    const isOpen = !menu.classList.contains('hidden');
    closeAllDropdowns(isOpen ? null : menuId);
    closeMegaMenu();
    if (!isOpen) {
      positionMenu(btnId, menuId);
      menu.classList.remove('hidden');
      arrow?.classList.add('rotate-180');
    } else {
      menu.classList.add('hidden');
      arrow?.classList.remove('rotate-180');
    }
  });
  menu.addEventListener('click', e => e.stopPropagation());
}

function toggleMobileCat() {
  document.getElementById('mobile-cat-list')?.classList.toggle('open');
  document.getElementById('cat-arrow-mobile')?.classList.toggle('rotate-180');
}

// ── Mega menu (hover) ─────────────────────────────────────────────────────
let megaCloseTimer  = null;
let megaCatsLoaded  = false;
let megaAllCats     = [];
let megaProdCache   = {};
let megaActiveCatId = null;

function openMegaMenu() {
  cancelMegaClose();
  const menu = document.getElementById('cat-mega-menu');
  if (!menu) return;
  const btn = document.getElementById('cat-btn');
  const r   = btn.getBoundingClientRect();
  menu.style.top   = (r.bottom + 4) + 'px';
  menu.style.left  = r.left + 'px';
  menu.style.right = 'auto';
  menu.classList.remove('hidden');
  document.getElementById('cat-arrow-desktop')?.classList.add('rotate-180');
  closeAllDropdowns(null);
}

function closeMegaMenu() {
  document.getElementById('cat-mega-menu')?.classList.add('hidden');
  document.getElementById('cat-arrow-desktop')?.classList.remove('rotate-180');
  megaActiveCatId = null;
}

function scheduleMegaClose() { megaCloseTimer = setTimeout(closeMegaMenu, 200); }
function cancelMegaClose()   { clearTimeout(megaCloseTimer); }

async function loadMegaCategories() {
  try {
    const res = await fetch('/user/nav-categories', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
    if (!res.ok) return;
    megaAllCats    = await res.json();
    megaCatsLoaded = true;
    renderMegaCatList();
  } catch {}
}

function renderMegaCatList() {
  const panel = document.getElementById('mega-cat-list');
  if (!panel) return;
  if (!megaAllCats.length) {
    panel.innerHTML = '<div class="mega-empty" style="padding:20px;font-size:12px">No categories</div>';
    return;
  }
  let html = `
    <div class="mega-cat-item" onmouseenter="loadMegaProducts('')" onclick="window.location.href='/user/list'">
      <span><i class="bi bi-grid-fill" style="color:#dc2626"></i> All Products</span>
    </div>`;
  megaAllCats.forEach(c => {
    const id   = escJs(String(c._id));
    const name = escHtml(c.categoryName || '');
    const cnt  = c.productCount || 0;
    html += `
      <div class="mega-cat-item"
        onmouseenter="loadMegaProducts('${id}','${name}')"
        onclick="window.location.href='/user/list?category=${id}'">
        <span><i class="bi bi-tag"></i> ${name}</span>
        ${cnt ? `<span style="font-size:10px;background:#f3f4f6;border-radius:99px;padding:1px 7px;color:#6b7280;font-weight:700">${cnt}</span>` : ''}
      </div>`;
  });
  panel.innerHTML = html;
  if (megaAllCats[0]) loadMegaProducts(String(megaAllCats[0]._id), megaAllCats[0].categoryName);
}

async function loadMegaProducts(catId, catName) {
  if (megaActiveCatId === catId) return;
  megaActiveCatId = catId;
  document.querySelectorAll('.mega-cat-item').forEach(el => el.classList.remove('active'));
  event?.currentTarget?.classList.add('active');
  const panel = document.getElementById('mega-prod-panel');
  if (!panel) return;
  if (megaProdCache[catId]) { renderMegaProducts(panel, catId, catName, megaProdCache[catId]); return; }
  panel.innerHTML = `<div class="mega-loading"><i class="bi bi-arrow-repeat spin"></i> Loading…</div>`;
  try {
    const url  = catId ? `/user/nav-category-products?category=${catId}&limit=8` : `/user/nav-category-products?limit=8`;
    const res  = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
    const data = await res.json();
    megaProdCache[catId] = data.products || [];
    renderMegaProducts(panel, catId, catName, megaProdCache[catId]);
  } catch {
    panel.innerHTML = `<div class="mega-empty">Could not load products</div>`;
  }
}

function renderMegaProducts(panel, catId, catName, products) {
  if (!products.length) { panel.innerHTML = `<div class="mega-empty">No products yet</div>`; return; }
  const listUrl = catId ? `/user/list?category=${catId}` : '/user/list';
  let html = `<div class="mega-products-title">${escHtml(catName || 'All Products')}</div><div class="mega-prod-grid">`;
  products.forEach(p => {
    const name  = escHtml(p.name || p.productName || '');
    const price = p.price ? `₹${Number(p.price).toLocaleString('en-IN')}` : '';
    const thumb = p.thumbnail || p.image || '';
    const href  = `/user/product/${escHtml(String(p._id || p.productId || ''))}`;
    const imgEl = thumb
      ? `<img class="mega-prod-img" src="${escHtml(thumb)}" alt="">`
      : `<div class="mega-prod-noimg"><i class="bi bi-image" style="color:#d1d5db"></i></div>`;
    html += `
      <a class="mega-prod-card" href="${href}">
        ${imgEl}
        <div style="min-width:0">
          <div class="mega-prod-name">${name}</div>
          ${price ? `<div class="mega-prod-price">${price}</div>` : ''}
        </div>
      </a>`;
  });
  html += `</div><a class="mega-view-all" href="${listUrl}">View all in ${escHtml(catName || 'Shop')} <i class="bi bi-arrow-right"></i></a>`;
  panel.innerHTML = html;
}

// ── Nav badges ────────────────────────────────────────────────────────────
async function loadNavCounts() {
  try {
    const res = await fetch('/user/nav-counts', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
    if (!res.ok) return;
    const data = await res.json();
    setNavBadge('cart-badge',     data.cartCount     || 0);
    setNavBadge('wishlist-badge', data.wishlistCount || 0);
  } catch {}
}

function setNavBadge(id, count) {
  const el = document.getElementById(id);
  if (!el) return;
  el.textContent   = count > 99 ? '99+' : count;
  el.style.display = count > 0 ? 'block' : 'none';
  el.classList.remove('badge-pop');
  void el.offsetWidth;
  if (count > 0) el.classList.add('badge-pop');
}

// ── Global live-update helpers ────────────────────────────────────────────
window.refreshNavCounts = loadNavCounts;

window.updateNavBadge = function(type, delta) {
  const id = type === 'cart' ? 'cart-badge' : 'wishlist-badge';
  const el = document.getElementById(id);
  if (!el) return;
  const current = parseInt(el.textContent) || 0;
  setNavBadge(id, Math.max(0, current + delta));
};

// ── Search suggestions ────────────────────────────────────────────────────
let suggDebounce = {};
let suggData     = { desktop: { categories: [], products: [] }, mobile: { categories: [], products: [] } };
let activeIdx    = { desktop: -1, mobile: -1 };

function hideSugg(which) {
  const box = document.getElementById('sugg-' + which);
  if (box) { box.style.display = 'none'; box.innerHTML = ''; }
  activeIdx[which] = -1;
}
function showSuggBox(which, html) {
  const box = document.getElementById('sugg-' + which);
  if (!box) return;
  box.innerHTML     = html;
  box.style.display = 'block';
}

function escHtml(s) {
  return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function escJs(s) {
  return String(s || '').replace(/\\/g,'\\\\').replace(/'/g,"\\'");
}
function esc(s) { return escHtml(s); }

async function fetchSuggestions(query, which) {
  if (!query || query.length < 2) { hideSugg(which); return; }
  showSuggBox(which, `<div class="sugg-spinner"><i class="bi bi-arrow-repeat spin"></i> Searching…</div>`);
  try {
    const res  = await fetch(`/user/search-suggestions?q=${encodeURIComponent(query)}&variants=1`, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    });
    const data = await res.json();
    suggData[which].categories = data.categories || [];
    suggData[which].products   = data.variants   || data.products || [];
    renderSugg(which, query);
  } catch { hideSugg(which); }
}

function renderSugg(which, query) {
  const cats  = suggData[which].categories;
  const prods = suggData[which].products;
  if (!cats.length && !prods.length) {
    showSuggBox(which, `<div class="sugg-empty"><i class="bi bi-search"></i> No results for "<strong>${escHtml(query)}</strong>"</div>`);
    return;
  }
  let html = '';
  if (cats.length) {
    html += `<div class="sugg-section-label"><i class="bi bi-grid"></i> Categories</div>`;
    cats.slice(0, 4).forEach(c => {
      const name = escHtml(c.categoryName || c.name || '');
      const id   = escHtml(String(c._id || ''));
      const cnt  = c.productCount || c.count || '';
      html += `
        <a class="sugg-cat-item" href="/user/list?category=${id}">
          <div class="sugg-cat-icon"><i class="bi bi-tag" style="color:#dc2626;font-size:14px"></i></div>
          <div>
            <div class="sugg-cat-name">${highlightMatch(c.categoryName || c.name || '', query)}</div>
            ${cnt ? `<div class="sugg-cat-count">${cnt} products</div>` : ''}
          </div>
        </a>`;
    });
  }
  if (prods.length) {
    html += `<div class="sugg-section-label"><i class="bi bi-bag"></i> Products</div>`;
    prods.slice(0, 6).forEach((item, i) => {
      const name  = item.productName || item.name || '';
      const cat   = escHtml(item.categoryName || '');
      const brand = escHtml(item.brandName    || '');
      const price = item.price ? `₹${Number(item.price).toLocaleString('en-IN')}` : '';
      const thumb = item.thumbnail || item.image || '';
      const pid   = String(item.productId || item._id || '');
      const vid   = String(item.variantId  || '');
      const href  = `/user/product/${escHtml(pid)}${vid && vid !== pid ? '?variant=' + escHtml(vid) : ''}`;
      const opts  = item.options || {};
      const chips = Object.entries(opts)
        .filter(([,v]) => v && String(v).trim())
        .map(([k,v]) => `<span class="sugg-vchip">${escHtml(k)}: ${escHtml(String(v))}</span>`)
        .join('');
      const imgEl = thumb
        ? `<img class="sugg-thumb" src="${escHtml(thumb)}" alt="">`
        : `<div class="sugg-noimg"><i class="bi bi-image" style="color:#d1d5db;font-size:18px"></i></div>`;
      html += `
        <a class="sugg-item" href="${href}" data-idx="${i}">
          ${imgEl}
          <div style="flex:1;min-width:0">
            <div class="sugg-name">${highlightMatch(name, query)}</div>
            <div class="sugg-meta">${cat}${brand ? ' · ' + brand : ''}</div>
            ${chips ? `<div class="sugg-variant">${chips}</div>` : ''}
          </div>
          ${price ? `<span class="sugg-price">${price}</span>` : ''}
        </a>`;
    });
  }
  html += `<div class="sugg-footer" onclick="navSearchGo('${escJs(query)}')">
    <i class="bi bi-search text-xs"></i> See all results for "<strong>${escHtml(query)}</strong>"
  </div>`;
  showSuggBox(which, html);
  activeIdx[which] = -1;
}

function highlightMatch(text, query) {
  const safe  = escHtml(String(text || ''));
  const safeQ = query.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
  return safe.replace(new RegExp(`(${safeQ})`, 'gi'),
    '<mark style="background:#fee2e2;color:#dc2626;border-radius:3px;padding:0 2px">$1</mark>');
}

function handleSuggKey(e, which) {
  const box   = document.getElementById('sugg-' + which);
  const items = box ? box.querySelectorAll('.sugg-item') : [];
  if (!items.length) return;
  if (e.key === 'ArrowDown') {
    e.preventDefault();
    activeIdx[which] = Math.min(activeIdx[which] + 1, items.length - 1);
    items.forEach((el, i) => el.classList.toggle('active', i === activeIdx[which]));
  } else if (e.key === 'ArrowUp') {
    e.preventDefault();
    activeIdx[which] = Math.max(activeIdx[which] - 1, -1);
    items.forEach((el, i) => el.classList.toggle('active', i === activeIdx[which]));
  } else if (e.key === 'Escape') {
    hideSugg(which);
  }
}

function navSearchGo(query) {
  if (!query) return;
  if (typeof STATE !== 'undefined' && typeof applyFilters === 'function') {
    STATE.search = query;
    const sInput = document.getElementById('sInput');
    if (sInput) sInput.value = query;
    document.getElementById('sClear')?.classList.toggle('hidden', !query);
    applyFilters();
  } else {
    window.location.href = '/user/list?search=' + encodeURIComponent(query);
  }
}

function navSearch(e, which) {
  e.preventDefault();
  const inp = document.getElementById(which === 'desktop' ? 'nav-search-desktop' : 'nav-search-mobile');
  hideSugg(which);
  navSearchGo(inp?.value.trim() || '');
}
</script>