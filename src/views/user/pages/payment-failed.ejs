<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment Failed - ElectroHub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 text-gray-800">
  <%- include('../partials/navbar', { user }) %>

  <main class="max-w-lg mx-auto px-4 py-20 text-center">

    <div class="mb-8 flex justify-center">
      <div class="w-24 h-24 bg-red-100 rounded-full flex items-center justify-center text-red-600 shadow-sm border border-red-200">
        <i class="bi bi-x-circle-fill text-5xl"></i>
      </div>
    </div>

    <h1 class="text-3xl font-extrabold text-gray-900 mb-3 tracking-tight">Payment Failed</h1>
    <p class="text-base text-gray-500 mb-2 leading-relaxed">
      Your payment attempt was not completed.
    </p>
    <p class="text-sm font-semibold text-amber-600 mb-10">
      Your order has been recorded and is pending payment. You can retry from your Orders page.
    </p>

    <div class="flex flex-col items-center gap-3">
      <button
        id="go-to-orders-btn"
        onclick="window.location.href = '/user/orders'"
        class="w-full sm:w-72 bg-gray-900 text-white font-bold px-10 py-4 rounded-xl hover:bg-black transition-all shadow-lg active:scale-95">
        Go to Orders
      </button>
    </div>

    <p class="text-xs text-gray-400 mt-10 px-4">
      You can retry payment for pending orders from your order history at any time.
    </p>

  </main>

  <%- include('../partials/layout-scripts') %>
</body>
</html>
