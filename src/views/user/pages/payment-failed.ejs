<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment Failed - ElectroHub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 text-gray-800">
  <%- include('../partials/navbar', { user }) %>

  <main class="max-w-lg mx-auto px-4 py-20 text-center">

    <div class="mb-8 flex justify-center">
      <div class="w-24 h-24 bg-red-100 rounded-full flex items-center justify-center text-red-600 shadow-sm border border-red-200">
        <i class="bi bi-x-circle-fill text-5xl"></i>
      </div>
    </div>

    <h1 class="text-3xl font-extrabold text-gray-900 mb-3 tracking-tight">Payment Failed</h1>
    <p class="text-base text-gray-500 mb-2 leading-relaxed">
      Your payment attempt was not completed.
    </p>
    <p class="text-sm font-semibold text-amber-600 mb-10">
      Your order has been recorded and is pending payment. You can retry from your Orders page.
    </p>

    <% if (order) { %>
      <div class="max-w-2xl mx-auto text-left mb-8">
        <%# ── Order Meta ── %>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 mb-6">
          <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-widest mb-4">Order Details</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm">
            <div>
              <p class="text-gray-400 text-xs mb-0.5">Order ID</p>
              <p class="font-semibold text-gray-800 truncate">#<%= order._id.toString().slice(-8).toUpperCase() %></p>
            </div>
            <div>
              <p class="text-gray-400 text-xs mb-0.5">Date</p>
              <p class="font-semibold text-gray-800">
                <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
              </p>
            </div>
            <div>
              <p class="text-gray-400 text-xs mb-0.5">Status</p>
              <span class="inline-flex items-center gap-1 bg-red-50 text-red-700 border border-red-200 text-xs font-semibold px-2.5 py-1 rounded-full">
                <i class="bi bi-exclamation-circle text-xs"></i> Payment Failed
              </span>
            </div>
          </div>
        </div>

        <%# ── Ordered Items ── %>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
          <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-widest mb-4">
            Items in Order <span class="text-gray-300">(<%= order.items.length %>)</span>
          </h2>
          <ul class="divide-y divide-gray-50 mb-4">
            <% order.items.forEach(item => { %>
            <li class="flex items-center gap-4 py-4 first:pt-0 last:pb-0">
              <div class="w-14 h-14 rounded-xl border border-gray-100 bg-gray-50 flex-shrink-0 overflow-hidden">
                <% if (item.productImage) { %>
                  <img src="<%= item.productImage %>" alt="<%= item.productName %>" class="w-full h-full object-cover" onerror="this.onerror=null; this.src='/images/placeholder.svg';" />
                <% } else { %>
                  <div class="w-full h-full flex items-center justify-center text-gray-300">
                    <i class="bi bi-box text-2xl"></i>
                  </div>
                <% } %>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-gray-800 truncate text-sm">
                  <% if (item.productId && item.productId.brandName) { %>
                    <span class="text-[9px] font-bold text-red-500 uppercase tracking-widest block mb-0.5"><%= item.productId.brandName %></span>
                  <% } %>
                  <%= item.productName || 'Product' %>
                </p>
                <% 
                  const attributes = (item.variantAttributes && Object.keys(item.variantAttributes).length > 0)
                    ? item.variantAttributes
                    : (item.variantId && item.variantId.options ? item.variantId.options : null);
                %>
                <% if (attributes) { %>
                  <p class="text-xs text-gray-400 mt-0.5">
                    <%= Object.entries(attributes).map(([k,v]) => `${k}: ${v}`).join(' · ') %>
                  </p>
                <% } %>
                <p class="text-xs text-gray-400 mt-0.5">Qty: <%= item.quantity %></p>
              </div>
              <div class="text-right flex-shrink-0">
                <p class="font-bold text-gray-900 text-sm">₹<%= (item.unitPrice * item.quantity).toLocaleString('en-IN') %></p>
              </div>
            </li>
            <% }) %>
          </ul>

          <%# ── Price Breakdown ── %>
          <div class="pt-4 border-t border-gray-100 space-y-2 text-sm">
            <div class="flex justify-between text-gray-500">
              <span>Total Amount</span>
              <span class="font-bold text-gray-900 text-base">₹<%= order.totalAmount.toLocaleString('en-IN') %></span>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <div class="flex flex-col items-center gap-3">
      <button
        id="go-to-orders-btn"
        onclick="window.location.href = '/user/orders'"
        class="w-full sm:w-72 bg-gray-900 text-white font-bold px-10 py-4 rounded-xl hover:bg-black transition-all shadow-lg active:scale-95">
        <i class="bi bi-bag-check mr-2"></i>Go to Orders
      </button>
      <a href="/user/home" class="w-full sm:w-72 bg-white border border-gray-200 text-gray-700 font-bold px-10 py-4 rounded-xl hover:bg-gray-50 transition-all text-center active:scale-95">
        <i class="bi bi-arrow-left mr-2"></i>Continue Shopping
      </a>
    </div>

    <p class="text-xs text-gray-400 mt-10 px-4">
      You can retry payment for pending orders from your order history at any time.
    </p>

  </main>
  <%- include('../partials/footer') %>
</body>
</html>
