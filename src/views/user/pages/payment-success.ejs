<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment Successful - ElectroHub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 text-gray-800">
  <%- include('../partials/navbar', { user }) %>

  <main class="max-w-3xl mx-auto px-4 py-12">

    <%# ── Success Banner ── %>
    <div class="bg-white rounded-2xl border border-green-100 shadow-sm p-8 text-center mb-6">
      <div class="flex justify-center mb-4">
        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center border border-green-200">
          <i class="bi bi-check-circle-fill text-4xl text-green-600"></i>
        </div>
      </div>
      <h1 class="text-2xl font-extrabold text-gray-900 mb-1">Payment Successful!</h1>
      <p class="text-gray-500 text-sm mb-4">Your order has been placed and is being processed.</p>
      <div class="inline-block bg-green-50 border border-green-200 rounded-xl px-6 py-3">
        <p class="text-xs text-gray-500 uppercase tracking-widest mb-0.5">Amount Paid</p>
        <p class="text-3xl font-black text-gray-900">₹<%= amount ? amount.toLocaleString('en-IN') : '0' %></p>
      </div>
    </div>

    <% if (order) { %>

    <%# ── Order Meta ── %>
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 mb-6">
      <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-widest mb-4">Order Details</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm">
        <div>
          <p class="text-gray-400 text-xs mb-0.5">Order ID</p>
          <p class="font-semibold text-gray-800 truncate">#<%= order._id.toString().slice(-8).toUpperCase() %></p>
        </div>
        <div>
          <p class="text-gray-400 text-xs mb-0.5">Date</p>
          <p class="font-semibold text-gray-800">
            <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
          </p>
        </div>
        <div>
          <p class="text-gray-400 text-xs mb-0.5">Status</p>
          <span class="inline-flex items-center gap-1 bg-yellow-50 text-yellow-700 border border-yellow-200 text-xs font-semibold px-2.5 py-1 rounded-full">
            <i class="bi bi-clock text-xs"></i> <%= order.orderStatus || 'Processing' %>
          </span>
        </div>
        <% if (order.paymentMethod) { %>
        <div>
          <p class="text-gray-400 text-xs mb-0.5">Payment</p>
          <p class="font-semibold text-gray-800 capitalize"><%= order.paymentMethod %></p>
        </div>
        <% } %>
        <% if (order.shippingAddress) { %>
        <div class="col-span-2">
          <p class="text-gray-400 text-xs mb-0.5">Deliver to</p>
          <p class="font-semibold text-gray-800 leading-snug">
            <%= order.shippingAddress.addressLine || '' %>
            <%= order.shippingAddress.street ? ', ' + order.shippingAddress.street : '' %>,
            <%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %>
          </p>
        </div>
        <% } %>
      </div>
    </div>

    <%# ── Ordered Items ── %>
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 mb-6">
      <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-widest mb-4">
        Items Ordered <span class="text-gray-300">(<%= order.items.length %>)</span>
      </h2>
      <ul class="divide-y divide-gray-50">
        <% order.items.forEach(item => { %>
        <li class="flex items-center gap-4 py-4 first:pt-0 last:pb-0">

          <div class="w-14 h-14 rounded-xl border border-gray-100 bg-gray-50 flex-shrink-0 overflow-hidden">
            <% if (item.productImage) { %>
              <img src="<%= item.productImage %>" alt="<%= item.productName %>" class="w-full h-full object-cover" />
            <% } else { %>
              <div class="w-full h-full flex items-center justify-center text-gray-300">
                <i class="bi bi-box text-2xl"></i>
              </div>
            <% } %>
          </div>

          <div class="flex-1 min-w-0">
            <p class="font-semibold text-gray-800 truncate text-sm">
              <% if (item.productId && item.productId.brandName) { %>
                <span class="text-[9px] font-bold text-red-500 uppercase tracking-widest block mb-0.5"><%= item.productId.brandName %></span>
              <% } %>
              <%= item.productName || 'Product' %>
            </p>
            <% 
              const attributes = (item.variantAttributes && Object.keys(item.variantAttributes).length > 0)
                ? item.variantAttributes
                : (item.variantId && item.variantId.options ? item.variantId.options : null);
            %>
            <% if (attributes) { %>
              <p class="text-xs text-gray-400 mt-0.5">
                <%= Object.entries(attributes).map(([k,v]) => `${k}: ${v}`).join(' · ') %>
              </p>
            <% } %>
            <p class="text-xs text-gray-400 mt-0.5">Qty: <%= item.quantity %></p>
          </div>

          <div class="text-right flex-shrink-0">
            <p class="font-bold text-gray-900 text-sm">₹<%= (item.unitPrice * item.quantity).toLocaleString('en-IN') %></p>
            <p class="text-xs text-gray-400">₹<%= item.unitPrice.toLocaleString('en-IN') %> each</p>
          </div>

        </li>
        <% }) %>
      </ul>

      <%# ── Price Breakdown ── %>
      <div class="mt-4 pt-4 border-t border-gray-100 space-y-2 text-sm">
        <% if (order.subtotal && order.subtotal !== order.totalAmount) { %>
        <div class="flex justify-between text-gray-500">
          <span>Subtotal</span>
          <span>₹<%= order.subtotal.toLocaleString('en-IN') %></span>
        </div>
        <% } %>
        <% if (order.discount > 0) { %>
        <div class="flex justify-between text-gray-500">
          <span>Discount<% if (order.couponCode) { %> (<%= order.couponCode %>)<% } %></span>
          <span class="text-green-600 font-medium">- ₹<%= order.discount.toLocaleString('en-IN') %></span>
        </div>
        <% } %>
        <div class="flex justify-between text-gray-500">
          <span>Shipping</span>
          <span class="text-green-600 font-medium">Free</span>
        </div>
        <div class="flex justify-between font-bold text-gray-900 text-base pt-2 border-t border-gray-100">
          <span>Total Paid</span>
          <span>₹<%= order.totalAmount.toLocaleString('en-IN') %></span>
        </div>
      </div>
    </div>

    <% } %>

    <%# ── CTA Buttons ── %>
    <div class="flex flex-col sm:flex-row gap-3">
      <a href="/user/orders" class="flex-1 bg-gray-900 text-white font-bold px-8 py-4 rounded-xl hover:bg-black transition-all shadow-md text-center active:scale-95">
        <i class="bi bi-bag-check mr-2"></i>View My Orders
      </a>
      <a href="/user/home" class="flex-1 bg-white border border-gray-200 text-gray-700 font-bold px-8 py-4 rounded-xl hover:bg-gray-50 transition-all text-center active:scale-95">
        <i class="bi bi-arrow-left mr-2"></i>Continue Shopping
      </a>
    </div>

  </main>
  <%- include('../partials/footer') %>
</body>
</html>