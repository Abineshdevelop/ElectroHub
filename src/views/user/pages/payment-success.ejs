<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment Successful - ElectroHub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 text-gray-800">
  <%- include('../partials/navbar', { user }) %>

  <main class="max-w-4xl mx-auto px-4 py-20 text-center">
    <div class="mb-8 flex justify-center">
      <div class="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center text-green-600 shadow-sm border border-green-200">
        <i class="bi bi-check-circle-fill text-5xl"></i>
      </div>
    </div>

    <h1 class="text-4xl font-extrabold text-gray-900 mb-4 tracking-tight">Payment Successful</h1>
    <p class="text-lg text-gray-600 mb-12 max-w-md mx-auto leading-relaxed">
      Thank you for your purchase! We've received your payment of <br>
      <span class="text-2xl font-black text-gray-900 mt-2 block">₹<%= amount ? amount.toLocaleString('en-IN') : '0' %></span>
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/user/orders" class="w-full sm:w-auto bg-gray-900 text-white font-bold px-10 py-4 rounded-xl hover:bg-black transition-all shadow-lg active:scale-95">
        Go to My Orders
      </a>
      <a href="/user/home" class="w-full sm:w-auto bg-white border border-gray-200 text-gray-700 font-bold px-10 py-4 rounded-xl hover:bg-gray-50 transition-all active:scale-95">
        Continue Shopping
      </a>
    </div>
  </main>

  <%- include('../partials/layout-scripts') %>
</body>
</html>
