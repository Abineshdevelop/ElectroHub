<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exclusive Coupons - ElectroHub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .coupon-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .coupon-card:hover { transform: translateY(-5px); }
        .dashed-line { background-image: linear-gradient(to right, #e5e7eb 50%, transparent 50%); background-size: 10px 1px; background-repeat: repeat-x; }
        .copy-feedback { display: none; }
        .copy-feedback.show { display: inline-flex; animation: fadeInOut 2s forwards; }
        @keyframes fadeInOut {
            0% { opacity: 0; transform: translateY(5px); }
            15% { opacity: 1; transform: translateY(0); }
            85% { opacity: 1; transform: translateY(0); }
            100% { opacity: 0; transform: translateY(-5px); }
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800">
    <%- include('../partials/navbar', { user }) %>

    <div class="flex min-h-[calc(100vh-64px)]">
        <%- include('../partials/sidebar', { user, activePage: 'coupons' }) %>

        <main class="flex-1 px-4 md:px-8 py-6 md:py-8 overflow-x-hidden">
            <!-- Hero Section -->
            <div class="text-center mb-16">
                <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4 tracking-tight">Available Offers</h1>
                <p class="text-lg text-gray-500 max-w-2xl mx-auto">Discover the latest coupons and deals exclusively for ElectroHub shoppers. Save more on your next tech upgrade!</p>
            </div>

            <% if (coupons && coupons.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3 gap-8">
                    <% coupons.forEach(coupon => { %>
                        <div class="coupon-card bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden flex flex-col hover:shadow-xl hover:border-red-100 relative group">
                            
                            <!-- Top Detail Section -->
                            <div class="p-8 pb-6 flex-grow">
                                <div class="flex justify-between items-start mb-6">
                                    <div class="w-14 h-14 bg-red-50 text-red-500 rounded-2xl flex items-center justify-center text-2xl">
                                        <i class="bi bi-ticket-perforation-fill"></i>
                                    </div>
                                    <div class="text-right">
                                        <span class="text-xs font-bold text-gray-400 uppercase tracking-widest block mb-1">Expires On</span>
                                        <span class="text-sm font-semibold text-gray-700">
                                            <%= new Date(coupon.endDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                        </span>
                                    </div>
                                </div>

                                <div class="mb-6">
                                    <h2 class="text-3xl font-black text-gray-900 leading-tight mb-2">
                                        <% if (coupon.discountType === 'flat') { %>
                                            &#8377;<%= coupon.discountValue.toLocaleString('en-IN') %> <span class="text-lg font-bold text-gray-400 uppercase tracking-tight">OFF</span>
                                        <% } else { %>
                                            <%= coupon.discountValue %>% <span class="text-lg font-bold text-gray-400 uppercase tracking-tight">OFF</span>
                                        <% } %>
                                    </h2>
                                    <p class="text-sm font-medium text-gray-500 uppercase tracking-wide">
                                        <%= coupon.discountType === 'flat' ? 'Fixed flat discount on purchase' : 'On your entire purchase' %>
                                    </p>
                                </div>

                                <div class="space-y-3 pt-2 border-t border-gray-100">
                                    <div class="flex justify-between items-center text-sm">
                                        <span class="text-gray-400">Min. Purchase</span>
                                        <span class="font-bold text-gray-900">&#8377;<%= coupon.minPurchaseAmount.toLocaleString('en-IN') %></span>
                                    </div>
                                    <% if (coupon.discountType === 'percentage') { %>
                                    <div class="flex justify-between items-center text-sm">
                                        <span class="text-gray-400">Max Discount</span>
                                        <span class="font-bold text-gray-900">&#8377;<%= coupon.maxDiscountAmount.toLocaleString('en-IN') %></span>
                                    </div>
                                    <% } else { %>
                                    <div class="flex justify-between items-center text-sm">
                                        <span class="text-gray-400">Discount Type</span>
                                        <span class="font-bold text-green-600 flex items-center gap-1">
                                            <i class="bi bi-tag-fill text-xs"></i> Flat Amount
                                        </span>
                                    </div>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Dashed Divider -->
                            <div class="relative px-8 h-1 flex items-center">
                                <div class="dashed-line w-full"></div>
                                <div class="absolute -left-3 w-6 h-6 bg-gray-50 rounded-full border-r border-gray-100"></div>
                                <div class="absolute -right-3 w-6 h-6 bg-gray-50 rounded-full border-l border-gray-100"></div>
                            </div>

                            <!-- Bottom Copy Section -->
                            <div class="p-8 pt-6 bg-gray-50/50">
                                <div class="flex items-center gap-3 bg-white border border-dashed border-gray-300 rounded-2xl p-4 transition-all group-hover:border-red-300 group-hover:bg-red-50/50">
                                    <span class="text-lg font-mono font-extrabold text-gray-900 tracking-wider flex-grow text-center"><%= coupon.code %></span>
                                    <button onclick="copyCouponCode('<%= coupon.code %>', this)" class="w-12 h-12 bg-gray-900 text-white rounded-xl flex items-center justify-center hover:bg-black transition-all active:scale-90 relative">
                                        <i class="bi bi-files text-lg"></i>
                                        <span class="copy-feedback absolute -top-12 bg-gray-900 text-white text-[10px] px-2 py-1 rounded shadow-lg whitespace-nowrap">Copied!</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="max-w-md mx-auto text-center py-20">
                    <div class="w-20 h-20 bg-gray-100 text-gray-300 rounded-full flex items-center justify-center mx-auto mb-6">
                        <i class="bi bi-ticket-slash text-4xl"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-2">No Active Coupons</h3>
                    <p class="text-gray-500 mb-8">We don't have any coupons available at the moment. Check back later!</p>
                    <a href="/user/home" class="inline-flex items-center gap-2 bg-red-500 text-white font-bold px-8 py-3 rounded-xl hover:bg-red-600 transition shadow-lg active:scale-95">
                        Continue Shopping <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            <% } %>
        </main>
    </div>
<script>
        async function copyCouponCode(code, btn) {
            try {
                await navigator.clipboard.writeText(code);
                const feedback = btn.querySelector('.copy-feedback');
                feedback.classList.add('show');
                setTimeout(() => feedback.classList.remove('show'), 2000);
            } catch (err) {
                console.error('Failed to copy code:', err);
                alert('Could not copy code. Please copy manually: ' + code);
            }
        }
    </script>
  <%- include('../partials/footer') %>
</body>
</html>
