<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Details - ElectroHub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }

    #toast-container {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      gap: 10px;
      pointer-events: none;
    }

    .toast {
      min-width: 260px;
      max-width: 340px;
      padding: 13px 16px;
      border-radius: 12px;
      font-size: 13.5px;
      font-weight: 500;
      color: #fff;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.13);
      display: flex;
      align-items: center;
      gap: 10px;
      animation: toastIn 0.3s ease, toastOut .4s ease 2.6s forwards;
    }

    .toast.success { background: #22c55e; }
    .toast.error   { background: #ef4444; }
    .toast.warn    { background: #f59e0b; }

    @keyframes toastIn {
      from { transform: translateX(110%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    @keyframes toastOut {
      from { opacity: 1; }
      to { opacity: 0; transform: translateX(110%); }
    }

    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: 0.25s;
      z-index: 1000;
      padding: 16px;
    }

    .modal-overlay.show {
      opacity: 1;
      pointer-events: all;
    }

    .modal-box {
      background: #fff;
      border-radius: 20px;
      padding: 24px;
      width: 100%;
      max-width: 440px;
      position: relative;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }
  </style>
</head>

<body class="bg-gray-50 text-gray-800">
  <div id="toast-container"></div>
  <%- include('../partials/navbar', { user }) %>

    <div class="flex min-h-[calc(100vh-64px)]">
      <%- include('../partials/sidebar', { user, activePage: 'orders' }) %>

        <main class="flex-1 px-4 md:px-8 py-6 overflow-x-hidden">
          <!-- Breadcrumb -->
          <nav class="text-sm text-gray-400 mb-5">
            <a href="/user/home" class="hover:text-red-500">Home</a>
            <span class="mx-2">/</span>
            <a href="/user/orders" class="hover:text-red-500">Orders</a>
            <span class="mx-2">/</span>
            <span class="text-gray-700 font-medium tracking-tight">Order Details</span>
          </nav>

          <div class="flex items-center justify-between mb-6">
            <div>
              <h2 class="text-2xl font-bold">Order Details</h2>
              <p class="text-sm text-gray-400">Order ID: <span class="font-mono text-gray-600">#<%= order.orderId %>
                    </span></p>
            </div>
            <div class="flex items-center gap-3">
              <div class="text-right">
                <p class="text-[10px] uppercase font-bold text-gray-400 tracking-widest">Ordered On</p>
                <p class="text-sm font-semibold text-gray-700">
                  <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </p>
              </div>
            </div>
          </div>

            <% 
              const isFailed = order.paymentStatus === 'failed';
              const steps = ['confirmed', 'shipped', 'out_for_delivery', 'delivered'];
              const statusConfig = {
                pending: { label: 'Pending', icon: 'bi-hourglass-split', color: 'gray' },
                confirmed: { label: 'Confirmed', icon: 'bi-check-circle', color: 'blue' },
                shipped: { label: 'Shipped', icon: 'bi-truck', color: 'indigo' },
                out_for_delivery: { label: 'Out for Delivery', icon: 'bi-geo', color: 'sky' },
                delivered: { label: 'Delivered', icon: 'bi-house-check', color: 'green' },
                cancelled: { label: 'Cancelled', icon: 'bi-x-circle', color: 'red' },
                partially_cancelled: { label: 'Partially Cancelled', icon: 'bi-exclamation-circle', color: 'orange' },
                return_requested: { label: 'Return Requested', icon: 'bi-arrow-return-left', color: 'purple' },
                returned: { label: 'Returned', icon: 'bi-arrow-return-left', color: 'orange' },
                return_rejected: { label: 'Return Rejected', icon: 'bi-x-circle', color: 'red' }
              };
            %>

            <!-- Payment Cancelled Alert -->
            <% if (isFailed) { %>
              <div
                class="bg-red-50 border border-red-100 rounded-xl p-5 mb-8 flex flex-col md:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-red-500 rounded-full flex items-center justify-center text-white shrink-0">
                    <i class="bi bi-shield-x text-xl"></i>
                  </div>
                  <div>
                    <h4 class="font-bold text-red-900">Payment Cancelled</h4>
                    <p class="text-xs text-red-600 font-medium">Your last payment attempt failed or was cancelled.
                      Please retry to confirm your order.</p>
                  </div>
                </div>
                <button onclick="retryPayment('<%= order._id %>')" id="retryBtn"
                  class="w-full md:w-auto px-6 py-2.5 bg-red-600 text-white font-bold rounded-lg hover:bg-red-700 transition-all flex items-center justify-center gap-2 text-sm shadow-sm shadow-red-100 active:scale-95">
                  <i class="bi bi-arrow-repeat"></i> Retry Payment
                </button>
              </div>
              <% } %>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

                  <!-- Left: Status & Items -->
                  <div class="lg:col-span-2 space-y-6">

                    <!-- Items List -->
                    <div class="bg-white border rounded-2xl shadow-sm overflow-hidden">
                      <div class="px-6 py-4 border-b bg-gray-50/50 flex justify-between items-center">
                        <h3 class="font-bold text-gray-900">Order Items (<%= order.items.length %>)</h3>
                      </div>
                      <div class="divide-y">
                        <% order.items.forEach((item) => {
                          const itemStatus = (item.status && item.status !== 'pending') ? item.status : order.orderStatus;
                          const iCfg = statusConfig[itemStatus] || { label: itemStatus, icon: 'bi-circle', color: 'gray' };
                          const itemCurrentIdx = steps.indexOf(itemStatus);
                          const showItemTracker = !['cancelled', 'returned', 'return_requested', 'return_rejected'].includes(itemStatus);
                          const itemSafety = (typeof itemCancellationSafety !== 'undefined' && itemCancellationSafety[String(item._id)]) || { allowed: true };
                          // Can only return if delivered; not if already return_requested or returned
                          const baseCanCancel = ['confirmed', 'shipped'].includes(itemStatus);
                          const canCancel = baseCanCancel;
                          const itemCancelBlocked = baseCanCancel && itemSafety.allowed === false;
                          const baseCanReturn = itemStatus === 'delivered';
                          const canReturn = baseCanReturn && itemSafety.allowed;
                          const isPendingReturn = itemStatus === 'return_requested';
                          %>
                          <div class="p-6 hover:bg-gray-50/30 transition-colors">
                            <div class="flex flex-col sm:flex-row gap-5">
                              <div class="w-24 h-24 bg-white border rounded-xl overflow-hidden shrink-0 flex items-center justify-center p-2">
                                <img src="<%= item.productImage %>" alt="<%= item.productName %>"
                                  class="max-w-full max-h-full w-auto h-auto object-contain"
                                  onerror="this.style.display='none';this.parentElement.innerHTML='<i class=\'bi bi-image text-gray-300 text-2xl\'></i>'">
                              </div>
                              <div class="flex-1">
                                <div class="flex justify-between items-start mb-2">
                                  <h4 class="font-bold text-gray-900">
                                    <% if (item.productId && item.productId.brandName) { %>
                                      <span class="text-[10px] font-bold text-red-500 uppercase tracking-widest block mb-0.5"><%= item.productId.brandName %></span>
                                    <% } %>
                                    <%= item.productName %>
                                  </h4>
                                  <p class="font-bold text-gray-900">₹<%= (item.finalAmount ?? item.lineTotal ?? 0).toLocaleString('en-IN') %></p>
                                </div>
                                <div class="flex flex-wrap gap-4 text-xs text-gray-500 mb-3">
                                  <span>Quantity: <b class="text-gray-700">
                                      <%= item.quantity %>
                                    </b></span>
                                  <% 
                                    const attributes = (item.variantAttributes && Object.keys(item.variantAttributes).length > 0)
                                      ? item.variantAttributes
                                      : (item.variantId && item.variantId.options ? item.variantId.options : null);
                                  %>
                                  <% if (attributes) { %>
                                    <% Object.entries(attributes).forEach(([k, v]) => { %>
                                      <span>
                                        <%= k %>: <b class="text-gray-700 capitalize"><%= v %></b>
                                      </span>
                                    <% }) %>
                                  <% } %>
                                          <span
                                            class="inline-flex items-center px-2.5 py-1 rounded bg-<%= iCfg.color %>-600 text-white font-bold uppercase text-[10px] tracking-widest shadow-sm">
                                            <%= iCfg.label %>
                                          </span>
                                </div>

                                <% if (showItemTracker) { %>
                                  <div class="mt-4 mb-3 rounded-xl border border-gray-100 bg-gray-50/60 px-4 py-4">
                                    <h5 class="mb-4 flex items-center gap-2 text-[11px] font-black uppercase tracking-widest text-gray-700">
                                      <i class="bi bi-truck text-indigo-600"></i>
                                      Delivery Updates
                                    </h5>
                                    <div class="relative px-1 pb-1 pt-1">
                                      <div class="absolute left-1 top-5 h-1 w-[calc(100%-8px)] rounded-full bg-gray-200">
                                        <div class="h-full rounded-full bg-green-500 shadow-sm transition-all duration-700"
                                          style="width: <%= itemCurrentIdx >= 0 ? Math.max(0, (itemCurrentIdx / (steps.length - 1)) * 100) : 0 %>%"></div>
                                      </div>
                                      <div class="relative flex justify-between">
                                        <% steps.forEach((st, idx) => {
                                          const isDone = itemCurrentIdx >= 0 && idx <= itemCurrentIdx;
                                          const isActive = idx === itemCurrentIdx;
                                        %>
                                          <div class="flex min-w-0 flex-1 flex-col items-center">
                                            <div
                                              class="relative z-10 flex h-8 w-8 items-center justify-center rounded-full text-sm transition-all duration-500 <%= isActive ? 'bg-blue-600 text-white ring-4 ring-blue-50' : isDone ? 'bg-green-500 text-white' : 'border border-gray-200 bg-gray-100 text-gray-400' %>">
                                              <i class="bi <%= isDone && !isActive ? 'bi-check-lg' : statusConfig[st].icon %>"></i>
                                            </div>
                                            <span
                                              class="mt-2 text-center text-[9px] font-black uppercase leading-tight tracking-wider <%= isDone ? 'text-gray-900' : 'text-gray-400' %>">
                                              <%= statusConfig[st].label %>
                                            </span>
                                          </div>
                                        <% }) %>
                                      </div>
                                    </div>
                                  </div>
                                <% } %>

                                <% if (baseCanReturn && !canReturn) { %>
                                  <div class="mb-3 flex items-start gap-2 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-semibold text-amber-800">
                                    <i class="bi bi-exclamation-triangle-fill mt-0.5 shrink-0"></i>
                                    <span>
                                      Partial return is not allowed because your remaining order value will fall below the coupon minimum purchase requirement.
                                    </span>
                                  </div>
                                <% } %>

                                <%# Return rejection notice %>
                                <% if (item.returnRejectionReason) { %>
                                  <div class="mb-3 flex items-start gap-2 bg-red-50 border border-red-100 rounded-lg px-3 py-2 text-xs font-medium text-red-700">
                                    <i class="bi bi-x-circle-fill mt-0.5 shrink-0"></i>
                                    <span><b>Return rejected:</b> <%= item.returnRejectionReason %></span>
                                  </div>
                                <% } %>
                                
                                <% if (itemStatus === 'out_for_delivery') { %>
                                  <div class="mb-3 flex items-start gap-2 bg-red-50 border border-red-100 rounded-lg px-3 py-2 text-xs font-medium text-red-700">
                                    <i class="bi bi-exclamation-triangle-fill mt-0.5 shrink-0"></i>
                                    <span>Item cannot be cancelled it is out for delivery</span>
                                  </div>
                                <% } %>



                                <div class="flex flex-col gap-2 mt-3 w-full">
                                  <div class="flex justify-end gap-3">
                                    <% if (canCancel) { %>
                                      <button
                                        onclick="toggleInlineCancel('<%= item._id %>')"
                                        class="text-[10px] font-black uppercase tracking-widest text-red-500 hover:text-red-700 px-3 py-1.5 border border-red-200 rounded-lg bg-red-50/50 transition">
                                        <i class="bi bi-x-circle"></i> Cancel Item
                                      </button>
                                    <% } if (itemStatus === 'delivered') { %>
                                      <a href="/user/orders/<%= order._id %>/items/<%= item._id %>/invoice"
                                        class="text-sm font-medium text-blue-600 hover:text-blue-700 px-4 py-1.5 border border-blue-500 hover:border-blue-600 rounded bg-white transition inline-flex items-center gap-1.5">
                                        <i class="bi bi-file-earmark-arrow-down"></i> Download invoice
                                      </a>
                                    <% } if (canReturn) { %>
                                      <button
                                        onclick="toggleInlineReturn('<%= item._id %>')"
                                        class="text-xs font-black uppercase tracking-widest text-white bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg shadow-sm transition active:scale-95 flex items-center gap-1.5">
                                        <i class="bi bi-box-arrow-left"></i> Request Return
                                      </button>
                                    <% } %>
                                  </div>
                                  <% if (canCancel) { %>
                                    <div id="inline-cancel-<%= item._id %>" class="hidden w-full bg-red-50/60 border border-red-100 rounded-xl p-4 text-left mt-1">
                                       <% if (itemCancelBlocked) { %>
                                         <div class="mb-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-semibold text-amber-800">
                                           <%= itemSafety.message || 'Cancelling these items may affect your coupon eligibility.' %>
                                           <% if (cancellationSafety && cancellationSafety.minPurchaseAmount > 0) { %>
                                             Maximum cancellable value: ₹<%= cancellationSafety.maxCancellableAmount.toLocaleString('en-IN') %>
                                           <% } %>
                                         </div>
                                       <% } else { %>
                                         <% if (order.couponCode && order.couponStatus !== 'removed') { %>
                                           <div class="mb-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-semibold text-amber-800">
                                             Cancelling these items may affect your coupon eligibility.
                                             <% if (cancellationSafety && cancellationSafety.minPurchaseAmount > 0) { %>
                                               Maximum cancellable value: ₹<%= cancellationSafety.maxCancellableAmount.toLocaleString('en-IN') %>
                                             <% } %>
                                           </div>
                                         <% } %>
                                         <label class="block text-[10px] font-black text-red-800 uppercase tracking-widest mb-1.5">Why are you cancelling this item?</label>
                                         <textarea id="cancel-reason-<%= item._id %>" rows="3" class="w-full text-sm p-3 border border-red-200 rounded-lg outline-none focus:ring-2 focus:ring-red-200 mb-3 resize-none" placeholder="Share your reason for cancellation..."></textarea>
                                         <div class="flex gap-2">
                                           <button onclick="toggleInlineCancel('<%= item._id %>')" class="flex-1 py-2.5 text-xs font-bold text-gray-500 hover:text-gray-700 border border-gray-200 rounded-lg bg-white transition">Dismiss</button>
                                           <button onclick="submitInlineCancel('<%= item._id %>')" class="flex-1 py-2.5 text-xs font-bold text-white bg-red-600 hover:bg-red-700 rounded-lg shadow-sm transition active:scale-95">Confirm Cancel</button>
                                         </div>
                                       <% } %>
                                    </div>
                                  <% } %>
                                  <% if (canReturn) { %>
                                    <div id="inline-return-<%= item._id %>" class="hidden w-full bg-blue-50/60 border border-blue-100 rounded-xl p-4 text-left mt-1">
                                       <label class="block text-[10px] font-black text-blue-800 uppercase tracking-widest mb-1.5">Why are you returning this item?</label>
                                       <textarea id="reason-<%= item._id %>" rows="3" class="w-full text-sm p-3 border border-blue-200 rounded-lg outline-none focus:ring-2 focus:ring-blue-200 mb-3 resize-none" placeholder="Describe the issue (damaged, wrong item, etc.)..."></textarea>
                                       <div class="flex gap-2">
                                         <button onclick="toggleInlineReturn('<%= item._id %>')" class="flex-1 py-2.5 text-xs font-bold text-gray-500 hover:text-gray-700 border border-gray-200 rounded-lg bg-white transition">Dismiss</button>
                                         <button onclick="submitInlineReturn('<%= item._id %>')" class="flex-1 py-2.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition active:scale-95">Confirm Return</button>
                                       </div>
                                    </div>
                                  <% } %>
                                </div>

                              </div>
                            </div>
                          </div>
                          <% }) %>

                      </div>
                    </div>
                  </div>

                  <!-- Right: Summary & Address -->
                  <div class="space-y-6">

                    <!-- Summary Card -->
                    <div class="bg-white border rounded-2xl p-6 shadow-sm">
                      <h3 class="font-bold text-gray-900 mb-5 border-b pb-3">Payment Summary</h3>
                      <div class="space-y-3 text-sm">
                        <div class="flex justify-between text-gray-500 font-medium">
                          <span>Subtotal</span>
                          <span class="text-gray-900 font-semibold">₹<%= order.subtotal.toLocaleString('en-IN') %>
                              </span>
                        </div>
                        <% if (order.discount> 0) { %>
                          <div class="flex justify-between text-gray-500 font-medium">
                            <span>Discount</span>
                            <span class="text-green-600 font-semibold">- ₹<%= order.discount.toLocaleString('en-IN') %>
                                </span>
                          </div>
                          <% } %>
                            <div class="flex justify-between text-gray-500 font-medium border-b border-dashed pb-3">
                              <span>Shipping</span>
                              <span class="text-green-600 font-bold uppercase text-[10px] tracking-widest">Free</span>
                            </div>
                            <div class="flex justify-between pt-1">
                              <span class="text-lg font-bold text-gray-900">Total Paid</span>
                              <span class="text-xl font-black text-red-600">₹<%= order.totalAmount.toLocaleString('en-IN') %></span>
                            </div>
                            <div class="mt-6 pt-5 border-t space-y-1">
                              <% if (order.couponCode) { %>
                                <div class="flex justify-between items-center mb-2 p-2 rounded-lg bg-gray-50 border border-dashed border-gray-200">
                                  <div class="flex flex-col">
                                    <span class="text-[10px] uppercase font-bold text-gray-400 tracking-widest">Coupon Status</span>
                                    <span class="text-xs font-bold <%= order.couponStatus === 'removed' ? 'text-red-500' : 'text-blue-600' %>">
                                      <% if (order.couponStatus === 'removed') { %>
                                        Removed (Min-purchase not met)
                                      <% } else if (order.couponStatus === 'adjusted') { %>
                                        Adjusted (<%= order.couponCode %>)
                                      <% } else { %>
                                        Applied (<%= order.couponCode %>)
                                      <% } %>
                                    </span>
                                  </div>
                                  <span class="text-sm font-bold <%= order.couponStatus === 'removed' ? 'text-red-500' : 'text-blue-600' %>">
                                    <% if (order.couponStatus === 'removed') { %>
                                      <span class="line-through text-gray-400">₹0</span>
                                    <% } else { %>
                                      - ₹<%= order.discount.toLocaleString('en-IN') %>
                                    <% } %>
                                  </span>
                                </div>
                              <% } %>
                              <div class="flex justify-between items-center">
                                <span class="text-[10px] uppercase font-bold text-gray-400 tracking-widest">Payment
                                  Method</span>
                                <span class="text-xs font-bold text-gray-700 capitalize">
                                  <%= order.paymentMethod.replace(/_/g, ' ' ) %>
                                </span>
                              </div>
                              <div class="flex justify-between items-center pt-2">
                                <span class="text-[10px] uppercase font-bold text-gray-400 tracking-widest">Payment
                                  Status</span>
                                <span
                                  class="text-[10px] font-bold px-2.5 py-1 rounded bg-<%= isFailed ? 'red' : (order.paymentStatus==='paid'||order.paymentStatus==='adjusted') ? 'green' : 'gray' %>-600 text-white shadow-sm uppercase tracking-widest">
                                  <%= order.paymentStatus %>
                                </span>
                              </div>
                              <%
                                const getItemStatus = (item) => (item.status && item.status !== 'pending') ? item.status : order.orderStatus;
                                const activeOrderItems = order.items.filter(i => !['cancelled','returned'].includes(getItemStatus(i)));
                                const cancellableItems = activeOrderItems.filter(i => ['confirmed', 'shipped'].includes(getItemStatus(i)));
                                const allItemsDelivered = activeOrderItems.length > 0 && activeOrderItems.every(i => getItemStatus(i) === 'delivered');
                                const showCancelRemaining = cancellableItems.length > 0 && !allItemsDelivered;
                              %>
                              <% if (showCancelRemaining) { %>
                                <div class="mt-5 pt-5 border-t">
                                  <button onclick="toggleInlineCancel('full')"
                                    class="w-full py-2.5 bg-white border border-red-200 text-red-600 font-bold rounded-xl hover:bg-red-50 transition-all text-xs shadow-sm active:scale-95 flex items-center justify-center gap-2">
                                    <i class="bi bi-x-circle"></i> Cancel Remaining Items
                                  </button>
                                  <div id="inline-cancel-full" class="hidden mt-3 p-4 bg-red-50/50 border border-red-100 rounded-xl">
                                      <label class="block text-[10px] font-black text-red-800 uppercase tracking-widest mb-1.5">Reason for cancelling items?</label>
                                      <textarea id="cancel-reason-full" rows="3" class="w-full text-sm p-3 border border-red-200 rounded-lg outline-none focus:ring-2 focus:ring-red-200 mb-3 resize-none" placeholder="Describe the issue..."></textarea>
                                      <div id="cancel-error-full" class="hidden mt-2 text-sm text-red-600 font-semibold mb-2"></div>
                                      <div class="flex gap-2">
                                        <button onclick="toggleInlineCancel('full')" class="flex-1 py-2.5 text-xs font-bold text-gray-500 hover:text-gray-700 border border-gray-200 rounded-lg bg-white transition">Dismiss</button>
                                        <button onclick="submitInlineCancel('full')" class="flex-1 py-2.5 text-xs font-bold text-white bg-red-600 hover:bg-red-700 rounded-lg shadow-sm transition active:scale-95">Confirm Cancel</button>
                                      </div>
                                  </div>
                                </div>
                              <% } %>
                            </div>
                            <% const isReturnPending = order.orderStatus === 'return_requested'; %>
                      </div>
                    </div>

                    <!-- Address Card -->
                    <div class="bg-white border rounded-2xl p-6 shadow-sm">
                      <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2"><i
                          class="bi bi-geo-alt text-red-600"></i> Delivery Address</h3>
                      <div class="text-sm font-medium text-gray-600 space-y-1">
                        <p class="font-bold text-gray-900">
                          <%= order.shippingAddress.firstName %>
                            <%= order.shippingAddress.lastName %>
                        </p>
                        <p>
                          <%= order.shippingAddress.addressLine %>, <%= order.shippingAddress.street %>
                        </p>
                        <p>
                          <%= order.shippingAddress.state %>, <%= order.shippingAddress.country %>
                        </p>
                        <p class="font-bold text-gray-900 pt-1">PIN: <%= order.shippingAddress.pincode %>
                        </p>
                        <p class="pt-2 text-xs text-gray-400 italic">Contact: <%= order.shippingAddress.phone %>
                        </p>
                      </div>
                    </div>

                  </div>
                </div>
        </main>
    </div>

    <!-- STOCK ERROR MODAL -->
    <div id="stockErrorModal" class="modal-overlay">
      <div class="modal-box text-center" style="max-width:400px; padding: 2.5rem 2rem;">
        <div class="w-20 h-20 bg-amber-100 text-amber-500 rounded-full flex items-center justify-center mx-auto mb-5">
          <i class="bi bi-exclamation-triangle-fill text-4xl"></i>
        </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Stock Unavailable</h3>
          <p class="text-gray-500 mb-6 font-medium text-sm px-2">Some items in this order are currently out of stock. You cannot re-pay for this order at this moment.</p>
          <button onclick="document.getElementById('stockErrorModal').classList.remove('show')"
            class="block w-full py-3.5 px-4 bg-gray-900 hover:bg-black text-white font-bold rounded-xl transition shadow-sm text-center">
            Close
          </button>
      </div>
    </div>

    <!-- RETRY CHOICE MODAL -->
    <div id="retryModal" class="modal-overlay">
      <div class="modal-box text-center" style="max-width:400px; padding: 2rem;">
        <h3 class="text-xl font-bold text-gray-900 mb-4">Select Payment Method</h3>
        <div class="mb-6 bg-gray-50 border border-gray-100 rounded-xl p-4 text-left">
          <div class="flex justify-between text-sm mb-1">
            <span class="text-gray-500 font-medium">Order Total:</span>
            <span class="text-gray-900 font-bold" id="retryOrderAmount">₹0.00</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-gray-500 font-medium">Wallet Balance:</span>
            <span class="text-gray-900 font-bold" id="retryWalletBalance">₹0.00</span>
          </div>
        </div>
        <p class="text-xs text-gray-500 mb-6 font-medium">Choose how you'd like to pay for this order retry.</p>
        <div class="flex flex-col gap-3">
          <button id="retryWalletBtn" onclick="executeRetry('wallet')"
            class="w-full py-3 px-4 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl transition shadow-sm text-sm flex items-center justify-center gap-2 disabled:opacity-50 disabled:grayscale">
            <i class="bi bi-wallet2"></i> Pay with Wallet
          </button>
          <button onclick="executeRetry('razorpay')"
            class="w-full py-3 px-4 border border-gray-200 text-gray-700 font-bold rounded-xl hover:bg-gray-50 transition text-sm flex items-center justify-center gap-2">
            <i class="bi bi-credit-card"></i> Pay Online (Razorpay)
          </button>
          <button onclick="document.getElementById('retryModal').classList.remove('show')"
            class="w-full py-2 px-4 text-gray-400 font-semibold hover:text-gray-600 transition text-xs mt-2 underline">
            Cancel
          </button>
        </div>
      </div>
    </div>

    <!-- PAYMENT CANCELLATION MODAL -->
    <div id="paymentErrorModal" class="modal-overlay text-center">
      <div class="modal-box" style="max-width:400px; padding: 2.5rem 2rem;">
        <div class="w-16 h-16 bg-red-100 text-red-500 rounded-full flex items-center justify-center mx-auto mb-5">
          <i class="bi bi-x-circle-fill text-3xl"></i>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">Payment Cancelled</h3>
        <p class="text-sm text-gray-500 mb-8 font-medium">Your payment attempt was cancelled. Would you like to try again or stay on this page?</p>
        <div class="flex flex-col gap-3">
          <button onclick="reopenRazorpay()" 
            class="w-full py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl transition shadow-md active:scale-95 text-sm">
            Retry Payment
          </button>
          <button onclick="document.getElementById('paymentErrorModal').classList.remove('show')"
            class="w-full py-3 border border-gray-200 text-gray-500 font-bold rounded-xl hover:bg-gray-50 transition text-sm">
            Cancel & Stay Here
          </button>
        </div>
      </div>
    </div>

    <script>
      const ORDER_ID = '<%= order._id %>';
      let lastRazorpayData = null;

      function showToast(msg, type = 'success') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = `toast ${type}`;
        toast.innerHTML = `<i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'}"></i><span>${msg}</span>`;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 3500);
      }

      async function retryPayment(orderId) {
        // Show modal immediately with loading state
        document.getElementById('retryOrderAmount').innerText = 'Loading...';
        document.getElementById('retryWalletBalance').innerText = 'Loading...';
        document.getElementById('retryWalletBtn').disabled = true;
        document.getElementById('retryModal').classList.add('show');

        try {
          const res = await fetch('/user/checkout/retry-payment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId: ORDER_ID })
          });
          const data = await res.json();

          if (data.success && data.infoOnly) {
            document.getElementById('retryOrderAmount').innerText = `₹${data.totalAmount.toLocaleString('en-IN')}`;
            document.getElementById('retryWalletBalance').innerText = `₹${data.walletBalance.toLocaleString('en-IN')}`;
            
            if (data.walletBalance < data.totalAmount) {
              document.getElementById('retryWalletBtn').disabled = true;
              document.getElementById('retryWalletBtn').classList.add('opacity-50');
            } else {
              document.getElementById('retryWalletBtn').disabled = false;
              document.getElementById('retryWalletBtn').classList.remove('opacity-50');
            }
          } else {
            if (data.message && data.message.toLowerCase().includes('stock')) {
              document.getElementById('stockErrorModal').classList.add('show');
            } else {
              showToast(data.message || 'Failed to fetch retry info', 'error');
            }
            document.getElementById('retryModal').classList.remove('show');
          }
        } catch (e) {
          showToast('Network error', 'error');
          document.getElementById('retryModal').classList.remove('show');
        }
      }

      async function executeRetry(paymentMethod) {
        document.getElementById('retryModal').classList.remove('show');
        const btn = document.getElementById('retryBtn');
        const originalHTML = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = `<i class="bi bi-arrow-repeat animate-spin"></i> Loading...`;
        try {
          const resp = await fetch('/user/checkout/retry-payment', { 
            method: 'POST', 
            headers: { 'Content-Type': 'application/json' }, 
            body: JSON.stringify({ orderId: ORDER_ID, paymentMethod }) 
          });
          const data = await resp.json();
          if (!data.success) {
            if (data.message && data.message.toLowerCase().includes('stock')) {
              document.getElementById('stockErrorModal').classList.add('show');
            } else {
              showToast(data.message || 'Retry failed', 'error');
            }
            btn.disabled = false; btn.innerHTML = originalHTML; return;
          }

          if (data.redirectUrl) {
            window.location.href = data.redirectUrl;
            return;
          }

          lastRazorpayData = data;
          initiateRazorpay(res, btn, originalHTML);
        } catch { showToast('Connection failed.', 'error'); btn.disabled = false; btn.innerHTML = originalHTML; }
      }

      function reopenRazorpay() {
        document.getElementById('paymentErrorModal').classList.remove('show');
        if (lastRazorpayData) {
          const btn = document.getElementById('retryBtn');
          const originalHTML = btn.innerHTML;
          initiateRazorpay(lastRazorpayData, btn, originalHTML);
        }
      }

      function initiateRazorpay(res, btn, originalHTML) {
        const rzp = new Razorpay({
          key: res.keyId, amount: res.amount, currency: res.currency, name: "ElectroHub", order_id: res.orderId,
          prefill: { name: res.user.name, email: res.user.email, contact: res.user.phone },
          theme: { color: "#ef4444" },
          handler: (response) => verifyPayment(response, res.dbOrderId),
          modal: {
            ondismiss: async () => {
              document.getElementById('paymentErrorModal').classList.add('show');
              await fetch('/user/checkout/payment-failure', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ dbOrderId: res.dbOrderId }),
              });
              btn.disabled = false; btn.innerHTML = originalHTML;
              showToast('Payment cancelled.', 'error');
            }
          }
        });
        rzp.on('payment.failed', async (response) => {
          document.getElementById('paymentErrorModal').classList.add('show');
          await fetch('/user/checkout/payment-failure', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ dbOrderId: res.dbOrderId }),
          });
          btn.disabled = false; btn.innerHTML = originalHTML;
        });
        rzp.open();
      }

      async function verifyPayment(rzp, dbOrderId) {
        try {
          const resp = await fetch('/user/checkout/verify-payment', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ razorpayPaymentId: rzp.razorpay_payment_id, razorpayOrderId: rzp.razorpay_order_id, razorpaySignature: rzp.razorpay_signature, dbOrderId })
          });
          const data = await resp.json();
          if (data.success) window.location.href = data.redirectUrl;
          else { showToast(data.message, 'error'); setTimeout(() => location.reload(), 2000); }
        } catch { showToast('Verification failed.', 'error'); }
      }

      function toggleInlineReturn(id) {
        const el = document.getElementById(`inline-return-${id}`);
        if (el.classList.contains('hidden')) {
          el.classList.remove('hidden');
          el.classList.add('block');
        } else {
          el.classList.add('hidden');
          el.classList.remove('block');
        }
      }

      async function submitInlineReturn(id) {
        const reasonInput = document.getElementById(`reason-${id}`);
        const reason = reasonInput.value.trim();
        if (!reason) { showToast('Please enter a return reason.', 'error'); return; }
        
        const itemId = id === 'full' ? null : id;
        
        showToast('Processing return request...', 'success');
        try {
          const resp = await fetch(`/user/orders/${ORDER_ID}/return`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reason: reason, itemId: itemId })
          });
          const data = await resp.json();
          if (data.success) { 
            showToast(data.message, 'success'); 
            setTimeout(() => location.reload(), 1500); 
          } else { 
            showToast(data.message, 'error'); 
          }
        } catch { showToast('Error occurred.', 'error'); }
      }

      function toggleInlineCancel(id) {
        const el = document.getElementById(`inline-cancel-${id}`);
        if (el.classList.contains('hidden')) {
          el.classList.remove('hidden');
          el.classList.add('block');
        } else {
          el.classList.add('hidden');
          el.classList.remove('block');
        }
      }

      async function submitInlineCancel(id) {
        const reasonInput = document.getElementById(`cancel-reason-${id}`);
        const reason = reasonInput.value.trim();
        if (!reason) { showToast('Please enter a cancellation reason.', 'error'); return; }
        if (reason.length < 6) { showToast('Please enter a reason with at least 6 characters.', 'error'); return; }
        
        const itemId = id === 'full' ? null : id;
        
        showToast('Processing cancellation...', 'success');
        try {
          const resp = await fetch(`/user/orders/${ORDER_ID}/cancel`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reason: reason, itemId: itemId })
          });
          const data = await resp.json();
          const errorDiv = document.getElementById(`cancel-error-${id}`);
          if (data.success) { 
            if (errorDiv) errorDiv.classList.add('hidden');
            showToast(data.message, 'success'); 
            setTimeout(() => location.reload(), 1500); 
          } else { 
            if (errorDiv) {
              errorDiv.innerText = data.message || 'Cancellation failed';
              errorDiv.classList.remove('hidden');
            } else {
              showToast(data.message || 'Cancellation failed', 'error');
            }
          }
        } catch { 
          showToast('Error occurred.', 'error'); 
        }
      }

      // Close modals on overlay click
      ['stockErrorModal', 'retryModal', 'paymentErrorModal'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          el.addEventListener('click', function (e) { if (e.target === this) this.classList.remove('show'); });
        }
      });
    </script>
  <%- include('../partials/footer') %>
</body>

</html>
