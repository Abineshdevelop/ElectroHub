<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ElectroHub - Order History</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }

    #toast-container {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      gap: 10px;
      pointer-events: none;
    }

    .toast {
      min-width: 260px;
      max-width: 340px;
      padding: 13px 16px;
      border-radius: 12px;
      font-size: 13.5px;
      font-weight: 500;
      color: #fff;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.13);
      display: flex;
      align-items: center;
      gap: 10px;
      animation: toastIn .3s ease, toastOut .4s ease 2.6s forwards;
    }

    .toast.success {
      background: #22c55e
    }

    .toast.error {
      background: #ef4444
    }

    .toast.info {
      background: #3b82f6
    }

    @keyframes toastIn {
      from {
        transform: translateX(110%);
        opacity: 0
      }

      to {
        transform: translateX(0);
        opacity: 1
      }
    }

    @keyframes toastOut {
      from {
        opacity: 1
      }

      to {
        opacity: 0;
        transform: translateX(110%)
      }
    }

    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: 0.25s;
      z-index: 1000;
      padding: 16px;
    }

    .modal-overlay.show {
      opacity: 1;
      pointer-events: all;
    }

    .modal-box {
      background: #fff;
      border-radius: 20px;
      padding: 24px;
      width: 100%;
      max-width: 440px;
      position: relative;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }
  </style>
</head>

<body class="bg-gray-50 text-gray-800">
  <div id="toast-container"></div>
  <%- include('../partials/navbar', { user }) %>
    <div class="flex min-h-[calc(100vh-64px)]">
      <%- include('../partials/sidebar', { user, activePage: 'orders' }) %>
        <main class="flex-1 px-4 md:px-8 py-6 overflow-x-hidden">

          <nav class="text-sm text-gray-400 mb-5">
            <a href="/user/home" class="hover:text-red-500">Home</a>
            <span class="mx-2">/</span>
            <span class="text-gray-700 font-medium">My Orders</span>
          </nav>

          <div class="flex items-center justify-between mb-1">
            <h2 class="text-2xl font-bold">Order History</h2>
            <span class="text-xs text-gray-400">Platform: <span
                class="text-red-500 font-semibold">ElectroHub</span></span>
          </div>
          <p class="text-sm text-gray-400 mb-6">Track your purchases and manage returns easily.</p>

          <!-- Tabs -->
          <div class="flex flex-wrap gap-2 mb-6">
            <% const tabs=[ { key:'all', label:'All Orders', count: counts.allCount }, { key:'pending', label:'Pending',
              count: counts.pendingCount }, { key:'completed', label:'Completed', count: counts.completedCount }, {
              key:'cancelled', label:'Cancelled', count: counts.cancelledCount }, { key:'returned', label:'Returned',
              count: counts.returnedCount }, ]; %>
              <% tabs.forEach(t=> { %>
                <a href="/user/orders?tab=<%= t.key %>"
                  class="border-2 rounded-xl px-4 py-2 text-sm font-semibold transition-colors
            <%= activeTab === t.key ? 'bg-red-500 text-white border-red-500' : 'bg-white text-gray-600 border-gray-200 hover:border-red-300 hover:text-red-500' %>">
                  <%= t.label %>
                    <span class="ml-1 text-xs px-1.5 py-0.5 rounded-full
            <%= activeTab === t.key ? 'bg-red-400 text-white' : 'bg-gray-100 text-gray-500' %>">
                      <%= t.count %>
                    </span>
                </a>
                <% }) %>
          </div>

          <!-- Orders List -->
          <% if (orders.length===0) { %>
            <div class="bg-white rounded-2xl border border-gray-100 p-16 text-center">
              <i class="bi bi-bag-x text-5xl text-gray-200 block mb-4"></i>
              <p class="text-gray-500 font-medium text-lg">No orders found</p>
              <p class="text-gray-400 text-sm mt-1 mb-6">Nothing here yet in this category.</p>
              <a href="/user/home"
                class="inline-block bg-red-500 hover:bg-red-600 text-white font-semibold px-6 py-2.5 rounded-xl text-sm transition-colors">
                Start Shopping
              </a>
            </div>
            <% } else { %>
              <div class="space-y-4">
                <% orders.forEach(order=> {
                  const sMap = {
                  confirmed: { label:'Confirmed', dot:'bg-blue-600', cls:'bg-blue-600' },
                  shipped: { label:'Shipped', dot:'bg-indigo-600', cls:'bg-indigo-600' },
                  delivered: { label:'Delivered', dot:'bg-green-600', cls:'bg-green-600' },
                  cancelled: { label:'Cancelled', dot:'bg-red-600', cls:'bg-red-600' },
                  partially_cancelled: { label:'Partial Cancel', dot:'bg-orange-600', cls:'bg-orange-600' },
                  return_requested: { label:'Return Requested', dot:'bg-purple-600', cls:'bg-purple-600' },
                  returned: { label:'Returned', dot:'bg-orange-600', cls:'bg-orange-600' },
                  pending: { label:'Pending', dot:'bg-gray-400', cls:'bg-gray-600' },
                  return_rejected: { label:'Return Rejected', dot:'bg-red-600', cls:'bg-red-600' },
                  };
                  const itemStatusMap = {
                  pending: { label:'Pending', cls:'bg-gray-400' },
                  confirmed: { label:'Confirmed', cls:'bg-blue-600' },
                  shipped: { label:'Shipped', cls:'bg-indigo-600' },
                  delivered: { label:'Delivered', cls:'bg-green-600' },
                  cancelled: { label:'Cancelled', cls:'bg-red-600' },
                  return_requested: { label:'Return Requested', cls:'bg-purple-600' },
                  returned: { label:'Returned', cls:'bg-orange-600' },
                  return_rejected: { label:'Return Rejected', cls:'bg-red-600' },
                  };
                  let s = sMap[order.orderStatus] || { label: order.orderStatus, dot:'bg-gray-400', cls:'bg-gray-100 text-gray-600' };
                  if (order.paymentStatus === 'failed') {
                  s = { label: 'Payment Failed', dot: 'bg-red-500', cls: 'bg-red-100 text-red-600' };
                  }
                  %>

                  <!-- One card per ORDER -->
                  <div
                    class="bg-white rounded-2xl border border-gray-100 hover:shadow-md transition-shadow overflow-hidden">

                    <!-- Order header -->
                    <div
                      class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 border-b border-gray-100 bg-gray-50">
                      <div class="flex items-center gap-4">
                        <div>
                          <p class="text-xs text-gray-400">Order ID</p>
                          <p class="text-sm font-bold text-gray-800">#<%= order.orderId %>
                          </p>
                        </div>
                        <div>
                          <p class="text-xs text-gray-400">Placed on</p>
                          <p class="text-sm font-semibold text-gray-700">
                            <%= new
                              Date(order.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'})
                              %>
                          </p>
                        </div>
                        <div>
                          <p class="text-xs text-gray-400">Total</p>
                          <p class="text-sm font-bold text-red-500">₹<%= (order.totalAmount ||
                              0).toLocaleString('en-IN') %>
                          </p>
                        </div>
                      </div>
                      <div class="flex items-center gap-3">
                        <a href="/user/orders/<%= order._id %>"
                          class="bg-gray-900 hover:bg-gray-700 text-white text-xs font-semibold px-5 py-2 rounded-xl transition-colors">
                          View Details
                        </a>
                      </div>
                    </div>

                    <!-- All items in this order -->
                    <div class="divide-y divide-gray-50">
                      <% order.items.forEach(item=> {
                        const itemStatus = item.status || order.orderStatus;
                        const is = itemStatusMap[itemStatus] || { label: itemStatus, cls:'bg-gray-100 text-gray-600' };
                        %>
                        <div class="flex items-center gap-4 px-5 py-4">
                          <!-- Product image -->
                          <div
                            class="w-14 h-14 rounded-xl overflow-hidden bg-gray-100 flex-shrink-0 flex items-center justify-center">
                            <% if (item.productImage) { %>
                              <img src="<%= item.productImage %>" alt="<%= item.productName %>"
                                class="w-full h-full object-cover" onerror="this.onerror=null; this.src='/images/placeholder.svg'" />
                              <% } else { %>
                                <i class="bi bi-image text-xl text-gray-300"></i>
                                <% } %>
                          </div>
                          <!-- Product info -->
                          <div class="flex-1 min-w-0">
                            <p class="font-semibold text-sm text-gray-800 truncate">
                              <% if (item.productId && item.productId.brandName) { %>
                                <span class="text-[9px] font-bold text-red-500 uppercase tracking-widest block mb-0.5"><%= item.productId.brandName %></span>
                              <% } %>
                              <%= item.productName %>
                            </p>
                            <p class="text-xs text-gray-400 mt-0.5">
                              <% 
                                const attributes = (item.variantAttributes && Object.keys(item.variantAttributes).length > 0)
                                  ? item.variantAttributes
                                  : (item.variantId && item.variantId.options ? item.variantId.options : null);
                              %>
                              <%= attributes ? Object.entries(attributes).map(([k,v]) => `${k}: ${v}`).join(' · ') : '' %>
                            </p>
                <div class="flex items-center gap-3 mt-1">
                  <p class="text-xs text-gray-400">Qty: <span class="font-semibold text-gray-600"><%= item.quantity %></span></p>
                  <p class="text-xs font-bold text-red-500">₹<%= (item.finalAmount ?? item.lineTotal ?? 0).toLocaleString('en-IN') %>
                            </p>
                          </div>
                        </div>
                        <!-- Item status badge -->
                        <span class="inline-flex items-center px-2.5 py-1 rounded flex-shrink-0 text-white font-bold uppercase text-[10px] tracking-widest shadow-sm <%= is.cls %>">
                          <%= is.label %>
                        </span>
                    </div>
                    <% }) %>
                  </div>

                  <!-- Refund notice -->
                  <% if (order.refundStatus==='processed' && order.refundAmount> 0) { %>
                    <div
                      class="px-5 py-3 border-t border-gray-100 flex items-center gap-2 text-xs text-green-600 font-semibold bg-green-50">
                      <i class="bi bi-wallet2"></i>
                      ₹<%= order.refundAmount.toLocaleString('en-IN') %> refunded to your wallet
                    </div>
                    <% } %>

                      <!-- Retry button for failed orders -->
                      <% if (order.paymentStatus==='failed' ) { %>
                        <div
                          class="px-5 py-3 border-t border-gray-100 flex items-center justify-between gap-4 bg-red-50">
                          <span class="text-xs font-semibold text-red-600">
                            <i class="bi bi-exclamation-circle-fill mr-1"></i> Payment Failed
                          </span>
                          <button onclick="retryPayment('<%= order._id %>')"
                            class="bg-red-500 hover:bg-red-600 text-white text-xs font-semibold px-4 py-1.5 rounded-lg shadow-sm transition-colors cursor-pointer disabled:opacity-50">
                            Retry Payment
                          </button>
                        </div>
                        <% } %>
              </div>

              <% }) %>
    </div>
    <% } %>

      <!-- STOCK ERROR MODAL -->
      <div id="stockErrorModal" class="modal-overlay">
        <div class="modal-box text-center" style="max-width:400px; padding: 2.5rem 2rem;">
          <div class="w-20 h-20 bg-amber-100 text-amber-500 rounded-full flex items-center justify-center mx-auto mb-5">
            <i class="bi bi-exclamation-triangle-fill text-4xl"></i>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Stock Unavailable</h3>
          <p class="text-gray-500 mb-6 font-medium text-sm px-2">One or more items in this order are currently out of stock. You cannot complete the payment at this moment.</p>
          <button onclick="document.getElementById('stockErrorModal').classList.remove('show')"
            class="block w-full py-3.5 px-4 bg-gray-900 hover:bg-black text-white font-bold rounded-xl transition shadow-sm text-center">
            Close
          </button>
        </div>
      </div>

      <!-- PAYMENT CANCELLATION MODAL -->
      <div id="paymentErrorModal" class="modal-overlay text-center">
        <div class="modal-box" style="max-width:400px; padding: 2.5rem 2rem;">
          <div class="w-16 h-16 bg-red-100 text-red-500 rounded-full flex items-center justify-center mx-auto mb-5">
            <i class="bi bi-x-circle-fill text-3xl"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Payment Cancelled</h3>
          <p class="text-sm text-gray-500 mb-8 font-medium">Your payment attempt was cancelled. Would you like to try again or stay on this page?</p>
          <div class="flex flex-col gap-3">
            <button onclick="reopenRazorpay()" 
              class="w-full py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl transition shadow-md active:scale-95 text-sm">
              Retry Payment
            </button>
            <button onclick="document.getElementById('paymentErrorModal').classList.remove('show')"
              class="w-full py-3 border border-gray-200 text-gray-500 font-bold rounded-xl hover:bg-gray-50 transition text-sm">
              Cancel & Stay Here
            </button>
          </div>
        </div>
      </div>

      <!-- RETRY CHOICE MODAL -->
      <div id="retryModal" class="modal-overlay">
        <div class="modal-box text-center" style="max-width:400px; padding: 2rem;">
          <h3 class="text-xl font-bold text-gray-900 mb-4">Select Payment Method</h3>
          <div class="mb-6 bg-gray-50 border border-gray-100 rounded-xl p-4 text-left">
            <div class="flex justify-between text-sm mb-1">
              <span class="text-gray-500 font-medium">Order Total:</span>
              <span class="text-gray-900 font-bold" id="retryOrderAmount">₹0.00</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500 font-medium">Wallet Balance:</span>
              <span class="text-gray-900 font-bold" id="retryWalletBalance">₹0.00</span>
            </div>
          </div>
          <p class="text-xs text-gray-500 mb-6 font-medium">Choose how you'd like to pay for this order retry.</p>
          <div class="flex flex-col gap-3">
            <button id="retryWalletBtn" onclick="executeRetry('wallet')"
              class="w-full py-3 px-4 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl transition shadow-sm text-sm flex items-center justify-center gap-2 disabled:opacity-50 disabled:grayscale">
              <i class="bi bi-wallet2"></i> Pay with Wallet
            </button>
            <button onclick="executeRetry('razorpay')"
              class="w-full py-3 px-4 border border-gray-200 text-gray-700 font-bold rounded-xl hover:bg-gray-50 transition text-sm flex items-center justify-center gap-2">
              <i class="bi bi-credit-card"></i> Pay Online (Razorpay)
            </button>
            <button onclick="document.getElementById('retryModal').classList.remove('show')"
              class="w-full py-2 px-4 text-gray-400 font-semibold hover:text-gray-600 transition text-xs mt-2 underline">
              Cancel
            </button>
          </div>
        </div>
      </div>

      </main>
      </div>

      <script>
        let lastFailedOrderId = null;
        let lastRazorpayData = null;

        function showToast(msg, type = 'success') {
          const icons = { success: 'bi-check-circle-fill', error: 'bi-x-circle-fill', info: 'bi-info-circle-fill' };
          const t = document.createElement('div'); t.className = `toast ${type}`;
          t.innerHTML = `<i class="bi ${icons[type]}"></i><span>${msg}</span>`;
          document.getElementById('toast-container').appendChild(t);
          setTimeout(() => t.remove(), 3000);
        }

        async function retryPayment(orderId) {
          lastFailedOrderId = orderId;
          
          // Show modal immediately with loading state
          document.getElementById('retryOrderAmount').innerText = 'Loading...';
          document.getElementById('retryWalletBalance').innerText = 'Loading...';
          document.getElementById('retryWalletBtn').disabled = true;
          document.getElementById('retryModal').classList.add('show');

          try {
            const res = await fetch('/user/checkout/retry-payment', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ orderId })
            });
            const data = await res.json();

            if (data.success && data.infoOnly) {
              document.getElementById('retryOrderAmount').innerText = `₹${data.totalAmount.toLocaleString('en-IN')}`;
              document.getElementById('retryWalletBalance').innerText = `₹${data.walletBalance.toLocaleString('en-IN')}`;
              
              if (data.walletBalance < data.totalAmount) {
                document.getElementById('retryWalletBtn').disabled = true;
                document.getElementById('retryWalletBtn').classList.add('opacity-50');
              } else {
                document.getElementById('retryWalletBtn').disabled = false;
                document.getElementById('retryWalletBtn').classList.remove('opacity-50');
              }
            } else {
              if (data.message && data.message.toLowerCase().includes('stock')) {
                document.getElementById('stockErrorModal').classList.add('show');
              } else {
                showToast(data.message || 'Failed to fetch retry info', 'error');
              }
              document.getElementById('retryModal').classList.remove('show');
            }
          } catch (e) {
            showToast('Network error', 'error');
            document.getElementById('retryModal').classList.remove('show');
          }
        }

        async function executeRetry(paymentMethod) {
          document.getElementById('retryModal').classList.remove('show');
          const orderId = lastFailedOrderId;
          
          try {
            // Find the button (this might be tricky across pages, so we show a global loader if needed)
            const btn = document.querySelector(`button[onclick="retryPayment('${orderId}')"]`) || { disabled: false };
            btn.disabled = true;
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Processing...';

            const res = await fetch('/user/checkout/retry-payment', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ orderId, paymentMethod })
            });
            const data = await res.json();

            if (!data.success) {
              if (data.message && data.message.toLowerCase().includes('stock')) {
                document.getElementById('stockErrorModal').classList.add('show');
              } else {
                showToast(data.message || 'Retry failed', 'error');
              }
              btn.disabled = false;
              btn.innerHTML = originalHTML;
              return;
            }

            if (data.redirectUrl) {
              window.location.href = data.redirectUrl;
              return;
            }

            if (data.redirectUrl) {
              window.location.href = data.redirectUrl;
              return;
            }

            lastRazorpayData = data;
            initiateRazorpay(data, btn, originalHTML);

          } catch (err) {
            showToast('Something went wrong', 'error');
          }
        }

        function reopenRazorpay() {
          document.getElementById('paymentErrorModal').classList.remove('show');
          if (lastRazorpayData) {
            // Find the button (this might be tricky across pages, so we show a global loader if needed)
            const btn = document.querySelector(`button[onclick="retryPayment('${lastFailedOrderId}')"]`) || { disabled: false };
            const originalHTML = btn.innerHTML;
            initiateRazorpay(lastRazorpayData, btn, originalHTML);
          }
        }

        function initiateRazorpay(data, btn, originalHTML) {
          const options = {
            key: data.keyId,
            amount: data.amount,
            currency: data.currency,
            name: 'ElectroHub',
            description: 'Order Payment Retry',
            order_id: data.orderId,
            prefill: {
              name: data.user.name,
              email: data.user.email,
              contact: data.user.phone,
            },
            theme: { color: '#ef4444' },
            handler: async (response) => {
              try {
                const verifyRes = await fetch('/user/checkout/verify-payment', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    dbOrderId: data.dbOrderId,
                    razorpayPaymentId: response.razorpay_payment_id,
                    razorpayOrderId: response.razorpay_order_id,
                    razorpaySignature: response.razorpay_signature,
                  })
                });
                const verifyData = await verifyRes.json();
                if (verifyData.success) {
                  window.location.href = verifyData.redirectUrl;
                } else {
                  showToast('Verification failed', 'error');
                  if (btn) { btn.disabled = false; btn.innerHTML = originalHTML; }
                }
              } catch (e) {
                showToast('Verification error', 'error');
                if (btn) { btn.disabled = false; btn.innerHTML = originalHTML; }
              }
            },
            modal: {
              ondismiss: async () => {
                document.getElementById('paymentErrorModal').classList.add('show');
                await fetch('/user/checkout/payment-failure', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ dbOrderId: data.dbOrderId }),
                });
                if (btn) { btn.disabled = false; btn.innerHTML = originalHTML; }
              }
            }
          };

          const rzp = new Razorpay(options);
          rzp.on('payment.failed', async (response) => {
            document.getElementById('paymentErrorModal').classList.add('show');
            await fetch('/user/checkout/payment-failure', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ dbOrderId: data.dbOrderId }),
            });
            if (btn) { btn.disabled = false; btn.innerHTML = originalHTML; }
          });
          rzp.open();
        }

        // Close modals on overlay click
        ['stockErrorModal', 'retryModal', 'paymentErrorModal'].forEach(id => {
          const el = document.getElementById(id);
          if (el) {
            el.addEventListener('click', function (e) { if (e.target === this) this.classList.remove('show'); });
          }
        });
      </script>
  <%- include('../partials/footer') %>
</body>

</html>