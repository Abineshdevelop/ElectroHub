<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ElectroHub - Cart</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .cart-item {
      display: flex; align-items: center; gap: 16px;
      padding: 20px 0; border-bottom: 1px solid #f0f0f0;
      transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .cart-item:last-of-type { border-bottom: none; }
    .qty-btn {
      width: 30px; height: 30px; border-radius: 6px;
      border: 1.5px solid #d1d5db; background: #fff;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; font-size: 15px; color: #374151;
      transition: all 0.15s; flex-shrink: 0; user-select: none;
    }
    .qty-btn:hover { border-color: #ef4444; color: #ef4444; background: #fff5f5; }
    .qty-btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .qty-btn:disabled:hover { border-color: #d1d5db; color: #374151; background: #fff; }
    .qty-input {
      width: 34px; text-align: center; border: none; outline: none;
      font-size: 14px; font-weight: 600; color: #1f2937; background: transparent;
      -moz-appearance: textfield;
      appearance: textfield;
    }
    .qty-input::-webkit-outer-spin-button,
    .qty-input::-webkit-inner-spin-button { 
      -webkit-appearance: none; 
      appearance: none;
      margin: 0; 
    }
    #toast-container {
      position: fixed; top: 20px; right: 20px; z-index: 9999;
      display: flex; flex-direction: column; gap: 10px; pointer-events: none;
    }
    .toast {
      min-width: 260px; max-width: 340px; padding: 13px 16px; border-radius: 12px;
      font-size: 13.5px; font-weight: 500; color: #fff;
      box-shadow: 0 4px 20px rgba(0,0,0,0.13);
      display: flex; align-items: center; gap: 10px;
      animation: toastIn 0.3s ease, toastOut 0.4s ease 2.6s forwards;
    }
    .toast.success { background: #22c55e; }
    .toast.error   { background: #ef4444; }
    .toast.info    { background: #3b82f6; }
    .toast.warn    { background: #d97706; }
    @keyframes toastIn  { from { transform: translateX(110%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
    @keyframes toastOut { from { opacity: 1; transform: translateX(0); } to { opacity: 0; transform: translateX(110%); } }
  </style>
</head>
<body class="bg-gray-50 text-gray-800">
  <div id="toast-container"></div>
  <%- include('../partials/navbar', { user }) %>

  <div class="flex min-h-[calc(100vh-64px)]">
    <%- include('../partials/sidebar', { user, activePage: 'cart' }) %>

    <main class="flex-1 px-4 md:px-8 py-6 md:py-8 overflow-x-hidden">
      <nav class="text-sm text-gray-400 mb-5">
        <a href="/user/home" class="hover:text-red-500 transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-gray-700 font-medium">Cart</span>
      </nav>
      <h2 class="text-2xl md:text-3xl font-bold mb-2">Shopping Cart</h2>
      <p class="text-sm text-gray-400 mb-7">Review your items before proceeding to checkout</p>

      <% if (cart && cart.items && cart.items.length > 0) { %>
        <div class="flex flex-col lg:flex-row gap-6">

          <!-- Cart Items -->
          <div class="flex-1">
            <div id="cart-items-wrapper" class="bg-white rounded-2xl shadow-sm border border-gray-100 px-6 py-2">
              <% cart.items.forEach(item => { %>
                <%
                  const isAvailable = item.isAvailable !== false;
                  const isOutOfStock = isAvailable && item.stock === 0;
                  const isInsufficient = isAvailable && item.quantity > item.stock;
                  const cappedStock  = Math.min(item.stock, 10);
                  const offerPct     = item.offerPct || 0;
                  const crossedPrice = offerPct > 0 ? item.originalPrice : 0;
                  const hasDiscount  = offerPct > 0 && crossedPrice > item.price;
                %>
                <div class="cart-item"
                  data-product-id="<%= item.productId._id %>"
                  data-variant-id="<%= item.variantId %>"
                  data-price="<%= item.price %>"
                  data-stock="<%= item.stock %>">

                  <!-- Image -->
                  <div class="w-16 h-16 md:w-20 md:h-20 rounded-xl overflow-hidden bg-gray-100 flex-shrink-0">
                    <img src="<%= item.image %>" alt="<%= item.productId.productName %>"
                      class="w-full h-full object-cover <%= isOutOfStock ? 'opacity-40' : '' %>"
                      onerror="this.src='/images/placeholder.png'" />
                  </div>

                  <!-- Info -->
                  <div class="flex-1 min-w-0">
                    <h4 class="font-semibold text-gray-800 text-sm md:text-base truncate">
                      <%= item.productId.productName %>
                    </h4>
                    <p class="text-xs text-gray-400 mt-0.5"><%= item.variantLabel || '' %></p>

                    <!-- Price with offer strikethrough -->
                    <div class="flex items-center gap-2 mt-1">
                      <span class="text-sm font-bold text-gray-800">₹<%= item.price.toLocaleString('en-IN') %></span>
                      <% if (hasDiscount) { %>
                        <span class="text-xs text-gray-400 line-through">₹<%= crossedPrice.toLocaleString('en-IN') %></span>
                        <span class="text-xs font-bold text-green-600 bg-green-50 px-1.5 py-0.5 rounded-full"><%= offerPct %>% off</span>
                      <% } %>
                    </div>

                    <!-- Stock badge -->
                    <div class="stock-badge-container">
                      <% if (!isAvailable) { %>
                        <span class="inline-flex items-center gap-1 text-xs font-bold px-2 py-0.5 rounded-full bg-gray-100 text-gray-500 mt-1">
                          <i class="bi bi-dash-circle-fill" style="font-size:10px;"></i> Currently Unavailable
                        </span>
                      <% } else if (isOutOfStock) { %>
                        <span class="inline-flex items-center gap-1 text-xs font-bold px-2 py-0.5 rounded-full bg-red-100 text-red-600 mt-1">
                          <i class="bi bi-x-circle-fill" style="font-size:10px;"></i> Out of Stock
                        </span>
                      <% } else if (isInsufficient) { %>
                        <span class="inline-flex items-center gap-1 text-xs font-bold px-2 py-0.5 rounded-full bg-orange-100 text-orange-600 mt-1">
                          <i class="bi bi-exclamation-circle-fill" style="font-size:10px;"></i> Insufficient Stock (Only <%= item.stock %> left)
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1 text-xs font-bold px-2 py-0.5 rounded-full bg-green-100 text-green-700 mt-1">
                          <i class="bi bi-check-circle-fill" style="font-size:10px;"></i> In Stock
                        </span>
                      <% } %>
                    </div>

                    <!-- Qty stepper mobile -->
                    <div class="flex items-center gap-2 mt-2 md:hidden">
                      <button class="qty-btn decrease-btn"
                        data-id="<%= item.productId._id %>" data-variant="<%= item.variantId %>">
                        <i class="bi bi-dash"></i>
                      </button>
                      <input class="qty-input" type="number"
                        value="<%= item.quantity %>" min="1" max="<%= cappedStock %>" readonly />
                      <button class="qty-btn increase-btn"
                        data-id="<%= item.productId._id %>" data-variant="<%= item.variantId %>">
                        <i class="bi bi-plus"></i>
                      </button>
                    </div>
                  </div>

                  <!-- Qty stepper desktop -->
                  <div class="hidden md:flex items-center gap-2 flex-shrink-0">
                    <button class="qty-btn decrease-btn"
                      data-id="<%= item.productId._id %>" data-variant="<%= item.variantId %>">
                      <i class="bi bi-dash"></i>
                    </button>
                    <input class="qty-input" type="number"
                      value="<%= item.quantity %>" min="1" max="<%= cappedStock %>" readonly />
                    <button class="qty-btn increase-btn"
                      data-id="<%= item.productId._id %>" data-variant="<%= item.variantId %>">
                      <i class="bi bi-plus"></i>
                    </button>
                  </div>

                  <!-- Line total -->
                  <div class="text-right flex-shrink-0 min-w-[90px]">
                    <p class="item-total font-bold <%= (isOutOfStock || isInsufficient) ? 'text-red-400' : 'text-gray-800' %> text-sm md:text-base">
                      ₹<%= (item.price * item.quantity).toLocaleString('en-IN') %>
                    </p>
                    <p class="text-xs text-gray-400 mt-0.5">₹<%= item.price.toLocaleString('en-IN') %> each</p>
                  </div>

                  <!-- Remove -->
                  <button class="remove-btn flex-shrink-0 bg-red-500 hover:bg-red-600 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition-colors"
                    data-id="<%= item.productId._id %>" data-variant="<%= item.variantId %>">
                    Remove
                  </button>
                </div>
              <% }) %>
            </div>

            <div class="flex items-center mt-4">
              <a href="/user/list"
                class="border border-gray-300 text-gray-700 font-semibold text-sm px-6 py-2.5 rounded-xl hover:bg-gray-100 transition-colors">
                Return To Shop
              </a>
            </div>
          </div>

          <!-- Cart Total -->
          <div class="w-full lg:w-80 flex-shrink-0">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
              <h3 class="text-lg font-bold text-gray-800 mb-5">Cart Total</h3>
              <div class="space-y-3 mb-5">
                <div class="flex justify-between text-sm">
                  <span class="text-gray-500">Subtotal:</span>
                  <span id="subtotal-display" class="font-semibold text-gray-800">₹<%= subtotal?.toLocaleString('en-IN') || '0' %></span>
                </div>
                <div class="flex justify-between text-sm border-t pt-3">
                  <span class="text-gray-500">Shipping:</span>
                  <span class="font-semibold text-green-500">Free</span>
                </div>
                <div class="flex justify-between text-sm border-t pt-3">
                  <span class="text-gray-700 font-semibold">Total:</span>
                  <span id="total-display" class="font-bold text-gray-800 text-base">₹<%= subtotal?.toLocaleString('en-IN') || '0' %></span>
                </div>
              </div>
              <% const canCheckout = cart.items.every(item => item.isAvailable !== false && item.quantity <= item.stock && item.stock > 0); %>
              <a href="<%= canCheckout ? '/user/checkout' : 'javascript:void(0)' %>"
                id="checkout-btn"
                data-can-checkout="<%= canCheckout %>"
                class="block w-full text-center py-3 rounded-xl transition-colors shadow-sm font-bold text-sm
                <%= canCheckout ? 'bg-red-500 hover:bg-red-600 text-white hover:shadow-md' : 'bg-gray-200 text-gray-400 cursor-not-allowed opacity-60' %> mt-4">
                Proceed to Checkout
              </a>
            </div>
          </div>
        </div>

      <% } else { %>
        <div class="flex flex-col items-center justify-center py-24 text-center">
          <div class="w-24 h-24 rounded-3xl bg-red-50 flex items-center justify-center mb-6">
            <i class="bi bi-cart-x text-red-400 text-4xl"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-2">Your cart is empty</h3>
          <p class="text-sm text-gray-400 mb-7">Looks like you haven't added anything yet.</p>
          <a href="/user/list"
            class="bg-red-500 hover:bg-red-600 text-white font-bold text-sm px-8 py-3 rounded-full transition-all duration-200 hover:shadow-lg hover:shadow-red-200 hover:scale-105">
            Continue Shopping
          </a>
        </div>
      <% } %>
    </main>
  </div>

  <%- include('../partials/layout-scripts') %>

  <script>
    function showToast(message, type = 'success') {
      const icons = { success:'bi-check-circle-fill', error:'bi-x-circle-fill', info:'bi-info-circle-fill', warn:'bi-exclamation-triangle-fill' };
      const toast = document.createElement('div');
      toast.className = `toast ${type}`;
      toast.innerHTML = `<i class="bi ${icons[type] || icons.info}"></i><span>${message}</span>`;
      document.getElementById('toast-container').appendChild(toast);
      setTimeout(() => toast.remove(), 3000);
    }

    function fmt(n) { return '₹' + Number(n).toLocaleString('en-IN'); }

    function recalcTotals() {
      let subtotal = 0;
      let hasError = false;
      document.querySelectorAll('.cart-item').forEach(row => {
        const stock = parseInt(row.dataset.stock) || 0;
        const price = parseFloat(row.dataset.price) || 0;
        const qty   = parseInt(row.querySelector('.qty-input').value) || 1;
        
        const badgeContainer = row.querySelector('.stock-badge-container');
        if (qty > stock) {
           hasError = true;
           if (badgeContainer) {
              badgeContainer.innerHTML = `<span class="inline-flex items-center gap-1 text-xs font-bold px-2 py-0.5 rounded-full bg-orange-100 text-orange-600 mt-1">
                <i class="bi bi-exclamation-circle-fill" style="font-size:10px;"></i> Insufficient Stock (Only ${stock} left)
              </span>`;
           }
        } else if (stock === 0) {
           hasError = true;
           if (badgeContainer) {
              badgeContainer.innerHTML = `<span class="inline-flex items-center gap-1 text-xs font-bold px-2 py-0.5 rounded-full bg-red-100 text-red-600 mt-1">
                <i class="bi bi-x-circle-fill" style="font-size:10px;"></i> Out of Stock
              </span>`;
           }
        } else {
           if (badgeContainer) {
              badgeContainer.innerHTML = `<span class="inline-flex items-center gap-1 text-xs font-bold px-2 py-0.5 rounded-full bg-green-100 text-green-700 mt-1">
                <i class="bi bi-check-circle-fill" style="font-size:10px;"></i> In Stock
              </span>`;
           }
        }

        // Update button visual states without blocking clicks
        row.querySelectorAll('.increase-btn').forEach(btn => {
           if (stock === 0 || qty >= Math.min(stock, 10)) {
             btn.classList.add('opacity-50');
           } else {
             btn.classList.remove('opacity-50');
           }
        });

        subtotal += price * qty;
        row.querySelector('.item-total').textContent = fmt(price * qty);
      });

      const s = document.getElementById('subtotal-display');
      const t = document.getElementById('total-display');
      if (s) s.textContent = fmt(subtotal);
      if (t) t.textContent = fmt(subtotal);

      const checkoutBtn = document.getElementById('checkout-btn');
      if (checkoutBtn) {
        if (hasError || document.querySelectorAll('.cart-item').length === 0) {
          checkoutBtn.classList.add('bg-gray-200', 'text-gray-400', 'cursor-not-allowed', 'opacity-60');
          checkoutBtn.classList.remove('bg-red-500', 'hover:bg-red-600', 'text-white', 'hover:shadow-md');
          checkoutBtn.onclick = (e) => { e.preventDefault(); showToast('Please fix insufficient stock items first', 'warn'); };
          checkoutBtn.setAttribute('href', '#');
        } else {
          checkoutBtn.classList.remove('bg-gray-200', 'text-gray-400', 'cursor-not-allowed', 'opacity-60');
          checkoutBtn.classList.add('bg-red-500', 'hover:bg-red-600', 'text-white', 'hover:shadow-md');
          checkoutBtn.onclick = null;
          checkoutBtn.setAttribute('href', '/user/checkout');
        }
      }
    }

    async function updateQuantity(productId, variantId, newQty, triggerBtn) {
      triggerBtn.disabled = true;
      try {
        const res  = await fetch('/user/cart/update', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, variantId, quantity: newQty })
        })

        const data = await res.json();
        if(!res.ok){
          console.log("response from backend ", data)
          showToast( data.message, "error")
        }
        if (data.success) {
          const row = document.querySelector(`.cart-item[data-product-id="${productId}"][data-variant-id="${variantId}"]`);
          if (row) {
            row.querySelectorAll('.qty-input').forEach(inp => inp.value = newQty);
            recalcTotals();
          }
          localStorage.setItem('cart_qty_update', JSON.stringify({ variantId, quantity: newQty, ts: Date.now() }));
        } else {
          showToast(data.message || 'Failed to update quantity', 'error');
        }
      } catch (e) {
        showToast('Something went wrong', 'error');
      } finally {
        triggerBtn.disabled = false;
      }
    }

    async function removeItem(productId, variantId, triggerBtn) {
      triggerBtn.disabled = true;
      try {
        const res  = await fetch('/user/cart/remove', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, variantId })
        });
        const data = await res.json();
        if (data.success) {
          const row = document.querySelector(`.cart-item[data-product-id="${productId}"][data-variant-id="${variantId}"]`);
          if (row) {
            row.style.opacity = '0'; row.style.transform = 'translateX(30px)';
            setTimeout(() => {
              row.remove(); recalcTotals();
              if (!document.querySelector('.cart-item')) location.reload();
            }, 300);
          }
          localStorage.setItem('cart_qty_update', JSON.stringify({ variantId, quantity: 0, ts: Date.now() }));
          showToast('Item removed', 'info');
        } else {
          showToast(data.message || 'Failed to remove item', 'error');
          triggerBtn.disabled = false;
        }
      } catch (e) {
        showToast('Something went wrong', 'error');
        triggerBtn.disabled = false;
      }
    }

    document.querySelectorAll('.increase-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const row   = btn.closest('.cart-item');
        const inp   = row.querySelector('.qty-input');
        const qty   = parseInt(inp.value);
        const stock = parseInt(row.dataset.stock) || 0;
        const max   = Math.min(parseInt(inp.max) || 10, stock);
        if (qty < max) {
          updateQuantity(btn.dataset.id, btn.dataset.variant, qty + 1, btn);
        } else if (stock >= 10) {
          showToast('Maximum 10 units allowed per order', 'warn');
        } else {
          showToast('No more stock available for this item', 'warn');
        }
      });
    });

    document.querySelectorAll('.decrease-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const row = btn.closest('.cart-item');
        const inp = row.querySelector('.qty-input');
        const qty = parseInt(inp.value);
        if (qty > 1) {
          updateQuantity(btn.dataset.id, btn.dataset.variant, qty - 1, btn);
        } else {
          showToast('Minimum quantity is 1', 'warn');
        }
      });
    });

    document.querySelectorAll('.remove-btn').forEach(btn => {
      btn.addEventListener('click', () => removeItem(btn.dataset.id, btn.dataset.variant, btn));
    });

    const checkoutBtn = document.getElementById('checkout-btn');
    if (checkoutBtn) {
      checkoutBtn.addEventListener('click', (e) => {
        if (checkoutBtn.dataset.canCheckout === 'false') {
          e.preventDefault();
          showToast('Please fix insufficient stock items first', 'warn');
        }
      });
    }
  </script>
</body>
</html>