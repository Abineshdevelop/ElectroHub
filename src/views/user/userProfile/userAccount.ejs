// Send OTP — first time
document.getElementById('requestOtpBtn')?.addEventListener('click', async () => {
  if (eSending) return;
  const email = document.getElementById('newEmail').value.trim();
  clearErr('newEmailErr');

  // Frontend validation
  if (!email) {
    setErr('newEmailErr', 'Email is required');
    return;
  }
  if (!emailRegex.test(email)) {
    setErr('newEmailErr', 'Enter a valid email address');
    return;
  }

  // ✅ ADDED: Check if new email is same as current email
  const currentEmail = document.getElementById('emailDisplay').value.trim().toLowerCase();
  if (email.toLowerCase() === currentEmail) {
    setErr('newEmailErr', 'New email must be different from your current email');
    return;
  }

  eSending = true;
  const btn = document.getElementById('requestOtpBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="bi bi-hourglass-split text-xs"></i> Sending OTP...';

  const { ok, message } = await sendEmailOtpToServer(email, false);

  btn.disabled = false;
  btn.innerHTML = '<i class="bi bi-send text-xs"></i> Send OTP';
  eSending = false;

  if (!ok) {
    setErr('newEmailErr', message);
    showToast(message, 'error');
    return;
  }

  storedNewEmail = email;
  showToast('Check your email — OTP sent!', 'info');
  startEmailOtpUI();
});

// Resend OTP
document.getElementById('resendEmailOtpBtn')?.addEventListener('click', async () => {
  if (eResend <= 0 || eSending) return;
  eSending = true;
  const btn = document.getElementById('resendEmailOtpBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="bi bi-hourglass-split text-xs"></i> Sending...';

  const { ok, message } = await sendEmailOtpToServer(storedNewEmail, true);
  eSending = false;

  if (!ok) {
    btn.disabled = false;
    btn.innerHTML = `<i class="bi bi-arrow-clockwise text-xs"></i> Resend OTP (<span id="emailResendCount">${eResend}</span> left)`;
    showToast(message, 'error');
    return;
  }

  eResend--;
  showToast('Check your email — OTP resent!', 'info');
  eAttempts = 0; eLocked = false;
  clearErr('emailOtpErr');
  eOtp = initOtpBoxes('emailOtpBoxes');
  eOtp.clear();
  startEmailTimer();
});

// Verify OTP
document.getElementById('verifyOtpBtn')?.addEventListener('click', async () => {
  if (eLocked) return;
  if (!eOtp) return;
  eOtp.clearError(); clearErr('emailOtpErr');
  const otp = eOtp.get();
  if (otp.length < 6) { eOtp.setError(); setErr('emailOtpErr', 'Enter all 6 digits'); return; }

  const btn = document.getElementById('verifyOtpBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="bi bi-hourglass-split text-xs"></i> Verifying...';

  const res  = await fetch('/user/profile/email/verify-otp', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ otp })
  });
  const data = await res.json();
  btn.disabled = false;
  btn.innerHTML = '<i class="bi bi-check-circle text-xs"></i> Verify OTP';

  if (data.success) {
    if (eTimer) { eTimer.stop(); eTimer = null; }
    document.getElementById('emailDisplay').value = storedNewEmail;
    const emailEl = document.getElementById('profileEmailDisplay');
    if (emailEl) emailEl.textContent = storedNewEmail;
    resetEmailFlow();
    document.getElementById('emailChangeBox').classList.add('hidden');
    showToast('Email updated successfully!', 'success');
    return;
  }

  eAttempts++;
  eOtp.setError();
  setErr('emailOtpErr', data.message || 'Invalid OTP');
  showToast(data.message || 'Invalid OTP', 'error');
  setTimeout(() => { if (eOtp) eOtp.clear(); }, 600);

  const eMaxHit = eAttempts >= 5 || data.message?.toLowerCase().includes('too many');
  if (eMaxHit) {
    eLocked = true;
    eOtp.disable();
    btn.disabled = true;
    if (eResend <= 0) {
      setErr('emailOtpErr', 'Too many attempts. Redirecting...');
      if (eTimer) { eTimer.stop(); eTimer = null; }
      showToast('All attempts used. Redirecting...', 'error');
      setTimeout(() => location.href = '/user/profile', 2000);
    } else {
      setErr('emailOtpErr', 'Too many attempts. Wait for timer to expire, then resend.');
    }
  }
});

