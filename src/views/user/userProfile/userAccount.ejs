  const btn = document.getElementById('verifyPasswordOtpBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="bi bi-hourglass-split text-xs"></i> Verifying...';

  const res = await fetch('/user/profile/password/verify-otp', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ otp })
  });
  const data = await res.json();
  btn.disabled = false;
  btn.innerHTML = '<i class="bi bi-check-circle text-xs"></i> Verify &amp; Change';

  if (data.success) {
    if (pTimer) { pTimer.stop(); pTimer = null; }
    showToast('Password updated successfully!', 'success');
    setTimeout(() => { closeModal('changePasswordModal'); resetPwModal(); }, 900);
    return;
  }

  pAttempts++;
  pOtp.setError();
  setErr('passwordOtpErr', data.message || 'Invalid OTP');
  showToast(data.message || 'Invalid OTP', 'error');
  setTimeout(() => { if (pOtp) pOtp.clear(); }, 600);

  const pMaxHit = pAttempts >= 5 || data.message?.toLowerCase().includes('too many');
  if (pMaxHit) {
    pLocked = true;
    pOtp.disable();
    btn.disabled = true;
    if (pResend <= 0) {
      setErr('passwordOtpErr', 'Too many attempts. Redirecting...');
      if (pTimer) { pTimer.stop(); pTimer = null; }
      showToast('All attempts used. Redirecting...', 'error');
      setTimeout(() => location.href = '/user/profile', 2000);
    } else {
      setErr('passwordOtpErr', 'Too many attempts. Wait for timer to expire, then resend.');
    }
  }
});

['currentPassword','newPasswordPw','confirmPasswordPw'].forEach(id =>
  document.getElementById(id)?.addEventListener('input', () => clearErr(id + 'Err'))
);

let cropInst;

document.getElementById('changePhotoBtn').onclick = () =>
  document.getElementById('avatarInput').click();

document.getElementById('avatarInput').addEventListener('change', e => {
  const file = e.target.files[0]; if (!file) return;
  e.target.value = '';
  const reader = new FileReader();
  reader.onload = () => {
    if (cropInst) { cropInst.destroy(); cropInst = null; }
    openModal('cropModal');
    setTimeout(() => {
      const img = document.getElementById('cropImage');
      img.src = reader.result;
      img.onload = () => {
        cropInst = new Cropper(img, {
          aspectRatio: 1, viewMode: 1, autoCropArea: 0.9,
          background: false, responsive: true
        });
      };
    }, 80);
  };
  reader.readAsDataURL(file);
});

function cancelCrop() {
  if (cropInst) { cropInst.destroy(); cropInst = null; }
  closeModal('cropModal');
}
document.getElementById('cropCancelX').onclick   = cancelCrop;
document.getElementById('cropCancelBtn').onclick = cancelCrop;

document.getElementById('cropSave').onclick = async () => {
  if (!cropInst) return;
  const btn = document.getElementById('cropSave');
  btn.disabled = true;
  btn.innerHTML = '<i class="bi bi-hourglass-split text-xs"></i> Uploading...';
  cropInst.getCroppedCanvas({ width: 400, height: 400 }).toBlob(async blob => {
    const formData = new FormData();
    formData.append('avatar', new File([blob], 'profile.png', { type: 'image/png' }));
    try {
      const res  = await fetch('/user/profile/avatar/ajax', { method: 'POST', body: formData });
      const data = await res.json();
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check text-xs"></i> Use Photo';
      if (data.success) {
        const url = data.profileImage || URL.createObjectURL(blob);
        document.getElementById('avatarPreviewModal').src = url;
        document.getElementById('avatarPreviewMain').src  = url;
        cancelCrop();
        showToast('Profile photo updated!', 'success');
        const removeBtn = document.getElementById('removePhotoBtn');
        if (removeBtn) { removeBtn.style.display = ''; removeBtn.disabled = false; }
      } else {
        showToast(data.message || 'Upload failed');
        cancelCrop();
      }
    } catch (err) {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check text-xs"></i> Use Photo';
      showToast('Upload failed. Try again.');
      cancelCrop();
    }
  }, 'image/png');
};
</script>

