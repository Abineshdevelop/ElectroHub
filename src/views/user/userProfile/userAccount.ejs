async function sendEmailOtpToServer(email, isResend) {
  const res  = await fetch('/user/profile/email/request-otp', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ newEmail: email, isResend })
  });
  const data = await res.json();
  return { ok: data.success, message: data.message || 'Could not send OTP' };
}

function startEmailTimer() {
  if (eTimer) { eTimer.stop(); eTimer = null; }
  const resendBtn = document.getElementById('resendEmailOtpBtn');
  const verifyBtn = document.getElementById('verifyOtpBtn');
  resendBtn.classList.add('hidden');
