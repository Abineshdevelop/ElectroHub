document.querySelectorAll('.pw-eye').forEach(eye => {
  eye.addEventListener('click', () => {
    const inp = document.getElementById(eye.dataset.target);
    if (!inp) return;
    inp.type = inp.type === 'password' ? 'text' : 'password';
    eye.classList.toggle('bi-eye-slash', inp.type === 'password');
    eye.classList.toggle('bi-eye',       inp.type === 'text');
  });
});


function makeTimer(textId, badgeId, onDone) {
  let secs = 120, tid = null;
  function render() {
    const el  = document.getElementById(textId);
    const bdg = document.getElementById(badgeId);
    if (!el) return;
    el.textContent = Math.floor(secs / 60) + ':' + String(secs % 60).padStart(2, '0');
    if (bdg) {
      bdg.className = 'timer-badge' + (secs <= 30 ? ' danger' : secs <= 60 ? ' warning' : '');
    }
  }
  return {
    start() {
      secs = 120; clearInterval(tid); render();
      tid = setInterval(() => {
        secs--; render();
        if (secs <= 0) { clearInterval(tid); tid = null; if (onDone) onDone(); }
      }, 1000);
    },
    stop() { clearInterval(tid); tid = null; }
  };
}


function initOtpBoxes(containerId) {
  const container = document.getElementById(containerId);
  const boxes = Array.from(container.querySelectorAll('.otp-box'));

  boxes.forEach((box, i) => {
    const fresh = box.cloneNode(true);
    fresh.value = '';
    fresh.disabled = false;
    fresh.classList.remove('otp-error');
    box.parentNode.replaceChild(fresh, box);
    boxes[i] = fresh;
  });

  boxes.forEach((box, i) => {
    box.addEventListener('keydown', e => {
      if (e.key === 'Backspace') {
        e.preventDefault();
        if (box.value) { box.value = ''; }
        else if (i > 0) { boxes[i-1].focus(); boxes[i-1].value = ''; }
      } else if (e.key === 'ArrowLeft'  && i > 0)              { boxes[i-1].focus(); e.preventDefault(); }
        else if (e.key === 'ArrowRight' && i < boxes.length-1) { boxes[i+1].focus(); e.preventDefault(); }
    });
    box.addEventListener('input', e => {
      const v = e.target.value.replace(/\D/g, '');
      if (v.length > 1) {
        v.split('').forEach((c, j) => { if (boxes[i+j]) boxes[i+j].value = c; });
        boxes[Math.min(i + v.length, boxes.length - 1)].focus();
      } else {
        box.value = v;
        if (v && i < boxes.length - 1) boxes[i+1].focus();
      }
    });
    box.addEventListener('paste', e => {
      e.preventDefault();
      const p = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g,'');
      p.split('').forEach((c, j) => { if (boxes[j]) boxes[j].value = c; });
      boxes[Math.min(p.length, boxes.length - 1)].focus();
    });
  });

  return {
    get()        { return boxes.map(b => b.value).join(''); },
    setError()   { boxes.forEach(b => b.classList.add('otp-error')); },
    clearError() { boxes.forEach(b => b.classList.remove('otp-error')); },
    disable()    { boxes.forEach(b => b.disabled = true); },
    enable()     { boxes.forEach(b => { b.disabled = false; b.classList.remove('otp-error'); }); },
    clear()      { boxes.forEach(b => { b.value = ''; b.classList.remove('otp-error'); }); if (boxes[0] && !boxes[0].disabled) boxes[0].focus(); }
  };
}

const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
const nameRegex  = /^[A-Za-z ]{1,30}$/;

let isSavingProfile = false;

document.getElementById('editProfileForm').addEventListener('submit', async e => {
  e.preventDefault();
  if (isSavingProfile) return;
  clearErr('firstNameErr'); clearErr('lastNameErr');
  const fn = document.getElementById('firstName').value.trim();
  const ln = document.getElementById('lastName').value.trim();
  let ok = true;
  if (!fn)                      { setErr('firstNameErr', 'First name is required'); ok = false; }
  else if (!nameRegex.test(fn)) { setErr('firstNameErr', 'Only letters allowed — no numbers or symbols'); ok = false; }
  if (!ln)                      { setErr('lastNameErr', 'Last name is required'); ok = false; }
  else if (!nameRegex.test(ln)) { setErr('lastNameErr', 'Only letters allowed — no numbers or symbols'); ok = false; }
  if (!ok) return;

  isSavingProfile = true;
  const btn = document.getElementById('saveProfileBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="bi bi-hourglass-split text-xs"></i> Saving...';
  const res  = await fetch('/user/profile/update', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ firstName: fn, lastName: ln })
  });
  const data = await res.json();
  btn.disabled = false;
  btn.innerHTML = '<i class="bi bi-floppy text-xs"></i> Save Changes';
  isSavingProfile = false;
  if (data.success) {
    const nameEl = document.getElementById('profileNameDisplay');
    if (nameEl) nameEl.textContent = fn + ' ' + ln;
    closeModal('editModal');
    showToast('Profile updated!', 'success');
  } else {
    showToast(data.message || 'Update failed');
  }
});

['firstName', 'lastName'].forEach(id => {
  const el = document.getElementById(id);
