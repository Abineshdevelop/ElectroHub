  eTimer = makeTimer('emailTimerText', 'emailTimerBadge', () => {
    if (eOtp) eOtp.disable();
    verifyBtn.disabled = true;
    if (eResend > 0) {
      resendBtn.innerHTML = `<i class="bi bi-arrow-clockwise text-xs"></i> Resend OTP (<span id="emailResendCount">${eResend}</span> left)`;
      resendBtn.disabled = false;
      resendBtn.classList.remove('hidden');
    } else {
      showToast('All resend attempts used. Redirecting...', 'error');
      setTimeout(() => location.href = '/user/profile', 2000);
    }
  });
