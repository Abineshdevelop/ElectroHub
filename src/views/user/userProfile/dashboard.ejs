<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ElectroHub - Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: { extend: { fontFamily: { inter: ['Inter', 'sans-serif'] } } }
    }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; }

    .nav-underline { position: relative; }
    .nav-underline::after {
      content: '';
      position: absolute;
      width: 0;
      height: 2px;
      bottom: -2px;
      left: 0;
      background-color: #dc3545;
      transition: width 0.3s ease;
    }
    .nav-underline:hover::after { width: 100%; }

    .dropdown-anim {
      animation: fadeInDown 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(10px) scale(0.97); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    #mobile-sidebar {
      transform: translateX(-100%);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    #mobile-sidebar.open { transform: translateX(0); }

    #sidebar-overlay {
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }
    #sidebar-overlay.open {
      opacity: 1;
      pointer-events: all;
    }

    #mobile-cat-list {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }
    #mobile-cat-list.open { max-height: 200px; }

    @keyframes truckMove {
      0%, 100% { transform: translateX(0px); }
      50% { transform: translateX(10px); }
    }
    .truck-icon { animation: truckMove 2s ease-in-out infinite; }

    .tracking-banner {
      background: linear-gradient(135deg, #71c5b4 0%, #4db6a8 50%, #3aa99c 100%);
      position: relative;
      overflow: hidden;
    }
    .tracking-banner::before {
      content: '';
      position: absolute;
      top: -50%; right: -10%;
      width: 300px; height: 300px;
      background: rgba(255,255,255,0.08);
      border-radius: 50%;
    }
    .tracking-banner::after {
      content: '';
      position: absolute;
      bottom: -60%; right: 15%;
      width: 200px; height: 200px;
      background: rgba(255,255,255,0.05);
      border-radius: 50%;
    }

    .sidebar-desktop { overflow-y: auto; }

    /* ── Glassmorphism cards ── */
    .glass-card {
      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.55);
      border-radius: 24px;
      box-shadow:
        0 8px 32px rgba(99, 102, 241, 0.08),
        0 2px 8px rgba(0, 0, 0, 0.04),
        inset 0 1px 0 rgba(255,255,255,0.9);
      overflow: hidden;
      transition: box-shadow 0.3s ease, transform 0.3s ease;
    }
    .glass-card:hover {
      box-shadow:
        0 16px 48px rgba(99, 102, 241, 0.13),
        0 4px 16px rgba(0, 0, 0, 0.07),
        inset 0 1px 0 rgba(255,255,255,0.9);
      transform: translateY(-2px);
    }

    /* Card gradient header */
    .glass-header-blue {
      background: linear-gradient(135deg, #6366f1 0%, #818cf8 100%);
    }
    .glass-header-red {
      background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
    }

    /* Info rows inside glass card */
    .glass-row {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 12px 0;
      border-bottom: 1px solid rgba(0,0,0,0.05);
    }
    .glass-row:last-of-type { border-bottom: none; }

    .glass-icon {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 15px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    /* Glass button */
.glass-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 20px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 600;
  border: 1px solid transparent;
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  transition: all 0.2s ease;
  box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
}
.glass-btn:hover {
  background: linear-gradient(135deg, #ef4444, #f87171);
  transform: translateY(-1px);
  color: #fff;
}
.glass-btn-red {
  background: linear-gradient(135deg, #ef4444, #f87171);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 4px 14px rgba(239, 68, 68, 0.35);
}
.glass-btn-red:hover {
  background: linear-gradient(135deg, #dc2626, #ef4444);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 6px 20px rgba(239, 68, 68, 0.45);
  transform: translateY(-1px);
}
  </style>
</head>

<body class="bg-gray-50 text-gray-800">

  <%- include('../partials/navbar', { user }) %>

  <div class="flex min-h-[calc(100vh-64px)]">

    <%- include('../partials/sidebar', { user, activePage: 'dashboard' }) %>

    <main class="flex-1 px-4 md:px-8 py-6 md:py-8 overflow-x-hidden">

      <h2 class="text-2xl md:text-3xl font-bold mb-6">Hello, <%= user?.firstName %> 👋</h2>

      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-8">
        <div class="flex items-center gap-3 bg-blue-50 text-blue-600 rounded-2xl p-4 md:p-5 hover:-translate-y-1 transition-transform duration-300">
          <i class="bi bi-rocket-takeoff text-2xl md:text-3xl"></i>
          <div>
            <h3 class="text-xl md:text-2xl font-bold leading-none"><%= stats?.totalOrders || 0 %></h3>
            <small class="text-xs md:text-sm">Total Orders</small>
          </div>
        </div>
        <div class="flex items-center gap-3 bg-orange-50 text-orange-500 rounded-2xl p-4 md:p-5 hover:-translate-y-1 transition-transform duration-300">
          <i class="bi bi-hourglass-split text-2xl md:text-3xl"></i>
          <div>
            <h3 class="text-xl md:text-2xl font-bold leading-none"><%= stats?.pendingOrders || 0 %></h3>
            <small class="text-xs md:text-sm">Pending Orders</small>
          </div>
        </div>
        <div class="col-span-2 md:col-span-1 flex items-center gap-3 bg-green-50 text-green-600 rounded-2xl p-4 md:p-5 hover:-translate-y-1 transition-transform duration-300">
          <i class="bi bi-check2-circle text-2xl md:text-3xl"></i>
          <div>
            <h3 class="text-xl md:text-2xl font-bold leading-none"><%= stats?.completedOrders || 0 %></h3>
            <small class="text-xs md:text-sm">Completed Orders</small>
          </div>
        </div>
      </div>

      <!-- Info Cards -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-8">

        <!-- ── Account Info ── -->
        <div class="glass-card">

          <!-- Gradient header -->
          <div class="glass-header-blue px-6 py-5 flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-white/20 backdrop-blur flex items-center justify-center shadow-inner">
              <i class="bi bi-person-circle text-white text-2xl"></i>
            </div>
            <div>
              <p class="font-bold text-white text-base leading-tight">Account Info</p>
              <p class="text-white/70 text-xs mt-0.5">Your personal details</p>
            </div>
          </div>

          <!-- Rows -->
          <div class="px-6 py-3">

            <div class="glass-row">
              <div class="glass-icon bg-purple-50 text-purple-500">
                <i class="bi bi-person text-sm"></i>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Full Name</p>
                <p class="text-sm font-semibold text-gray-800 mt-0.5">
                  <%= user?.firstName %> <%= user?.lastName %>
                </p>
              </div>
            </div>

            <div class="glass-row">
              <div class="glass-icon bg-blue-50 text-blue-500">
                <i class="bi bi-envelope text-sm"></i>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Email</p>
                <p class="text-sm font-semibold text-gray-800 truncate mt-0.5">
                  <%= user?.email || '-' %>
                </p>
              </div>
            </div>

            <div class="glass-row">
              <div class="glass-icon bg-green-50 text-green-500">
                <i class="bi bi-telephone text-sm"></i>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Phone</p>
                <p class="text-sm font-semibold text-gray-800 mt-0.5">
                  <%= user?.phone || '-' %>
                </p>
              </div>
            </div>

          </div>

          <!-- Footer -->
          <div class="px-6 pb-6 pt-2">
            <a href="/user/profile" class="glass-btn">
              <i class="bi bi-pencil-square text-xs"></i> Edit Profile
            </a>
          </div>
        </div>

        <!-- ── Default Shipping Address ── -->
        <div class="glass-card">

          <!-- Gradient header -->
          <div class="glass-header-red px-6 py-5 flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-white/20 backdrop-blur flex items-center justify-center shadow-inner">
              <i class="bi bi-geo-alt text-white text-2xl"></i>
            </div>
            <div>
              <p class="font-bold text-white text-base leading-tight">Default Shipping Address</p>
              <p class="text-white/70 text-xs mt-0.5">Used for order delivery</p>
            </div>
          </div>

          <% if (defaultAddress) { %>

            <!-- Rows -->
            <div class="px-6 py-3">

              <div class="glass-row">
                <div class="glass-icon bg-red-50 text-red-400">
                  <i class="bi bi-person text-sm"></i>
                </div>
                <div>
                  <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Recipient</p>
                  <p class="text-sm font-semibold text-gray-800 mt-0.5">
                    <%= defaultAddress.firstName %> <%= defaultAddress.lastName %>
                  </p>
                </div>
              </div>

              <div class="glass-row">
                <div class="glass-icon bg-blue-50 text-blue-400">
                  <i class="bi bi-telephone text-sm"></i>
                </div>
                <div>
                  <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Phone</p>
                  <p class="text-sm font-semibold text-gray-800 mt-0.5">
                    <%= defaultAddress.phone %>
                  </p>
                </div>
              </div>

              <div class="glass-row">
                <div class="glass-icon bg-orange-50 text-orange-400">
                  <i class="bi bi-map text-sm"></i>
                </div>
                <div>
                  <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Address</p>
                  <p class="text-sm font-semibold text-gray-800 leading-relaxed mt-0.5">
                    <%= defaultAddress.address %>, <%= defaultAddress.street %>,
                    <%= defaultAddress.state %>, <%= defaultAddress.country %> – <%= defaultAddress.pincode %>
                  </p>
                </div>
              </div>

            </div>

            <!-- Footer -->
            <div class="px-6 pb-6 pt-2">
              <a href="/user/address" class="glass-btn">
                <i class="bi bi-arrow-repeat text-xs"></i> Change Address
              </a>
            </div>

          <% } else { %>

            <!-- Empty state -->
            <div class="px-6 py-10 flex flex-col items-center text-center">
              <div class="w-16 h-16 rounded-2xl bg-red-50 flex items-center justify-center mb-4 shadow-inner">
                <i class="bi bi-geo-alt text-red-400 text-2xl"></i>
              </div>
              <p class="text-sm font-bold text-gray-700 mb-1">No default address</p>
              <p class="text-xs text-gray-400 mb-5">Add a delivery address to get started</p>
              <a href="/user/address" class="glass-btn glass-btn-red">
                <i class="bi bi-plus-lg text-xs"></i> Add Address
              </a>
            </div>

          <% } %>
        </div>

      </div>

      <!-- Referral Section -->
      <% if (referralToken) { %>
      <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-3xl p-6 mb-8 text-white relative overflow-hidden shadow-xl">
        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-2">
              <span class="bg-white/20 backdrop-blur-md px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest text-white/90">Refer & Earn</span>
              <span class="text-indigo-100 text-xs font-semibold">GET ₹1,000 BONUS PER FRIEND</span>
            </div>
            <h3 class="text-2xl font-bold mb-2">Invite your friends to ElectroHub</h3>
            <p class="text-indigo-100 text-sm max-w-md">
              Share your unique link or code. Both you and your friend get ₹1,000 when they verify their account! You can invite as many friends as you want.
            </p>
          </div>
          
          <div class="w-full md:w-auto flex flex-col gap-3">
             <!-- Plain Code Box -->
             <div class="bg-white/10 backdrop-blur-lg p-4 rounded-2xl border border-white/20 flex flex-col gap-2 min-w-[280px]">
               <p class="text-[10px] text-indigo-100 font-bold uppercase tracking-widest">Referral Code</p>
               <div class="flex items-center justify-between">
                 <span class="text-xl font-mono font-bold tracking-widest"><%= referralToken %></span>
                 <button onclick="copyText('<%= referralToken %>')" class="text-white hover:text-indigo-200 transition-colors">
                   <i class="bi bi-copy"></i>
                 </button>
               </div>
             </div>

             <!-- Link Box -->
             <div class="bg-white/10 backdrop-blur-lg p-4 rounded-2xl border border-white/20 flex flex-col gap-2 min-w-[280px]">
               <p class="text-[10px] text-indigo-100 font-bold uppercase tracking-widest">Invite Link</p>
               <div class="flex gap-2">
                 <div class="bg-white/90 px-4 py-2.5 rounded-xl flex-1 text-indigo-900 font-mono text-xs truncate select-all" id="ref-url-box">
                   <span id="display-url">Loading...</span>
                 </div>
                 <button onclick="copyRefLink()" class="w-10 h-10 rounded-xl bg-white text-indigo-600 flex items-center justify-center hover:bg-indigo-50 transition-all active:scale-95 shadow-lg">
                   <i class="bi bi-link-45deg text-xl"></i>
                 </button>
               </div>
             </div>
          </div>
        </div>
        <!-- Decorative blobs -->
        <div class="absolute -top-12 -right-12 w-48 h-48 bg-white/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-8 -left-8 w-32 h-32 bg-indigo-500/20 rounded-full blur-2xl"></div>
      </div>
      <script>
        function copyText(text) {
           navigator.clipboard.writeText(text).then(() => {
             if (typeof showToast === 'function') showToast('Code copied!', 'success');
           });
        }

        document.addEventListener('DOMContentLoaded', () => {
          const refBox = document.getElementById('display-url');
          if (refBox) {
            const origin = window.location.origin;
            const token = '<%= referralToken %>';
            if (token) {
              refBox.textContent = `${origin}/user/signup?ref=${token}`;
            }
          }
        });

        function copyRefLink() {
          const url = document.getElementById('display-url').textContent.trim();
          navigator.clipboard.writeText(url).then(() => {
            if (typeof showToast === 'function') {
                showToast('Invite link copied!', 'success');
            } else {
                alert('Copied to clipboard!');
            }
          });
        }
      </script>
      <% } %>

      <!-- Tracking Banner -->
      <div class="tracking-banner rounded-3xl p-6 md:p-8 mb-6 flex items-center justify-between gap-4">
        <div class="relative z-10">
          <small class="text-white/75 text-xs font-medium">Order ID #<%= recentOrder?.id || 'N/A' %></small>
          <h2 class="text-white font-bold text-xl md:text-2xl my-2"><%= recentOrder?.status || 'No recent orders' %></h2>
          <p class="text-white/80 text-sm mb-5">Your package is on its way to your destination.</p>
          <button class="bg-white text-gray-800 font-bold text-sm px-6 py-2.5 rounded-full shadow-md hover:shadow-lg hover:scale-105 transition-all duration-200">
            Track Now
          </button>
        </div>
        <div class="relative z-10 hidden sm:block">
          <i class="bi bi-truck text-white/90 truck-icon" style="font-size: 5rem;"></i>
        </div>
      </div>

      <div class="flex">
        <a href="/user/home"
          class="bg-red-600 text-white font-bold text-sm px-8 py-3 rounded-full
                 hover:bg-red-700 hover:shadow-lg hover:shadow-red-200 hover:scale-105
                 transition-all duration-200">
          Continue Shopping
        </a>
      </div>

    </main>
  </div>
  <%- include('../partials/footer') %>
</body>
</html>