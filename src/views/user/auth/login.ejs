<%- include('../partials/auth-header', { title: 'Login' }) %>

<!-- Toast Container -->
<div id="toastContainer" class="fixed top-20 right-5 z-50 space-y-2"></div>

<div class="w-full max-w-6xl bg-white shadow-2xl rounded-xl overflow-hidden flex flex-col md:flex-row">

  <!-- LEFT IMAGE -->
  <div class="w-full md:w-1/2 h-72 md:h-auto">
    <img src="/images/auth/auth-img.jpeg" alt="ElectroHub" class="w-full h-full object-cover">
  </div>

  <!-- RIGHT FORM -->
  <div class="w-full md:w-1/2 p-10 flex flex-col justify-center">
    <h2 class="text-3xl font-bold text-gray-800 mb-2">Login</h2>
    <p class="text-gray-500 text-sm mb-8">Enter your details below</p>

    <form class="space-y-4" id="login-form">

      <!-- IDENTIFIER -->
      <div class="relative pb-5">
        <input type="text" id="identifier" placeholder="Email or Phone Number"
          class="w-full border-b border-gray-300 focus:border-red-500 outline-none py-2 text-base transition-colors">
        <span id="identifierError"
          class="absolute left-0 bottom-0 text-xs text-red-500 invisible h-5 leading-5"></span>
      </div>

      <!-- PASSWORD -->
      <div class="relative pb-5">
        <input type="password" id="password" placeholder="Password"
          class="w-full border-b border-gray-300 focus:border-red-500 outline-none py-2 text-base transition-colors pr-10">
        <button type="button" id="togglePassword"
          class="absolute right-1 top-2 text-gray-400 hover:text-gray-600 transition-colors duration-200"
          tabindex="-1">
          <svg id="lockIcon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none"
            viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8" fill="none"/>
            <path stroke-linecap="round" d="M8 11V7a4 4 0 0 1 8 0v4" />
          </svg>
          <svg id="eyeOpenIcon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none"
            viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
        </button>
        <span id="passwordError"
          class="absolute left-0 bottom-0 text-xs text-red-500 invisible h-5 leading-5"></span>
      </div>

      <!-- FORGOT -->
      <div class="flex justify-end mb-4">
        <a href="/user/forgot-password"
          class="text-sm font-medium text-red-500 relative group transition duration-200">
          Forgot Password?
          <span class="absolute left-0 -bottom-1 w-0 h-[2px] bg-red-500 transition-all duration-300 group-hover:w-full"></span>
        </a>
      </div>

      <button type="submit"
        class="w-full bg-red-500 hover:bg-red-600 text-white font-medium py-3 mt-4 text-sm rounded-md transition shadow-md active:scale-[0.98]">
        Log In
      </button>

      <!-- GOOGLE -->
      <a href="/user/auth/google"
        class="w-full border border-gray-300 py-3 text-sm rounded-md flex items-center justify-center gap-2 hover:bg-gray-50 transition">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-5 h-5">
          <path fill="#FFC107"
            d="M43.6 20.5H42V20H24v8h11.3C33.8 32.6 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3 0 5.8 1.1 8 2.9l5.7-5.7C34.3 6.5 29.5 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z" />
        </svg>
        Log in with Google
      </a>

      <div class="text-center text-sm text-gray-500 mt-4">
        Don't have an account?
        <a href="/user/signup" class="text-red-500 font-semibold hover:underline">
          Create account
        </a>
      </div>

    </form>
  </div>
</div>


<script>
document.addEventListener("DOMContentLoaded", () => {

  const loginForm = document.getElementById("login-form");

  const identifier = document.getElementById("identifier");
  const password = document.getElementById("password");

  const identifierError = document.getElementById("identifierError");
  const passwordError = document.getElementById("passwordError");

  const regex = {
    email: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
    phone: /^\d{10}$/
  };

  let toastTimeout;

  // ===============================
  // PASSWORD TOGGLE
  // ===============================
  const toggleBtn = document.getElementById("togglePassword");
  const lockIcon = document.getElementById("lockIcon");
  const eyeOpenIcon = document.getElementById("eyeOpenIcon");

  toggleBtn.addEventListener("click", () => {
    const isHidden = password.type === "password";
    password.type = isHidden ? "text" : "password";
    lockIcon.classList.toggle("hidden", isHidden);
    eyeOpenIcon.classList.toggle("hidden", !isHidden);
  });

  // ===============================
  // TOAST FUNCTION
  // ===============================
  function showToast(message, type = "error") {
    const container = document.getElementById("toastContainer");
    container.innerHTML = "";

    const toast = document.createElement("div");

    const typeStyle =
      type === "success"
        ? "bg-green-500 text-white"
        : "bg-red-500 text-white";

    toast.className =
      "px-5 py-3 rounded-lg shadow-lg text-sm font-medium " +
      typeStyle;

    toast.textContent = message;
    container.appendChild(toast);

    clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => {
      toast.remove();
    }, 3000);
  }

  // ===============================
  // 🔴 SHOW GOOGLE BLOCKED ERROR (via session flash)
  // ===============================
  <% if (locals.flashError) { %>
    showToast("<%- flashError %>");
  <% } %>

  // ===============================
  // CLEAR ERROR ON TYPING
  // ===============================
  identifier.addEventListener("input", () => {
    identifierError.textContent = "";
    identifierError.classList.add("invisible");
  });

  password.addEventListener("input", () => {
    passwordError.textContent = "";
    passwordError.classList.add("invisible");
  });

  // ===============================
  // SUBMIT
  // ===============================
  loginForm.addEventListener("submit", async (e) => {
    e.preventDefault();

    const idValue = identifier.value.trim();
    const passValue = password.value.trim();

    let isValid = true;

    identifierError.textContent = "";
    passwordError.textContent = "";
    identifierError.classList.add("invisible");
    passwordError.classList.add("invisible");

    if (!regex.email.test(idValue) && !regex.phone.test(idValue)) {
      identifierError.textContent = "Enter valid email or 10-digit phone number";
      identifierError.classList.remove("invisible");
      showToast("Invalid email or phone format");
      isValid = false;
    }

    if (!passValue) {
      passwordError.textContent = "Password is required";
      passwordError.classList.remove("invisible");
      showToast("Password is required");
      isValid = false;
    }

    if (!isValid) return;

    try {
      const res = await fetch("/user/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ identifier: idValue, password: passValue }),
        credentials: "include"
      });

      const data = await res.json();

      if (data.success) {
        showToast("Login successful", "success");
        setTimeout(() => {
          window.location.href = "/user/home";
        }, 800);
      } else {
        passwordError.textContent = data.message;
        passwordError.classList.remove("invisible");
        showToast(data.message || "Login failed");
      }

    } catch (err) {
      passwordError.textContent = "Server error. Try again later.";
      passwordError.classList.remove("invisible");
      showToast("Server error. Try again later.");
    }
  });

});
</script>