<%- include('../partials/auth-header', { title: 'Signup' }) %>

  <div id="toastContainer" class="fixed top-20 right-5 z-50 space-y-2"></div>

  <div class="w-full max-w-6xl bg-white shadow-2xl rounded-xl overflow-hidden flex flex-col md:flex-row">

    <div class="w-full md:w-1/2 h-72 md:h-auto">
      <img src="/images/auth/auth-img.jpeg" alt="ElectroHub" class="w-full h-full object-cover">
    </div>

    <div class="w-full md:w-1/2 p-10 flex flex-col justify-center">

      <h2 class="text-3xl font-bold text-gray-800 mb-2">Create an account</h2>
      <p class="text-gray-500 text-sm mb-8">Enter your details below to get started</p>

      <form class="space-y-1" id="signup-form">

        <div>
          <input type="text" id="firstName" placeholder="First name"
            class="w-full border-b border-gray-300 focus:border-red-500 outline-none py-2 text-base">
          <span id="firstNameError" class="text-xs text-red-500 block h-4 mt-1"></span>
        </div>

        <div>
          <input type="text" id="lastName" placeholder="Last name"
            class="w-full border-b border-gray-300 focus:border-red-500 outline-none py-2 text-base">
          <span id="lastNameError" class="text-xs text-red-500 block h-4 mt-1"></span>
        </div>

        <div>
          <input type="text" id="phone" placeholder="Phone Number"
            class="w-full border-b border-gray-300 focus:border-red-500 outline-none py-2 text-base">
          <span id="phoneError" class="text-xs text-red-500 block h-4 mt-1"></span>
        </div>

        <div class="flex flex-col">
          <input id="email" placeholder="Email"
            class="w-full border-b border-gray-300 focus:border-red-500 outline-none py-2 text-base">
          <span id="emailError" class="text-xs text-red-500 block h-4 mt-1"></span>
        </div>

        <div>
          <div class="relative flex items-center">
            <input type="password" id="password" placeholder="Enter Password"
              class="w-full border-b border-gray-300 focus:border-red-500 outline-none py-2 text-base pr-10">
            <button type="button" id="togglePassword"
              class="absolute right-1 text-gray-400 hover:text-gray-600 transition-colors duration-200" tabindex="-1">
              <!-- Lock icon (default / password hidden) -->
              <svg id="lockIcon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24"
                stroke="currentColor" stroke-width="1.8">
                <rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8" fill="none" />
                <path stroke-linecap="round" d="M8 11V7a4 4 0 0 1 8 0v4" />
              </svg>
              <!-- Eye icon (password visible) -->
              <svg id="eyeOpenIcon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none"
                viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
          <span id="passwordError" class="text-xs text-red-500 block h-4 mt-1"></span>
        </div>

        <div>
          <div class="relative flex items-center">
            <input type="password" id="confirmPassword" placeholder="Confirm Password"
              class="w-full border-b border-gray-300 focus:border-red-500 outline-none py-2 text-base pr-10">
            <button type="button" id="toggleConfirmPassword"
              class="absolute right-1 text-gray-400 hover:text-gray-600 transition-colors duration-200" tabindex="-1">
              <!-- Lock icon (default / password hidden) -->
              <svg id="lockIconConfirm" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none"
                viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8" fill="none" />
                <path stroke-linecap="round" d="M8 11V7a4 4 0 0 1 8 0v4" />
              </svg>
              <!-- Eye icon (password visible) -->
              <svg id="eyeOpenIconConfirm" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none"
                viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
          <span id="confirmPasswordError" class="text-xs text-red-500 block h-4 mt-1"></span>
        </div>

        <div class="relative group">
           <input type="text" id="referralCode" placeholder="Referral Code (Optional)"
             class="w-full border-b border-gray-300 focus:border-red-500 outline-none py-2 text-base pr-20 uppercase">
           <button type="button" id="checkReferralBtn" class="absolute right-0 top-1.5 text-xs font-bold text-red-500 hover:text-red-600 bg-red-50 px-3 py-1 rounded-full transition-all active:scale-95 shadow-sm">
             Check
           </button>
           <span id="referralError" class="text-xs text-red-500 block h-4 mt-1"></span>
        </div>

        <p id="successMessage" class="text-green-600 text-sm text-center h-4"></p>

        <button id="signupBtn" type="submit"
          class="w-full text-white font-medium py-3 mt-4 text-sm rounded-md transition duration-200 bg-red-500">
          Create Account
        </button>

        <a href="/user/auth/google"
          class="w-full border border-gray-300 py-3 mt-4 text-sm rounded-md flex items-center justify-center gap-2 hover:bg-gray-50 transition">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-5 h-5">
            <path fill="#FFC107"
              d="M43.6 20.5H42V20H24v8h11.3C33.8 32.6 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3 0 5.8 1.1 8 2.9l5.7-5.7C34.3 6.5 29.5 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z" />
          </svg>
          Log in with Google
        </a>

        <div class="text-center text-sm text-gray-500 mt-6">
          Already have account?
          <a href="/user/login" class="text-red-500 font-semibold hover:underline">
            Log in
          </a>
        </div>

      </form>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {

      function showToast(message, type = "error") {
        const toast = document.createElement("div");
        const baseStyle = `px-5 py-3 rounded-lg shadow-lg text-sm font-medium transition-all duration-300 transform translate-x-5 opacity-0`;
        const typeStyle = type === "success" ? "bg-green-500 text-white" : "bg-red-500 text-white";

        toast.className = baseStyle + " " + typeStyle;
        toast.textContent = message;

        const container = document.getElementById("toastContainer");
        container.appendChild(toast);

        setTimeout(() => toast.classList.remove("translate-x-5", "opacity-0"), 50);

        setTimeout(() => {
          toast.classList.add("opacity-0", "translate-x-5");
          setTimeout(() => toast.remove(), 300);
        }, 2500);
      }

      // Password toggle logic
      function setupToggle(toggleBtnId, inputId, lockIconId, eyeIconId) {
        const toggleBtn = document.getElementById(toggleBtnId);
        const input = document.getElementById(inputId);
        const lockIcon = document.getElementById(lockIconId);
        const eyeIcon = document.getElementById(eyeIconId);

        toggleBtn.addEventListener("click", () => {
          const isHidden = input.type === "password";
          input.type = isHidden ? "text" : "password";
          lockIcon.classList.toggle("hidden", isHidden);
          eyeIcon.classList.toggle("hidden", !isHidden);
        });
      }

      setupToggle("togglePassword", "password", "lockIcon", "eyeOpenIcon");
      setupToggle("toggleConfirmPassword", "confirmPassword", "lockIconConfirm", "eyeOpenIconConfirm");

      const form = document.getElementById("signup-form");
      const btn = document.getElementById("signupBtn");

      let otpLock = false;

      const fields = {
        firstName: document.getElementById("firstName"),
        lastName: document.getElementById("lastName"),
        phone: document.getElementById("phone"),
        email: document.getElementById("email"),
        password: document.getElementById("password"),
        confirmPassword: document.getElementById("confirmPassword"),
        referralCode: document.getElementById("referralCode"),
      };

      const errors = {
        firstName: document.getElementById("firstNameError"),
        lastName: document.getElementById("lastNameError"),
        phone: document.getElementById("phoneError"),
        email: document.getElementById("emailError"),
        password: document.getElementById("passwordError"),
        confirmPassword: document.getElementById("confirmPasswordError"),
        referralCode: document.getElementById("referralError"),
      };

      const regex = {
        firstName: /^[A-Za-z]{2,50}$/,
        lastName: /^[A-Za-z]{1,50}$/,
        phone: /^\d{10}$/,
        email: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
        password: /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&]).{8,}$/,
        referralCode: /^[A-Z0-9]{4,12}$/i,
      };

      function validateField(name, value) {
        switch (name) {
          case "firstName":
            return regex.firstName.test(value) ? "" : "Invalid first name";
          case "lastName":
            return regex.lastName.test(value) ? "" : "Invalid last name";
          case "phone":
            return regex.phone.test(value) ? "" : "Invalid phone number";
          case "email":
            return regex.email.test(value) ? "" : "Invalid email";
          case "password":
            return regex.password.test(value) ? "" : "Weak password";
          case "confirmPassword":
            return value === fields.password.value.trim() ? "" : "Passwords do not match";
          default:
            return "";
        }
      }

      // Auto-fill referral from URL
      const urlParams = new URLSearchParams(window.location.search);
      const refToken = urlParams.get('ref');
      if (refToken) {
        fields.referralCode.value = refToken.toUpperCase();
        showToast('Referral code applied from link!', 'success');
      }

      // Check Referral Button
      const checkBtn = document.getElementById('checkReferralBtn');
      checkBtn.addEventListener('click', async () => {
        const code = fields.referralCode.value.trim();
        if (!code) {
          showToast('Enter a code first', 'info');
          return;
        }

        checkBtn.disabled = true;
        checkBtn.innerHTML = '<i class="bi bi-hourglass-split animate-spin"></i>';

        try {
          const res = await fetch('/user/validate-referral', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code })
          });
          const data = await res.json();
          if (data.success) {
            showToast(data.message, 'success');
            errors.referralCode.className = "text-xs text-green-500 block h-4 mt-1";
            errors.referralCode.textContent = "✓ " + data.message;
          } else {
            showToast(data.message, 'error');
            errors.referralCode.className = "text-xs text-red-500 block h-4 mt-1";
            errors.referralCode.textContent = data.message;
          }
        } catch (err) {
          showToast('Validation failed', 'error');
        } finally {
          checkBtn.disabled = false;
          checkBtn.innerHTML = 'Check';
        }
      });

      // Live validation
      Object.keys(fields).forEach((key) => {
        fields[key].addEventListener("input", () => {
          if (key === 'referralCode') {
             fields[key].value = fields[key].value.toUpperCase();
             errors.referralCode.textContent = ""; // clear message on edit
             return; 
          }
          const value = fields[key].value.trim();
          const error = validateField(key, value);
          if (errors[key]) errors[key].textContent = error;
        });
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (otpLock) return;

        let isValid = true;
        const values = {};

        Object.keys(fields).forEach((key) => {
          const value = fields[key].value.trim();
          values[key] = value;

          const error = validateField(key, value);
          errors[key].textContent = error;
          if (error) isValid = false;
        });

        if (!isValid) return;

        otpLock = true;
        btn.disabled = true;
        btn.className = "w-full text-white font-medium py-3 mt-4 text-sm rounded-md bg-yellow-500";
        btn.innerHTML = "Creating account...";

        try {
          const res = await fetch("/user/signup", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(values),
          });

          const data = await res.json();

          if (!data.success) {
            showToast(data.message || "Signup failed", "error");
            throw new Error(data.message);
          }

          showToast("OTP sent to your email", "success");

          localStorage.setItem("signupUserId", data.userId);

          setTimeout(() => {
            window.location.href = "/user/signup-otp?userId=" + data.userId;
          }, 2000);

        } catch (err) {
          btn.disabled = false;
          btn.className = "w-full text-white font-medium py-3 mt-4 text-sm rounded-md bg-red-500";
          btn.innerHTML = "Create Account";
          otpLock = false;
        }
      });
    });
  </script>

  <%- include('../partials/auth-footer') %>