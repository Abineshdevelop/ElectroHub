<%- include('../partials/auth-header', { title: 'Reset Password' }) %>

<!-- Toast Container -->
<div id="toastContainer"
     class="fixed top-20 right-5 z-50 space-y-2"></div>

<div class="w-full max-w-sm text-center">

    <h2 class="text-xl font-semibold text-gray-800 mb-10">
        Reset Password
    </h2>

    <form id="resetForm" class="space-y-6">

        <!-- Password -->
        <div class="relative pb-5">
            <input 
                id="password"
                type="password" 
                placeholder="Enter Password" 
                class="w-full border-b border-gray-300 
                focus:border-red-500 outline-none 
                py-2 text-sm bg-transparent transition pr-10">

            <button type="button" id="togglePassword"
                class="absolute right-1 top-2 text-gray-400 hover:text-gray-600 transition-colors duration-200"
                tabindex="-1">
                <svg id="lockIcon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none"
                    viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8" fill="none"/>
                    <path stroke-linecap="round" d="M8 11V7a4 4 0 0 1 8 0v4" />
                </svg>
                <svg id="eyeOpenIcon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none"
                    viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
            </button>

            <span id="passwordError"
                  class="absolute left-0 bottom-0 text-xs text-red-500 invisible h-5">
            </span>
        </div>

        <!-- Confirm Password -->
        <div class="relative pb-5">
            <input 
                id="confirmPassword"
                type="password" 
                placeholder="Confirm Password" 
                class="w-full border-b border-gray-300 
                focus:border-red-500 outline-none 
                py-2 text-sm bg-transparent transition pr-10">

            <button type="button" id="toggleConfirmPassword"
                class="absolute right-1 top-2 text-gray-400 hover:text-gray-600 transition-colors duration-200"
                tabindex="-1">
                <svg id="lockIconConfirm" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none"
                    viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8" fill="none"/>
                    <path stroke-linecap="round" d="M8 11V7a4 4 0 0 1 8 0v4" />
                </svg>
                <svg id="eyeOpenIconConfirm" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none"
                    viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
            </button>

            <span id="confirmPasswordError"
                  class="absolute left-0 bottom-0 text-xs text-red-500 invisible h-5">
            </span>
        </div>

        <!-- Submit Button -->
        <button 
            id="resetBtn"
            type="submit" 
            class="w-full bg-red-500 hover:bg-red-600 
            text-white py-2 text-sm 
            rounded-md transition shadow-md">
            Reset Password
        </button>

    </form>

</div>

<script>
document.addEventListener("DOMContentLoaded", () => {

  const form = document.getElementById("resetForm");
  const btn = document.getElementById("resetBtn");

  const passwordInput = document.getElementById("password");
  const confirmInput = document.getElementById("confirmPassword");

  const passwordError = document.getElementById("passwordError");
  const confirmError = document.getElementById("confirmPasswordError");

  const userId = "<%= userId %>";

  let requestLock = false;

  // ==============================
  // PASSWORD TOGGLE
  // ==============================

  function setupToggle(toggleBtnId, inputId, lockIconId, eyeIconId) {
    const toggleBtn = document.getElementById(toggleBtnId);
    const input = document.getElementById(inputId);
    const lockIcon = document.getElementById(lockIconId);
    const eyeIcon = document.getElementById(eyeIconId);

    toggleBtn.addEventListener("click", () => {
      const isHidden = input.type === "password";
      input.type = isHidden ? "text" : "password";
      lockIcon.classList.toggle("hidden", isHidden);
      eyeIcon.classList.toggle("hidden", !isHidden);
    });
  }

  setupToggle("togglePassword", "password", "lockIcon", "eyeOpenIcon");
  setupToggle("toggleConfirmPassword", "confirmPassword", "lockIconConfirm", "eyeOpenIconConfirm");

  // ==============================
  // 🔔 TOAST FUNCTION
  // ==============================

  function showToast(message, type = "error") {

    const toast = document.createElement("div");

    const baseStyle =
      "px-5 py-3 rounded-lg shadow-lg text-sm font-medium transition-all duration-300 transform translate-x-5 opacity-0";

    const typeStyle =
      type === "success"
        ? "bg-green-500 text-white"
        : "bg-red-500 text-white";

    toast.className = baseStyle + " " + typeStyle;
    toast.textContent = message;

    const container = document.getElementById("toastContainer");
    container.appendChild(toast);

    setTimeout(() => {
      toast.classList.remove("translate-x-5", "opacity-0");
    }, 50);

    setTimeout(() => {
      toast.classList.add("opacity-0", "translate-x-5");
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }

  // ==============================
  // CLEAR ERRORS ON INPUT
  // ==============================

  const strongPassword =
    /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&]).{8,}$/;

  function hideFieldError(el) {
    el.classList.add("invisible");
    el.textContent = "";
  }

  function liveValidateResetPassword() {
    const password = passwordInput.value.trim();
    const confirmPassword = confirmInput.value.trim();

    if (!password) hideFieldError(passwordError);
    else if (strongPassword.test(password)) hideFieldError(passwordError);

    if (!confirmPassword) hideFieldError(confirmError);
    else if (password && confirmPassword === password) hideFieldError(confirmError);
    else if (password && confirmPassword !== password) {
      confirmError.textContent = "Passwords do not match";
      confirmError.classList.remove("invisible");
    }
  }

  passwordInput.addEventListener("input", liveValidateResetPassword);
  confirmInput.addEventListener("input", liveValidateResetPassword);

  // ==============================
  // 🔐 SUBMIT LOGIC
  // ==============================

  form.addEventListener("submit", async (e) => {

    e.preventDefault();

    if (requestLock) return;

    const password = passwordInput.value.trim();
    const confirmPassword = confirmInput.value.trim();

    let isValid = true;

    passwordError.classList.add("invisible");
    confirmError.classList.add("invisible");

    // Empty check
    if (!password) {
      passwordError.textContent = "Password is required";
      passwordError.classList.remove("invisible");
      showToast("Password is required");
      isValid = false;
    }

    // Strong password validation
    else if (!strongPassword.test(password)) {
      passwordError.textContent =
        "Must contain 8+ chars, uppercase, lowercase, number & special char";
      passwordError.classList.remove("invisible");
      showToast("Weak password format");
      isValid = false;
    }

    // Confirm match
    if (password !== confirmPassword) {
      confirmError.textContent = "Passwords do not match";
      confirmError.classList.remove("invisible");
      showToast("Passwords do not match");
      isValid = false;
    }

    if (!isValid) return;

    requestLock = true;

    // 🟡 Loading state
    btn.disabled = true;
    btn.classList.remove("bg-red-500");
    btn.classList.add("bg-yellow-500");
    btn.innerHTML = "Resetting...";

    try {

      const res = await fetch("/user/reset-password", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ userId, password, confirmPassword })
      });

      const data = await res.json();

      if (!data.success) {

        // Google account safety
        if (data.googleAccount) {
          showToast(data.message);
          setTimeout(() => {
            window.location.href = "/user/login";
          }, 2500);
          return;
        }

        throw new Error(data.message);
      }

      showToast("Password reset successful!", "success");

      setTimeout(() => {
        window.location.replace(data.redirect);
      }, 3000);

    } catch (err) {

      showToast(err.message || "Something went wrong");

      btn.disabled = false;
      btn.classList.remove("bg-yellow-500");
      btn.classList.add("bg-red-500");
      btn.innerHTML = "Reset Password";

      requestLock = false;
    }

  });

});
</script>

<%- include('../partials/auth-footer') %>