<%- include('../partials/auth-header', { title: 'Forgot Password' }) %>

<!-- Toast Container -->
<div id="toastContainer"
     class="fixed top-20 right-5 z-50 space-y-2"></div>

<div class="w-full max-w-sm text-center">

    <h2 class="text-xl font-semibold text-gray-800 mb-10">
        Forgot Password
    </h2>

    <form id="forgot-form" class="space-y-6">

        <!-- Email -->
        <div class="relative pb-5">
            <input 
                type="text" 
                id="email" 
                placeholder="Email"
                class="w-full border-b border-gray-300 
                       focus:border-red-500 outline-none 
                       py-2 text-sm bg-transparent transition">

            <span id="emailError"
                  class="absolute left-0 bottom-0 text-xs text-red-500 invisible h-5">
            </span>
        </div>

        <!-- Send OTP Button -->
        <button id="forgotBtn"
            type="submit"
            class="w-full bg-red-500 hover:bg-red-600 text-white font-medium 
                   py-3 mt-4 text-sm rounded-md transition shadow-md">
            Send OTP
        </button>

        <!-- Login Link -->
        <div class="text-sm">
            <a href="/user/login"
               class="text-blue-600 hover:underline font-medium">
                LOGIN
            </a>
        </div>

        <p class="text-xs text-gray-400 mt-8">
            By clicking continue, you agree to our
            <a href="#" class="underline">Terms of Service</a>
            and
            <a href="#" class="underline">Privacy Policy</a>
        </p>

    </form>

</div>

<script>
document.addEventListener("DOMContentLoaded", () => {

  const form = document.getElementById("forgot-form");
  const btn = document.getElementById("forgotBtn");
  const emailInput = document.getElementById("email");
  const emailError = document.getElementById("emailError");

  let requestLock = false;

  // =============================
  // 🔔 TOASTER FUNCTION
  // =============================
  function showToast(message, type = "error") {

    const toast = document.createElement("div");

    const baseStyle = `
      px-5 py-3 rounded-lg shadow-lg text-sm font-medium
      transition-all duration-300 transform translate-x-5 opacity-0
    `;

    const typeStyle =
      type === "success"
        ? "bg-green-500 text-white"
        : "bg-red-500 text-white";

    toast.className = baseStyle + " " + typeStyle;
    toast.textContent = message;

    const container = document.getElementById("toastContainer");
    container.appendChild(toast);

    setTimeout(() => {
      toast.classList.remove("translate-x-5", "opacity-0");
    }, 50);

    setTimeout(() => {
      toast.classList.add("opacity-0", "translate-x-5");
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }

  // Clear error when typing
  emailInput.addEventListener("input", () => {
    emailError.classList.add("invisible");
  });

  form.addEventListener("submit", async (e) => {

    e.preventDefault();

    if (requestLock) return;

    const email = emailInput.value.trim();
    emailError.classList.add("invisible");

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (!emailRegex.test(email)) {
      emailError.textContent = "Enter valid email address";
      emailError.classList.remove("invisible");
      showToast("Enter valid email address", "error");
      return;
    }

    requestLock = true;

    // 🟡 Yellow loading state
    btn.disabled = true;
    btn.classList.remove("bg-red-500", "hover:bg-red-600");
    btn.classList.add("bg-yellow-500");
    btn.innerHTML = "Sending OTP...";

    try {

      const res = await fetch("/user/forgot-password", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email })
      });

      const data = await res.json();

      if (!data.success) {
        throw new Error(data.message);
      }

      // ✅ SUCCESS TOAST
      showToast("OTP sent to your email", "success");

      localStorage.setItem("forgotUserId", data.userId);

      // ⏳ Small delay so user sees toast
      setTimeout(() => {
        window.location.href =
          "/user/forgot-password-otp?userId=" + data.userId;
      }, 1200);

    } catch (err) {

      emailError.textContent = err.message || "Something went wrong";
      emailError.classList.remove("invisible");

      showToast(err.message || "Something went wrong", "error");

      // Restore button
      btn.disabled = false;
      btn.classList.remove("bg-yellow-500");
      btn.classList.add("bg-red-500", "hover:bg-red-600");
      btn.innerHTML = "Send OTP";

      requestLock = false;
    }

  });

});
</script>

<%- include('../partials/auth-footer') %>