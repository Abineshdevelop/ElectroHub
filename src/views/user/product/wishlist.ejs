<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Wishlist — ElectroHub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: { extend: { fontFamily: { inter: ['Inter', 'sans-serif'] } } }
    }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; }

    .nav-underline { position: relative; }
    .nav-underline::after {
      content: '';
      position: absolute;
      width: 0; height: 2px;
      bottom: -2px; left: 0;
      background-color: #dc3545;
      transition: width 0.3s ease;
    }
    .nav-underline:hover::after { width: 100%; }

    #toasts{position:fixed;top:76px;right:16px;z-index:9999;display:flex;flex-direction:column;gap:8px;pointer-events:none}
    .toast{padding:10px 16px;border-radius:12px;font-size:13px;font-weight:600;box-shadow:0 6px 20px rgba(0,0,0,.10);opacity:0;transform:translateX(28px);transition:all .25s;display:flex;align-items:center;gap:8px;background:#fff;min-width:190px}
    .toast.in{opacity:1;transform:translateX(0)}
    .t-ok{border-left:4px solid #16a34a;color:#15803d}
    .t-err{border-left:4px solid #dc2626;color:#dc2626}
    .t-inf{border-left:4px solid #6366f1;color:#4f46e5}

    .pcard{background:#fff;border:1px solid #f0f0f0;border-radius:20px;overflow:hidden;transition:all .3s ease;position:relative;box-shadow:0 2px 12px rgba(0,0,0,.04);display:flex;flex-direction:column}
    .pcard:hover{border-color:#fca5a5;transform:translateY(-4px);box-shadow:0 16px 32px rgba(220,38,38,.11)}
    .img-wrap{width:100%;aspect-ratio:4/3;position:relative;background:#fff;border-bottom:1px solid #f3f4f6;overflow:hidden;flex-shrink:0;padding:20px}
    .img-wrap img{width:100%;height:100%;object-fit:contain;display:block;transition:transform .35s ease}
    .pcard:hover .img-wrap img{transform:none}
    .no-img{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#d1d5db;font-size:11px;gap:5px}
    .badge-disc{position:absolute;top:11px;left:11px;z-index:4;background:#dc2626;color:#fff;font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;pointer-events:none}
    .remove-btn{position:absolute;top:11px;right:11px;z-index:4;width:33px;height:33px;border-radius:50%;background:rgba(255,255,255,.93);border:1.5px solid #e5e7eb;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;box-shadow:0 2px 8px rgba(0,0,0,.09)}
    .remove-btn:hover{border-color:#fca5a5;background:#fff5f5;transform:scale(1.12)}
    .remove-btn i{font-size:14px;color:#9ca3af;transition:all .18s;line-height:1}
    .remove-btn:hover i{color:#dc2626}
    .pcontent{padding:13px;flex:1;display:flex;flex-direction:column}
    .brand-cat{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#9ca3af;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .brand-cat span{color:#ef4444}
    .name-row{display:flex;align-items:flex-start;justify-content:space-between;gap:6px;margin-bottom:8px}
    .name-row h3{font-size:13px;font-weight:700;line-height:1.4;color:#1f2937;flex:1;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.8em}
    .stock-pill{flex-shrink:0;margin-top:2px;border-radius:20px;font-size:9px;font-weight:700;padding:3px 8px;white-space:nowrap;border:1px solid}
    .stock-pill.in{color:#16a34a;border-color:#bbf7d0;background:#f0fdf4}
    .stock-pill.out{color:#dc2626;border-color:#fecaca;background:#fef2f2}
    .variant-strip{background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:8px 10px;margin-bottom:9px}
    .variant-strip-label{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#94a3b8;margin-bottom:5px}
    .vopts{display:flex;flex-wrap:wrap;gap:4px}
    .vopt-chip{display:inline-flex;align-items:center;gap:3px;padding:3px 8px;border-radius:6px;font-size:10px;font-weight:700;background:#fff;color:#334155;border:1px solid #e2e8f0;white-space:nowrap}
    .vopt-key{color:#94a3b8;font-weight:600;margin-right:1px}
    .price-row{display:flex;flex-wrap:wrap;align-items:baseline;gap:5px 4px;margin-bottom:11px;min-height:28px}
    .cur-price{font-size:18px;font-weight:800;color:#111827}
    .mrp-price{font-size:12px;color:#9ca3af;text-decoration:line-through}
    .disc-badge{background:#dcfce7;color:#16a34a;font-size:10px;font-weight:700;padding:2px 7px;border-radius:20px}
    .card-actions{display:flex;gap:8px;margin-top:auto}
    .btn-view{display:flex;align-items:center;justify-content:center;gap:5px;flex:1;padding:9px 8px;border-radius:12px;font-size:12px;font-weight:600;background:#fff;color:#dc2626;border:1.5px solid #dc2626;cursor:pointer;text-decoration:none;transition:all .2s}
    .btn-view:hover{background:#fef2f2}
    .btn-cart{display:flex;align-items:center;justify-content:center;gap:5px;flex:1;padding:9px 8px;border-radius:12px;font-size:12px;font-weight:600;background:linear-gradient(135deg,#dc2626,#ef4444);color:#fff;border:none;cursor:pointer;transition:all .2s;white-space:nowrap}
    .btn-cart:hover{background:linear-gradient(135deg,#b91c1c,#dc2626);transform:translateY(-1px)}
    .btn-cart:disabled{opacity:.5;cursor:not-allowed;transform:none}

    .spinr{display:inline-block;animation:spin .6s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}
    @keyframes fu{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
    .fu{animation:fu .32s ease both}
    @keyframes fadeOut{from{opacity:1;transform:scale(1)}to{opacity:0;transform:scale(.92)}}
    .fade-out{animation:fadeOut .28s ease forwards}
  </style>
</head>

<body class="bg-gray-50 text-gray-800">

  <%- include('../partials/navbar', { user }) %>
  <div id="toasts"></div>

  <div class="flex min-h-[calc(100vh-64px)]">

    <%- include('../partials/sidebar', { user, activePage: 'wishlist' }) %>

    <main class="flex-1 px-4 md:px-8 py-6 md:py-8 overflow-x-hidden">

      <!-- Header -->
      <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold">
            My <span class="text-red-600">Wishlist</span>
          </h2>
          <p class="text-sm text-gray-400 mt-1" id="wishCount">
            <%= items.length %> item<%= items.length !== 1 ? 's' : '' %>
          </p>
        </div>
        <a href="/user/list"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-gray-200
                 bg-white text-gray-600 font-semibold text-sm
                 hover:border-red-400 hover:text-red-500 transition-all">
          <i class="bi bi-arrow-left text-xs"></i> Continue Shopping
        </a>
      </div>

      <% if(items.length === 0){ %>
        <!-- Empty state -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm py-24
                    flex flex-col items-center text-center px-8">
          <div class="w-20 h-20 rounded-3xl bg-red-50 flex items-center justify-center mb-5">
            <i class="bi bi-heart text-red-400 text-3xl"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-700 mb-2">Your wishlist is empty</h3>
          <p class="text-sm text-gray-400 mb-6">Save items you love and find them here anytime.</p>
          <a href="/user/list"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-sm
                   bg-gradient-to-r from-red-600 to-red-500 text-white shadow-md
                   hover:from-red-700 hover:to-red-600 transition-all">
            <i class="bi bi-grid text-xs"></i> Browse Products
          </a>
        </div>

      <% } else { %>
        <!-- Product grid -->
        <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4" id="wishGrid">
          <% items.forEach((item, idx) => {
            const product    = item.productId;
            const variant    = item.variant;
            const productId  = String(product._id);
            const variantId  = variant ? String(variant._id) : '';
            const price      = Number(variant?.price) || 0;
            const mrp        = Number(variant?.mrp)   || 0;
            const stock      = Number(variant?.stock)  || 0;
            const disc       = (mrp && price && mrp > price) ? Math.round((1-price/mrp)*100) : 0;
            const isAvailable = product.isActive !== false && (!variant || variant.isActive !== false);
            const inStock    = isAvailable && stock > 0;
            const thumb      = Array.isArray(variant?.images) && variant.images[0]
                               ? variant.images[0] : '';
            const opts       = (variant?.options && typeof variant.options === 'object')
                               ? variant.options : {};
            const optEntries = Object.entries(opts).filter(([,v]) => v && String(v).trim() !== '');
          %>
            <div class="pcard fu" style="animation-delay:<%= idx*40 %>ms"
              id="wcard-<%= productId %>-<%= variantId %>">

              <!-- Image -->
              <div class="img-wrap">
                <% if(thumb){ %>
                  <img src="<%= thumb %>" alt="<%= product.productName %>"
                    onerror="this.parentElement.innerHTML='<div class=\'no-img\'><i class=\'bi bi-image text-3xl\'></i><span>No image</span></div>'">
                <% } else { %>
                  <div class="no-img"><i class="bi bi-image text-3xl"></i><span>No image</span></div>
                <% } %>
                <% if(disc > 0){ %><div class="badge-disc">-<%= disc %>%</div><% } %>
                <button class="remove-btn"
                  onclick="removeWishItem('<%= productId %>','<%= variantId %>',this)"
                  title="Remove from wishlist">
                  <i class="bi bi-x-lg"></i>
                </button>
              </div>

              <!-- Content -->
              <div class="pcontent">
                <div class="brand-cat">
                  <%= product.categoryName || 'ElectroHub' %>
                  <% if(product.brandName){ %><span>· <%= product.brandName %></span><% } %>
                </div>

                <div class="name-row">
                  <h3><%= product.productName %></h3>
                  <span class="stock-pill <%= inStock ? 'in' : 'out' %>">
                    <%= !isAvailable ? 'Unavailable' : (inStock ? 'In Stock' : 'Out of Stock') %>
                  </span>
                </div>

                <!-- Variant strip (options only, no stock count) -->
                <% if(variant && optEntries.length > 0){ %>
                  <div class="variant-strip">
                    <div class="variant-strip-label">Variant</div>
                    <div class="vopts">
                      <% optEntries.forEach(([k,v]) => { %>
                        <span class="vopt-chip">
                          <span class="vopt-key"><%= k %>:</span><%= v %>
                        </span>
                      <% }) %>
                    </div>
                  </div>
                <% } %>

                <!-- Price -->
                <div class="price-row">
                  <% if(price > 0){ %>
                    <span class="cur-price">₹<%= Number(price).toLocaleString('en-IN') %></span>
                    <% if(disc > 0){ %>
                      <span class="mrp-price">₹<%= Number(mrp).toLocaleString('en-IN') %></span>
                      <span class="disc-badge"><%= disc %>% off</span>
                    <% } %>
                  <% } else { %>
                    <span class="text-xs text-gray-400 italic">Price not set</span>
                  <% } %>
                </div>

                <!-- Actions -->
                <div class="card-actions">
                  <a href="/user/product/<%= productId %><%= variantId ? '?variant='+variantId : '' %>"
                    class="btn-view">
                    <i class="bi bi-eye text-xs"></i> View
                  </a>
                  <% if(variantId && inStock){ %>
                    <button class="btn-cart"
                      id="cartbtn-<%= productId %>-<%= variantId %>"
                      onclick="addToCart('<%= productId %>','<%= variantId %>',this)">
                      <i class="bi bi-cart-plus text-xs"></i> Add to Cart
                    </button>
                  <% } else if(!variantId && isAvailable){ %>
                    <a href="/user/product/<%= productId %>" class="btn-cart" style="text-decoration:none">
                      <i class="bi bi-arrow-right text-xs"></i> Select Variant
                    </a>
                  <% } else { %>
                    <button class="btn-cart" disabled>
                      <i class="bi bi-x-circle text-xs"></i> <%= !isAvailable ? 'Unavailable' : 'Out of Stock' %>
                    </button>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

    </main>
  </div>
<script>
  function toast(msg, type='info') {
    const icons = {success:'bi-check-circle-fill',error:'bi-x-circle-fill',info:'bi-info-circle-fill'};
    const cls   = {success:'t-ok',error:'t-err',info:'t-inf'};
    const el    = document.createElement('div');
    el.className = `toast ${cls[type]||'t-inf'}`;
    el.innerHTML = `<i class="bi ${icons[type]||icons.info}"></i><span>${msg}</span>`;
    document.getElementById('toasts').appendChild(el);
    requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('in')));
    setTimeout(() => { el.classList.remove('in'); setTimeout(() => el.remove(), 300); }, 3500);
  }

  function removeCard(productId, variantId) {
    const card = document.getElementById(`wcard-${productId}-${variantId}`);
    if (!card) return;
    card.classList.add('fade-out');
    setTimeout(() => {
      card.remove();
      updateCount();
      // live update navbar badge
      if (window.updateNavBadge) window.updateNavBadge('wishlist', -1);
    }, 290);
  }

  async function removeWishItem(productId, variantId, btn) {
    btn.disabled = true;
    try {
      const res  = await fetch('/user/wishlist/remove', {
        method : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body   : JSON.stringify({ productId }),
      });
      const data = await res.json();
      if (data.success) {
        removeCard(productId, variantId);
        toast('Removed from wishlist', 'info');
      } else {
        toast(data.message || 'Could not remove', 'error');
        btn.disabled = false;
      }
    } catch {
      toast('Something went wrong', 'error');
      btn.disabled = false;
    }
  }

  async function addToCart(productId, variantId, btn) {
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-arrow-repeat spinr text-xs"></i> Adding…';
    try {
      const cartRes  = await fetch('/user/cart/add', {
        method : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body   : JSON.stringify({ productId, variantId, quantity: 1 }),
      });
      const cartData = await cartRes.json();

      if (!cartData.success) {
        toast(cartData.message || 'Failed to add to cart', 'error');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-cart-plus text-xs"></i> Add to Cart';
        return;
      }

      await fetch('/user/wishlist/remove', {
        method : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body   : JSON.stringify({ productId }),
      });

      toast('Added to cart!', 'success');
      removeCard(productId, variantId);

      // live update navbar badges
      if (window.updateNavBadge) {
        window.updateNavBadge('cart',     +1);
      }

    } catch {
      toast('Something went wrong', 'error');
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-cart-plus text-xs"></i> Add to Cart';
    }
  }

  function updateCount() {
    const n  = document.querySelectorAll('#wishGrid .pcard').length;
    const el = document.getElementById('wishCount');
    if (el) el.textContent = `${n} item${n !== 1 ? 's' : ''}`;
    if (n === 0) {
      document.getElementById('wishGrid').outerHTML = `
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm py-24
                    flex flex-col items-center text-center px-8">
          <div class="w-20 h-20 rounded-3xl bg-red-50 flex items-center justify-center mb-5">
            <i class="bi bi-heart text-red-400 text-3xl"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-700 mb-2">Wishlist is empty</h3>
          <p class="text-sm text-gray-400 mb-6">Items were added to your cart.</p>
          <div class="flex gap-3 flex-wrap justify-center">
            <a href="/user/cart"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm
                     bg-gradient-to-r from-red-600 to-red-500 text-white shadow-md
                     hover:from-red-700 hover:to-red-600 transition-all">
              <i class="bi bi-cart text-xs"></i> Go to Cart
            </a>
            <a href="/user/list"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm
                     border border-gray-200 bg-white text-gray-600
                     hover:border-red-400 hover:text-red-500 transition-all">
              <i class="bi bi-grid text-xs"></i> Browse
            </a>
          </div>
        </div>`;
    }
  }
  </script>
  <%- include('../partials/footer') %>
</body>
</html>
